<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <!-- Receipt Studio modifier classes on the receipt root. The raster
             print path adds `pos-receipt-print` to this same element and the
             browser print path clones it, so width/style/font classes reach
             every output (screen, thermal raster, browser print, email JPEG).
             See receipt.scss for the matching rules. -->
        <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
            <attribute name="t-attf-class">pos-retail-style-{{order.config.pos_retail_receipt_style || 'standard'}} pos-retail-w{{order.config.pos_retail_receipt_width || '80'}} pos-retail-font-{{order.config.pos_retail_receipt_font || 'normal'}}</attribute>
</xpath>

        <!-- Replace core OrderDisplay with clean columnar table: ITEM | QTY | PRICE | TOTAL -->
        <xpath expr="//OrderDisplay" position="replace">
            <div class="pos-retail-receipt-table-wrapper my-2">
                <table class="pos-retail-receipt-table w-100">
                    <thead>
                        <tr class="pos-retail-receipt-th-row">
                            <th class="col-item text-start">ITEM</th>
                            <th class="col-qty text-center">QTY</th>
                            <th class="col-price text-end">PRICE</th>
                            <th class="col-total text-end">TOTAL</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="posRetailReceiptLines" t-as="line" t-key="line.uuid"
                            class="pos-retail-receipt-tr align-top">
                            <td class="col-item text-start">
                                <div class="fw-bold text-break" t-esc="line.full_product_name or line.product_id?.display_name"/>
                                <div t-if="line.pos_retail_package_id" class="pos-retail-line-package small text-muted" style="font-size: 80%;">
                                    Package: <t t-esc="line.pos_retail_package_id.package_name or line.pos_retail_package_id.uom_id?.name"/>
                                </div>
                                <div t-if="order.config.pos_retail_receipt_show_sku and (line.pos_retail_package_id?.sku or line.product_id?.default_code)"
                                     class="pos-retail-line-sku small text-muted" style="font-size: 80%;">
                                    SKU: <t t-esc="line.pos_retail_package_id?.sku or line.product_id?.default_code"/>
                                </div>
                                <div t-if="line.customer_note" class="customer-note small text-muted fst-italic" style="font-size: 80%;">
                                    <i class="fa fa-sticky-note me-1"/> <t t-esc="line.customer_note"/>
                                </div>
                            </td>
                            <td class="col-qty text-center font-monospace fw-semibold">
                                <t t-esc="line.getQuantityStr().qtyStr"/>
                            </td>
                            <td class="col-price text-end font-monospace">
                                <t t-esc="formatReceiptPrice(line.displayPriceUnit, line)"/>
                            </td>
                            <td class="col-total text-end font-monospace fw-bold">
                                <t t-esc="formatReceiptPrice(line.displayPrice, line)"/>
                                <span t-if="line.taxGroupLabels" class="small text-muted ms-1" style="font-size: 75%;" t-esc="line.taxGroupLabels"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div t-if="order.general_customer_note" class="pos-retail-general-note mt-1 p-1 small fst-italic">
                    <t t-foreach="order.general_customer_note.trim().split('\n')" t-as="subNote" t-key="subNote_index">
                        <div class="text-break"><t t-esc="subNote"/></div>
                    </t>
                </div>
            </div>
        </xpath>

        <!-- Total Discount positioned next to Total -->
        <xpath expr="//div[hasclass('receipt-total')]" position="after">
            <div t-if="posRetailTotalDiscount" class="pos-receipt-amount receipt-discount text-start pt-1">
                <span class="label-total-discount fw-normal">Total Discount</span>
                <span t-out="posRetailTotalDiscount" class="pos-receipt-right-align font-monospace text-danger"/>
            </div>
        </xpath>

        <!-- Suppress the old core Discounts line that appeared after Cash/payments -->
        <xpath expr="//span[hasclass('label-discount')]/parent::div" position="replace">
            <!-- Suppressed: Total Discount is shown above payment lines next to Total -->
        </xpath>

        <!-- Gate the core "Need an invoice?" QR code by pos_retail_receipt_show_qr as well -->
        <xpath expr="//div[hasclass('pos-receipt-qr')]" position="attributes">
            <attribute name="t-if">order.company.point_of_sale_use_ticket_qr_code and order.finalized and order.config.pos_retail_receipt_show_qr</attribute>
        </xpath>

        <!-- The core template exposes an explicit `before-footer` anchor. -->
        <xpath expr="//div[hasclass('before-footer')]" position="before">

            <!-- Payment transaction references (card / wallet / bank). The
                 amounts themselves are printed by the core paymentlines
                 block; this adds the reference trail under it. -->
            <t t-foreach="paymentLines" t-as="pline" t-key="pline.uuid">
                <div t-if="pline.transaction_id or pline.payment_ref_no or pline.card_no"
                     class="pos-retail-payment-ref text-start" style="font-size:75%;">
                    <span t-esc="pline.payment_method_id?.name"/>
                    <t t-if="pline.card_type"> <t t-esc="pline.card_type"/></t>
                    <t t-if="pline.card_no"> ****<t t-esc="pline.card_no"/></t>
                    <t t-if="pline.transaction_id or pline.payment_ref_no">
                        Ref: <t t-esc="pline.transaction_id or pline.payment_ref_no"/>
                    </t>
                </div>
            </t>

            <!-- Order discount details (manager approval + reason) -->
            <t t-if="order.config.pos_retail_receipt_show_discount_details">
                <div t-if="order.discount_reason_id" class="pos-retail-discount-reason text-start pt-1">
                    <span class="label-discount-reason">Discount Reason</span>
                    <span class="pos-receipt-right-align" t-esc="order.discount_reason_id.name"/>
                </div>
                <div t-if="order.discount_manager_id" class="pos-retail-discount-manager text-start">
                    <span class="label-discount-manager">Approved By</span>
                    <span class="pos-receipt-right-align" t-esc="order.discount_manager_id.name"/>
                </div>
            </t>

            <!-- Credit Return section. Only the shape of a refund: the sale
                 it undoes, how the money actually went back, and, only when
                 it truly touched an account rather than the till drawer,
                 what that account stood at before and after. Mirrors the PDF
                 receipt's own Credit Return section (pos_retail_receipt_report.xml)
                 so a customer sees the same story whether they get a screen
                 print or a paper one. -->
            <t t-set="posRetailCRI" t-value="posRetailCreditReturnInfo"/>
            <t t-if="posRetailCRI">
                <div class="pos-retail-credit-return text-start pt-2"
                     style="border-top:1px dashed currentColor; padding-top:6px;">
                    <div class="fw-bolder">Credit Return</div>

                    <div t-if="posRetailCRI.originalOrders.length" class="pos-retail-credit-return-original">
                        <t t-foreach="posRetailCRI.originalOrders" t-as="orig" t-key="orig.reference">
                            Original Sale: <t t-esc="orig.reference"/>
                            <t t-if="orig.date"> (<t t-esc="orig.date"/>)</t>
                        </t>
                    </div>
                    <div t-else="" class="pos-retail-return-unlinked">
                        <i class="fa fa-exclamation-triangle me-1"/>Not linked to original sale
                    </div>

                    <div>
                        <span class="label-credit-return-method">Refund Method</span>
                        <span class="pos-receipt-right-align" t-esc="posRetailCRI.disposition"/>
                    </div>
                    <div t-if="posRetailCRI.authorizedBy">
                        <span class="label-credit-return-authorized">Authorized By</span>
                        <span class="pos-receipt-right-align" t-esc="posRetailCRI.authorizedBy"/>
                    </div>

                    <t t-if="posRetailCRI.hasBalance">
                        <div>
                            <span class="label-credit-return-before">Previous Outstanding</span>
                            <span class="pos-receipt-right-align" t-esc="posRetailCRI.balanceBefore"/>
                        </div>
                        <div>
                            <span class="label-credit-return-credit">Return Credit</span>
                            <span class="pos-receipt-right-align" t-esc="posRetailCRI.refundAmount"/>
                        </div>
                        <div class="fw-bolder">
                            <span class="label-credit-return-after">New Outstanding (est.)</span>
                            <span class="pos-receipt-right-align" t-esc="posRetailCRI.balanceAfter"/>
                        </div>
                    </t>
                </div>
            </t>

            <!-- Approved price changes. The line prices themselves are already
                 printed by the core receipt; this records who authorised any
                 sale made outside the product's normal range, so the receipt
                 is a complete record for the customer and for the audit. -->
            <t t-if="order.config.pos_retail_receipt_show_discount_details">
                <t t-foreach="order.lines" t-as="line" t-key="line.uuid">
                    <div t-if="line.pos_retail_price_state == 'overridden'"
                         class="pos-retail-price-override-line text-start pt-1">
                        <span class="label-price-override">Price Approved</span>
                        <span class="pos-receipt-right-align">
                            <t t-esc="line.pos_retail_price_manager_id?.name"/>
                            <t t-if="line.pos_retail_price_reason_id">
                                (<t t-esc="line.pos_retail_price_reason_id.name"/>)
                            </t>
                        </span>
                    </div>
                </t>
            </t>

            <!-- Return reason (refund orders) -->
            <div t-if="order.return_reason_id" class="pos-retail-return-reason-line text-start pt-1">
                <span class="label-return-reason">Return Reason</span>
                <span class="pos-receipt-right-align" t-esc="order.return_reason_id.name"/>
            </div>

            <!-- Return policy block -->
            <div t-if="order.config.return_policy"
                 class="pos-retail-return-policy pt-3 mt-2 text-center"
                 style="white-space:pre-line; border-top:1px dashed currentColor; padding-top:6px;">
                <div class="fw-bolder">Return Policy</div>
                <div style="font-size:80%;"><t t-esc="order.config.return_policy"/></div>
            </div>

            <!-- Thank-you message (Receipt Studio). -->
            <div t-if="order.config.pos_retail_receipt_thankyou"
                 class="pos-retail-thankyou text-center fw-bolder pt-2">
                <t t-esc="order.config.pos_retail_receipt_thankyou"/>
            </div>

            <!-- Receipt reference QR code, gated by Receipt Studio.
                 Materialised once with t-set: the getter runs a full canvas
                 QR encode, and referencing it twice (t-if + src) encoded the
                 same QR twice per render. -->
            <t t-if="order.config.pos_retail_receipt_show_qr">
                <t t-set="posRetailQR" t-value="posRetailReceiptQR"/>
                <div t-if="posRetailQR" class="pos-retail-receipt-qr text-center pt-3">
                    <img t-att-src="posRetailQR"
                         style="width:104px; height:104px;" alt="Receipt reference QR"/>
                    <div style="font-size:70%;">Scan for receipt reference</div>
                </div>
            </t>

            <!-- Scannable reference barcode (optional; fetched from the
                 server, so it needs connectivity at render time). -->
            <div t-if="order.config.pos_retail_receipt_show_ref_barcode and order.pos_reference"
                 class="pos-retail-ref-barcode text-center pt-2">
                <img t-att-src="'/report/barcode/Code128/' + encodeURIComponent(order.pos_reference) + '?width=300&amp;height=60'"
                     style="width:80%; max-height:44px;" alt="Receipt reference barcode"/>
                <div style="font-size:70%;" t-esc="order.pos_reference"/>
            </div>

        </xpath>

        <!-- Remove "Powered by Odoo" and brand the receipt footer with the
             store's own company name instead. The custom footer message
             (order.config.receipt_footer), the logo, and the custom header
             message (order.config.receipt_header) all remain native and stay
             configurable in POS Settings, Bills and Receipts. -->
        <xpath expr="//div[hasclass('footer-powered-by')]" position="replace">
            <div class="pos-retail-receipt-branding pos-receipt-center-align text-center pt-3"
                 style="border-top:1px dashed currentColor; padding-top:6px;">
                <div class="fw-bolder" t-esc="order.company?.name"/>
                <div t-if="order.config.pos_retail_receipt_social"
                     class="pos-retail-receipt-social" style="font-size:80%;"
                     t-esc="order.config.pos_retail_receipt_social"/>
            </div>
        </xpath>
    </t>

</templates>
