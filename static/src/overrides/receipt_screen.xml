<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Remove the "send the receipt to the customer" section (email input +
         send button, and the SMS/phone field beside it) from the POS receipt
         screen. This store issues printed receipts only; customers are not
         emailed/SMSed their receipt. The "Print Full Receipt" / "New Order"
         actions are untouched. -->
    <t t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//input[hasclass('send-receipt-email-input')]/ancestor::div[hasclass('flex-column')][1]" position="replace"/>
    </t>

</templates>
