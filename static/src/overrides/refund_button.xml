<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Differentiated Navbar Buttons: Register, Orders, and Refund -->
    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('register-label')]" position="replace">
            <button class="register-label btn btn-lg lh-lg d-flex align-items-center justify-content-center"
                    t-att-class="{'active': mainButton === 'register'}"
                    t-on-click="() => this.onClickRegister()"
                    title="Open Register / Product Screen">
                <span t-if="!ui.isSmall" class="d-inline-flex align-items-center">
                    <i class="fa fa-shopping-cart me-1"/>Register
                </span>
                <i t-else="" class="fa fa-fw fa-shopping-cart fa-lg"/>
            </button>
        </xpath>

        <xpath expr="//button[hasclass('orders-button')]" position="replace">
            <button class="orders-button btn btn-lg lh-lg d-flex align-items-center justify-content-center"
                    t-att-class="{'active': mainButton === 'order'}"
                    t-on-click="() => this.pos.navigate('TicketScreen')"
                    title="View Orders">
                <span t-if="!ui.isSmall" class="d-inline-flex align-items-center">
                    <i class="fa fa-list-alt me-1"/>Orders
                </span>
                <i t-else="" class="fa fa-fw fa-list-alt fa-lg"/>
            </button>
        </xpath>

        <xpath expr="//button[hasclass('orders-button')]" position="after">
            <button t-if="pos.getCashier()?._can_refund"
                    class="pos-retail-refund-btn btn btn-lg lh-lg d-flex align-items-center justify-content-center"
                    t-on-click="() => this.posRetailStartRefund()"
                    title="Process Return / Refund">
                <span t-if="!ui.isSmall" class="d-inline-flex align-items-center">
                    <i class="fa fa-undo me-1"/>Refund
                </span>
                <i t-else="" class="fa fa-fw fa-undo fa-lg"/>
            </button>
        </xpath>
    </t>

</templates>
