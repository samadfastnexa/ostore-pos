<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_retail.ReceivePaymentPopup">
        <Dialog size="'lg'" title="'Receive Payment: ' + (partner ? partner.name : '')" bodyClass="'pos-retail-receive-payment-modal'">
            <div class="pos-retail-receive-payment-popup p-1">
                <!-- Customer Quick Header Info -->
                <div class="d-flex align-items-center justify-content-between p-3 mb-3 bg-light rounded border">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
                             style="width: 44px; height: 44px; font-size: 1.2rem;"
                             t-esc="(partner ? partner.name : '?').charAt(0).toUpperCase()"/>
                        <div>
                            <div class="fw-bold fs-6 text-dark" t-esc="partner ? partner.name : ''"/>
                            <div class="small text-muted" t-if="partner and (partner.phone or partner.mobile)">
                                <i class="fa fa-phone me-1 text-primary"/>
                                <span t-esc="partner.phone || partner.mobile"/>
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Current Outstanding</div>
                        <div class="fs-5 fw-bold"
                             t-att-class="state.previousTotal > 0 ? 'text-danger' : 'text-success'"
                             t-esc="state.previousTotalFormatted"/>
                    </div>
                </div>

                <!-- Alert/Error message if any -->
                <div t-if="state.errorMsg" class="alert alert-danger py-2 px-3 mb-3" role="alert">
                    <i class="fa fa-exclamation-circle me-1"/>
                    <t t-esc="state.errorMsg"/>
                </div>

                <!-- Payment Configuration Inputs -->
                <div class="row g-3 mb-3">
                    <!-- Amount Input -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small mb-1">Payment Amount Received <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white fw-bold"><i class="fa fa-money text-success"/></span>
                            <input type="number"
                                   step="any"
                                   class="form-control form-control-lg fw-bold text-success"
                                   placeholder="0.00"
                                   t-att-value="state.amount"
                                   t-on-input="onAmountInput"
                                   autofocus="autofocus"/>
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm"
                                    t-on-click="setFullAmount"
                                    title="Pay full outstanding balance">
                                Full Balance
                            </button>
                        </div>
                    </div>

                    <!-- Payment Method / Journal Selector -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small mb-1">Payment Method <span class="text-danger">*</span></label>
                        <div class="d-flex flex-wrap gap-2">
                            <t t-foreach="state.journals" t-as="j" t-key="j.id">
                                <button type="button"
                                        class="btn btn-sm d-flex align-items-center gap-1 py-2 px-3 rounded-2"
                                        t-att-class="state.journalId === j.id ? 'btn-primary text-white shadow-sm' : 'btn-outline-secondary'"
                                        t-on-click="() => this.setJournal(j.id)">
                                    <i t-att-class="j.is_cash ? 'fa fa-money' : 'fa fa-credit-card'"/>
                                    <span t-esc="j.name"/>
                                </button>
                            </t>
                        </div>
                    </div>

                    <!-- Payment Date -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small mb-1">Payment Date</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fa fa-calendar text-muted"/></span>
                            <input type="date"
                                   class="form-control"
                                   t-model="state.date"/>
                        </div>
                    </div>

                    <!-- Reference / Memo -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small mb-1">Reference / Note (Optional)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fa fa-pencil text-muted"/></span>
                            <input type="text"
                                   class="form-control"
                                   placeholder="e.g. Counter Cash, Receipt #214"
                                   t-model="state.memo"/>
                        </div>
                    </div>
                </div>

                <!-- LIVE VISIBLE ALLOCATION TABLE (Requirement 4) -->
                <div class="card border mb-3 shadow-none">
                    <div class="card-header bg-light py-2 px-3 d-flex align-items-center justify-content-between">
                        <div class="fw-bold small text-dark d-flex align-items-center gap-2">
                            <i class="fa fa-list-ol text-primary"/>
                            <span>Automatic Oldest-First Allocation Breakdown (FIFO)</span>
                        </div>
                        <span t-if="state.loadingAllocations" class="text-muted small">
                            <i class="fa fa-circle-o-notch fa-spin me-1"/>Calculating…
                        </span>
                        <span t-elif="state.allocations.length" class="badge text-bg-secondary" style="font-size: 0.72rem;">
                            <t t-esc="state.allocations.length"/> Invoices / Orders
                        </span>
                    </div>
                    <div class="table-responsive" style="max-height: 240px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="py-2">Invoice / Order</th>
                                    <th class="py-2">Date</th>
                                    <th class="text-end py-2">Prev Balance</th>
                                    <th class="text-end py-2 text-success">Applied</th>
                                    <th class="text-end py-2">Remaining</th>
                                    <th class="text-center py-2">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="!state.allocations.length">
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            <i class="fa fa-info-circle me-1"/>
                                            <t t-if="state.previousTotal &lt;= 0">Customer has zero outstanding balance. Any payment will be recorded as advance store credit.</t>
                                            <t t-else="">Enter a payment amount to preview live FIFO allocation.</t>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr t-foreach="state.allocations" t-as="item" t-key="item.name + item_index">
                                        <td class="fw-semibold text-dark">
                                            <i class="fa fa-file-text-o me-1 text-muted small"/>
                                            <span t-esc="item.name"/>
                                        </td>
                                        <td class="text-muted small" t-esc="item.date"/>
                                        <td class="text-end text-muted" t-esc="item.previous_balance_formatted"/>
                                        <td class="text-end fw-bold text-success" t-esc="item.applied_amount_formatted"/>
                                        <td class="text-end fw-bold"
                                            t-att-class="item.remaining_balance > 0 ? 'text-danger' : 'text-muted'"
                                            t-esc="item.remaining_balance_formatted"/>
                                        <td class="text-center">
                                            <span t-if="item.status === 'paid'" class="badge text-bg-success py-1 px-2">Paid</span>
                                            <span t-elif="item.status === 'partial'" class="badge text-bg-warning text-dark py-1 px-2">Balance</span>
                                            <span t-else="" class="badge text-bg-secondary py-1 px-2">Outstanding</span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <!-- Allocation Summary Footer -->
                    <div class="card-footer bg-light py-2 px-3 d-flex flex-wrap align-items-center justify-content-between gap-3 border-top">
                        <div class="d-flex align-items-center gap-3 small">
                            <span>Prev Total: <strong t-esc="state.previousTotalFormatted"/></span>
                            <span class="text-muted">→</span>
                            <span>Payment: <strong class="text-success" t-esc="formatCurrency(state.amount)"/></span>
                            <span class="text-muted">→</span>
                            <span>New Balance: <strong t-att-class="state.newTotal > 0 ? 'text-danger' : 'text-success'" t-esc="state.newTotalFormatted"/></span>
                        </div>
                        <div t-if="state.unallocated > 0" class="badge text-bg-info text-white py-1 px-2 small">
                            <i class="fa fa-info-circle me-1"/>Advance Credit: <t t-esc="state.unallocatedFormatted"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Buttons -->
            <t t-set-slot="footer">
                <div class="d-flex align-items-center justify-content-between w-100">
                    <button type="button" class="btn btn-outline-secondary" t-on-click="props.close" t-att-disabled="state.submitting">
                        Cancel
                    </button>
                    <button type="button"
                            class="btn btn-success fw-bold d-flex align-items-center gap-2 px-4 shadow-sm"
                            t-att-disabled="!canConfirm"
                            t-on-click="onConfirm">
                        <i t-if="state.submitting" class="fa fa-circle-o-notch fa-spin"/>
                        <i t-else="" class="fa fa-check"/>
                        <span>Confirm Payment</span>
                    </button>
                </div>
            </t>
        </Dialog>
    </t>

</templates>
