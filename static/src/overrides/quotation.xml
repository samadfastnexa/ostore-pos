<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Quotation actions, offered only when this session can actually carry
         them out.

         Gated on the SIGNED-IN account rather than on the cashier: a quotation
         is a sale.order, created over RPC as whoever the browser is logged in
         as. A cashier granted products and inventory but not sales tapped
         these and got an Access Error listing twelve security groups, in front
         of a customer. A button that cannot work should not be on the screen.

         The register switch stays as the first condition: it decides whether
         this counter offers quotations at all, which is a different question
         from whether the person at it may create one. -->

    <t t-name="pos_retail.QuotationButton" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-if="pos.config.pos_retail_allow_quotation and pos.user._can_quotation"
                    class="btn btn-secondary btn-lg py-5 pos-retail-quotation-btn"
                    t-on-click="() => this.onClickSaveAsQuotation()">
                <i class="fa fa-file-text-o me-1"/>Save as Quotation
            </button>
            <button t-if="pos.config.pos_retail_allow_quotation and pos.user._can_quotation"
                    class="btn btn-secondary btn-lg py-5 pos-retail-quotation-btn"
                    t-on-click="() => this.onClickSaveQuotationDraft()">
                <i class="fa fa-pencil-square-o me-1"/>Save Draft
            </button>
            <button t-if="pos.config.pos_retail_allow_quotation and pos.user._can_quotation"
                    class="btn btn-secondary btn-lg py-5 pos-retail-quotation-btn"
                    t-on-click="() => this.onClickUpdateQuotation()">
                <i class="fa fa-refresh me-1"/>Update Quote
            </button>
            <button t-if="pos.config.pos_retail_allow_quotation and pos.user._can_quotation"
                    class="btn btn-secondary btn-lg py-5 pos-retail-quotation-btn"
                    t-on-click="() => this.onClickDuplicateQuotation()">
                <i class="fa fa-clone me-1"/>Duplicate Quote
            </button>
        </xpath>
    </t>

</templates>
