<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_retail.QuotationButton" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-if="pos.config.pos_retail_allow_quotation"
                    class="btn btn-secondary btn-lg py-5 pos-retail-quotation-btn"
                    t-on-click="() => this.onClickSaveAsQuotation()">
                <i class="fa fa-file-text-o me-1"/>Save as Quotation
            </button>
            <button t-if="pos.config.pos_retail_allow_quotation"
                    class="btn btn-secondary btn-lg py-5 pos-retail-quotation-btn"
                    t-on-click="() => this.onClickSaveQuotationDraft()">
                <i class="fa fa-pencil-square-o me-1"/>Save Draft
            </button>
            <button t-if="pos.config.pos_retail_allow_quotation"
                    class="btn btn-secondary btn-lg py-5 pos-retail-quotation-btn"
                    t-on-click="() => this.onClickUpdateQuotation()">
                <i class="fa fa-refresh me-1"/>Update Quote
            </button>
            <button t-if="pos.config.pos_retail_allow_quotation"
                    class="btn btn-secondary btn-lg py-5 pos-retail-quotation-btn"
                    t-on-click="() => this.onClickDuplicateQuotation()">
                <i class="fa fa-clone me-1"/>Duplicate Quote
            </button>
        </xpath>
    </t>

</templates>
