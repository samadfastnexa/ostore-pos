<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- "Charge what the customer actually handed over."

         The counter here runs at a high rate and the old panel was the wrong
         shape for it: pick a type, pick a preset, type an amount, pick a
         reason, apply. Five interactions to knock 20 off a 200 bill.

         This replaces all of it with nothing to type at all, because the
         cashier is ALREADY typing the cash received into the payment numpad.
         Once that figure is in, whatever is still outstanding is by definition
         the discount, so one button applies it.

         Deliberately a button and not automatic. A short payment is ambiguous
         at this shop: it is either a discount, or the balance is going on the
         customer's khata. Auto-applying would silently wipe out credit sales,
         so the cashier says which one it is, and saying nothing leaves the
         balance owing, which is the safer default of the two. -->
    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="before">
            <!-- 1. Fix for cashier keying tendered amount under Customer Credit instead of Cash -->
            <button t-if="posRetailCreditOnlyShortfall"
                    class="pos-retail-convert-credit-cash btn btn-success w-100 mb-2 py-2 d-flex justify-content-between align-items-center fw-bold shadow-sm"
                    style="font-size: 0.92rem;"
                    t-on-click="() => this.posRetailFixCreditCashSplit()">
                <span><i class="fa fa-exchange me-2"/>Tender as Cash &amp; Add Rest to Khata</span>
                <span class="badge bg-white text-success fs-6"><t t-esc="posRetailShortfallLabel"/></span>
            </button>

            <!-- 2. Primary: Add remaining balance to Customer Credit (Khata) -->
            <button t-if="posRetailShortfall and currentOrder.getPartner() and !posRetailCreditOnlyShortfall"
                    class="pos-retail-credit-short btn btn-primary w-100 mb-2 py-2 d-flex justify-content-between align-items-center fw-bold shadow-sm"
                    style="font-size: 0.95rem; background-color: #0d6efd; border-color: #0d6efd;"
                    t-on-click="() => this.posRetailCreditShortfall()">
                <span><i class="fa fa-book me-2"/>Add rest to Customer Credit (Khata)</span>
                <span class="badge bg-white text-primary fs-6"><t t-esc="posRetailShortfallLabel"/></span>
            </button>

            <!-- 3. If shortfall and no customer selected yet -->
            <button t-if="posRetailShortfall and !currentOrder.getPartner()"
                    class="pos-retail-credit-short btn btn-outline-primary w-100 mb-2 py-2 d-flex justify-content-between align-items-center fw-bold"
                    style="font-size: 0.92rem;"
                    t-on-click="() => this.posRetailSelectPartnerForCredit()">
                <span><i class="fa fa-user-plus me-2"/>Select Customer to Add Rest to Khata</span>
                <span class="badge bg-primary text-white fs-6"><t t-esc="posRetailShortfallLabel"/></span>
            </button>

            <!-- 4. Pay remaining shortfall in Cash (if credit payment is active) -->
            <button t-if="posRetailShortfall and posRetailHasCreditPayment and !posRetailCreditOnlyShortfall"
                    class="pos-retail-cash-short btn btn-outline-success w-100 mb-2 d-flex justify-content-between align-items-center fw-bold"
                    t-on-click="() => this.posRetailPayRestInCash()">
                <span><i class="fa fa-money me-2"/>Pay rest in Cash</span>
                <span class="fw-bold"><t t-esc="posRetailShortfallLabel"/></span>
            </button>

            <!-- 5. Discount the rest (waive) -->
            <button t-if="posRetailShortfall"
                    class="pos-retail-charge-short btn btn-warning w-100 mb-2 d-flex justify-content-between align-items-center"
                    t-on-click="() => this.posRetailDiscountShortfall()">
                <span><i class="fa fa-scissors me-1"/>Discount the rest</span>
                <span class="fw-bold"><t t-esc="posRetailShortfallLabel"/></span>
            </button>
        </xpath>
    </t>

</templates>
