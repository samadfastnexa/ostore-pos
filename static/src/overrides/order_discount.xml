<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="before">
            <div class="pos-retail-order-discount border rounded p-2 mb-2"
                 t-if="pos.config.pos_retail_discount_enabled">
                <div class="d-flex justify-content-between small">
                    <span>Subtotal</span>
                    <span t-esc="env.utils.formatCurrency(posRetailSubtotal)"/>
                </div>
                <div class="d-flex justify-content-between small" t-if="posRetailProductDiscounts">
                    <span>Product Discounts</span>
                    <span t-esc="env.utils.formatCurrency(-posRetailProductDiscounts)"/>
                </div>
                <div class="d-flex justify-content-between small" t-if="posRetailOrderDiscountAmount">
                    <span>Order Discount</span>
                    <span t-esc="env.utils.formatCurrency(posRetailOrderDiscountAmount)"/>
                </div>
                <div class="d-flex justify-content-between small" t-if="posRetailRoundOff">
                    <span>Round-Off Adjustment</span>
                    <span t-esc="env.utils.formatCurrency(posRetailRoundOff)"/>
                </div>
                <div class="d-flex justify-content-between small">
                    <span>Tax</span>
                    <span t-esc="env.utils.formatCurrency(currentOrder.amountTaxes)"/>
                </div>
                <div class="d-flex justify-content-between fw-bold border-top pt-1 mt-1">
                    <span>Grand Total</span>
                    <span t-esc="env.utils.formatCurrency(currentOrder.totalDue)"/>
                </div>

                <div class="d-flex gap-1 mt-2">
                    <button class="btn btn-sm flex-fill"
                            t-att-class="orderDiscountState.kind === 'fixed' ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => orderDiscountState.kind = 'fixed'">Fixed Amount</button>
                    <button class="btn btn-sm flex-fill"
                            t-att-class="orderDiscountState.kind === 'percent' ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => orderDiscountState.kind = 'percent'">Percentage</button>
                </div>
                <input type="number" class="form-control form-control-sm mt-1"
                       placeholder="Discount amount" t-model="orderDiscountState.amount"/>
                <select class="form-select form-select-sm mt-1"
                        t-on-change="(ev) => orderDiscountState.reasonId = ev.target.value ? parseInt(ev.target.value) : false">
                    <option value="">Select a reason...</option>
                    <t t-foreach="pos.models['pos.retail.discount.reason'].getAll()" t-as="reason" t-key="reason.id">
                        <option t-att-value="reason.id" t-esc="reason.name"/>
                    </t>
                </select>
                <textarea class="form-control form-control-sm mt-1" rows="1"
                          placeholder="Additional notes (optional)"
                          t-model="orderDiscountState.notes"/>
                <button class="btn btn-sm btn-primary w-100 mt-2"
                        t-on-click="() => posRetailApplyOrderDiscount()">
                    Apply Order Discount
                </button>
            </div>
        </xpath>
    </t>

</templates>
