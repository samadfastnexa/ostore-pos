<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Order-level discount panel on the Payment screen. Kept COMPACT and
         COLLAPSED by default: the payment screen's left column packs the numpad
         and Back/Validate into a flex-shrink-0 / overflow-hidden block, so a
         tall always-open panel clips those buttons off-screen at 100% zoom.
         A slim toggle keeps them visible; the body (capped + scrollable via
         pos_theme.scss) only shows when the cashier opens it. The redundant
         Subtotal/Tax/Grand Total lines were dropped; the big total on the
         right already shows it. -->
    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]" position="before">
            <div class="pos-retail-order-discount mb-2" t-if="pos.config.pos_retail_discount_enabled">
                <button class="pos-retail-discount-toggle btn btn-sm btn-outline-primary w-100 d-flex justify-content-between align-items-center"
                        t-on-click="() => orderDiscountState.open = !orderDiscountState.open">
                    <span><i class="fa fa-tag me-1"/>Order Discount</span>
                    <i t-attf-class="fa {{ orderDiscountState.open ? 'fa-chevron-up' : 'fa-chevron-down' }}"/>
                </button>
                <div t-if="orderDiscountState.open"
                     class="pos-retail-order-discount-body border border-top-0 rounded-bottom p-2">
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm flex-fill"
                                t-att-class="orderDiscountState.kind === 'fixed' ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => orderDiscountState.kind = 'fixed'"><i class="fa fa-money me-1"/>Fixed Amount</button>
                        <button class="btn btn-sm flex-fill"
                                t-att-class="orderDiscountState.kind === 'percent' ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => orderDiscountState.kind = 'percent'"><i class="fa fa-percent me-1"/>Percentage</button>
                    </div>
                    <input type="number" class="form-control form-control-sm mt-1"
                           placeholder="Discount amount" t-model="orderDiscountState.amount"/>
                    <select class="form-select form-select-sm mt-1"
                            t-on-change="(ev) => this.posRetailSetReasonId(ev.target.value)">
                        <option value="">Select a reason...</option>
                        <t t-foreach="pos.models['pos.retail.discount.reason'].getAll()" t-as="reason" t-key="reason.id">
                            <option t-att-value="reason.id" t-esc="reason.name"/>
                        </t>
                    </select>
                    <textarea class="form-control form-control-sm mt-1" rows="1"
                              placeholder="Additional notes (optional)"
                              t-model="orderDiscountState.notes"/>
                    <button class="btn btn-sm btn-primary w-100 mt-2"
                            t-on-click="() => this.posRetailApplyOrderDiscount()">
                        <i class="fa fa-check-circle me-1"/>Apply Order Discount
                    </button>
                </div>
            </div>
        </xpath>
    </t>

</templates>
