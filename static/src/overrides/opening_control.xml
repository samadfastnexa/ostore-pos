<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Name the cashier on the Opening Control dialog. The opening float is
         declared, not counted by the system, so it is the one number in the
         day that rests entirely on who typed it. Putting the name next to the
         box makes that ownership visible at the moment of typing. -->
    <t t-inherit="point_of_sale.OpeningControlPopup" t-inherit-mode="extension">
        <xpath expr="//h4[hasclass('modal-title')]" position="after">
            <div class="pos-retail-opening-cashier small mt-1" t-if="posRetailCashierName">
                <i class="fa fa-user-o me-1"/>Opened by
                <span class="fw-bold" t-esc="posRetailCashierName"/>
            </div>
        </xpath>
    </t>

</templates>
