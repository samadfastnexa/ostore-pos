<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_retail.QuotationModal">
        <Dialog size="'xl'" title="state.editingQuote ? 'Edit Quotation ' + state.editingQuote.name : 'Quotations History &amp; Settle'"
                contentClass="'pos-retail-quote-modal-content'" bodyClass="'pos-retail-quote-modal p-0'">
            <div class="pos-retail-quote-container d-flex flex-column h-100">

                <!-- ======================================================= -->
                <!-- VIEW 1: QUOTATIONS LIST VIEW                            -->
                <!-- ======================================================= -->
                <t t-if="!state.editingQuote">
                    <!-- Header Bar -->
                    <div class="pos-retail-modal-header-bar p-3 bg-light border-bottom flex-shrink-0">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge text-white px-3 py-2 fs-6" style="background-color: #6f42c1;">
                                    <i class="fa fa-file-text-o me-1"/> Store Quotations
                                </span>
                                <span class="text-muted small">
                                    Showing <strong t-esc="filteredQuotations.length"/> quotations
                                </span>
                            </div>
                            <button class="btn btn-outline-secondary btn-sm" t-on-click="fetchQuotations">
                                <i class="fa fa-refresh me-1"/> Refresh
                            </button>
                        </div>

                        <!-- Search & Filter Controls -->
                        <div class="row g-2 align-items-center">
                            <div class="col-md-7">
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="fa fa-search text-muted"/></span>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Search by quote number (SO...), customer name, or phone..."
                                           t-att-value="state.searchQuery"
                                           t-on-input="onSearchInput"
                                           autofocus="autofocus"/>
                                    <button t-if="state.searchQuery" class="btn btn-outline-secondary" t-on-click="clearSearch">
                                        <i class="fa fa-times"/>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-5 d-flex gap-2">
                                <button t-if="state.currentPartner"
                                        type="button"
                                        class="btn btn-sm text-truncate"
                                        t-att-class="state.onlyThisCustomer ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="toggleCustomerFilter"
                                        style="max-width: 180px;">
                                    <i class="fa fa-user me-1"/> <t t-esc="state.currentPartner.name"/>
                                </button>

                                <div class="btn-group btn-group-sm flex-fill" role="group">
                                    <button type="button"
                                            class="btn"
                                            t-att-class="state.filter === 'all' ? 'btn-dark' : 'btn-outline-secondary'"
                                            t-on-click="() => this.setFilter('all')">
                                        All
                                    </button>
                                    <button type="button"
                                            class="btn"
                                            t-att-class="state.filter === 'draft' ? 'btn-warning text-dark' : 'btn-outline-warning'"
                                            t-on-click="() => this.setFilter('draft')">
                                        Drafts
                                    </button>
                                    <button type="button"
                                            class="btn"
                                            t-att-class="state.filter === 'sent' ? 'btn-info text-white' : 'btn-outline-info'"
                                            t-on-click="() => this.setFilter('sent')">
                                        Sent Quotes
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Error Alert if any -->
                    <div t-if="state.errorMessage" class="alert alert-danger m-3 mb-0 py-2 px-3 flex-shrink-0">
                        <i class="fa fa-exclamation-triangle me-1"/> <t t-esc="state.errorMessage"/>
                    </div>

                    <!-- Quotations Table Area -->
                    <div class="pos-retail-table-wrapper flex-grow-1 overflow-auto p-0">
                        <div t-if="state.loading" class="text-center p-5 text-muted">
                            <i class="fa fa-circle-o-notch fa-spin fa-2x mb-2 text-primary"/>
                            <div>Loading quotations from server...</div>
                        </div>

                        <div t-elif="!filteredQuotations.length" class="text-center p-5 text-muted">
                            <i class="fa fa-file-text-o fa-3x mb-2 text-black-50"/>
                            <div class="fs-6">No quotations found.</div>
                            <div class="small text-muted mt-1">Open quotations (Draft or Sent) will appear here.</div>
                        </div>

                        <table t-else="" class="table table-hover align-middle mb-0" style="font-size: 0.92rem;">
                            <thead>
                                <tr>
                                    <th style="width: 14%;">Quote #</th>
                                    <th style="width: 18%;">Date &amp; Time</th>
                                    <th style="width: 24%;">Customer</th>
                                    <th class="text-center" style="width: 10%;">Status</th>
                                    <th class="text-end" style="width: 14%;">Total Amount</th>
                                    <th class="text-center" style="width: 20%;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="filteredQuotations" t-as="q" t-key="q.id">
                                    <td>
                                        <div class="fw-bold font-monospace text-primary fs-6" t-esc="q.name"/>
                                        <div class="small text-muted"><t t-esc="q.line_count"/> item(s)</div>
                                    </td>
                                    <td>
                                        <div class="small text-dark" t-esc="q.date || '-'"/>
                                        <div t-if="q.validity_date" class="small text-muted">
                                            Valid: <t t-esc="q.validity_date"/>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">
                                            <i class="fa fa-user-circle me-1 text-secondary"/>
                                            <t t-esc="q.partner_name || 'Walk-in Customer'"/>
                                        </div>
                                        <div t-if="q.partner_phone" class="small text-muted font-monospace">
                                            <i class="fa fa-phone me-1"/> <t t-esc="q.partner_phone"/>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span t-if="q.state === 'sent'" class="badge bg-info text-white px-2 py-1">
                                            Sent
                                        </span>
                                        <span t-elif="q.state === 'draft'" class="badge bg-warning text-dark px-2 py-1">
                                            Draft
                                        </span>
                                        <span t-else="" class="badge bg-secondary px-2 py-1" t-esc="q.state"/>
                                        <span t-if="q.approved" class="badge bg-success ms-1">Approved</span>
                                    </td>
                                    <td class="text-end fw-bold text-dark fs-6">
                                        <t t-esc="formatMoney(q.amount_total)"/>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <!-- Load & Settle -->
                                            <button type="button"
                                                    class="btn btn-success fw-semibold"
                                                    title="Load into POS cart to settle or ring up"
                                                    t-att-disabled="state.isLoadingLines"
                                                    t-on-click="() => this.loadQuoteIntoCart(q)">
                                                <i class="fa fa-shopping-cart me-1"/> Load
                                            </button>
                                            <!-- Edit Quotation Button -->
                                            <button type="button"
                                                    class="btn btn-outline-primary fw-semibold"
                                                    title="View &amp; Edit Quotation Lines, Prices, and Quantities"
                                                    t-on-click="() => this.openEditor(q)">
                                                <i class="fa fa-pencil me-1"/> Edit
                                            </button>
                                            <!-- WhatsApp Share Button -->
                                            <button type="button"
                                                    class="btn btn-outline-success"
                                                    title="Send quotation to customer on WhatsApp"
                                                    t-att-disabled="state.sharingQuoteId === q.id"
                                                    t-on-click="() => this.shareQuotationWhatsApp(q)">
                                                <i t-if="state.sharingQuoteId === q.id" class="fa fa-circle-o-notch fa-spin"/>
                                                <i t-else="" class="fa fa-whatsapp fs-6 text-success"/>
                                            </button>
                                            <!-- Print PDF -->
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    title="Print or view quotation PDF"
                                                    t-on-click="() => this.printQuotationPdf(q)">
                                                <i class="fa fa-print"/>
                                            </button>
                                            <!-- Duplicate -->
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    title="Duplicate into a fresh draft quote"
                                                    t-on-click="() => this.duplicateQuotation(q)">
                                                <i class="fa fa-clone"/>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Footer -->
                    <div class="pos-retail-modal-footer p-3 bg-light border-top d-flex justify-content-between align-items-center flex-shrink-0">
                        <div class="text-muted small">
                            <i class="fa fa-info-circle me-1"/> Click <strong>Load</strong> to sell, <strong>Edit</strong> to modify items/prices, or <strong class="text-success"><i class="fa fa-whatsapp"/></strong> to share instantly.
                        </div>
                        <button class="btn btn-secondary px-4" t-on-click="() => this.props.close()">
                            Close
                        </button>
                    </div>
                </t>

                <!-- ======================================================= -->
                <!-- VIEW 2: INLINE QUOTATION EDITOR                         -->
                <!-- ======================================================= -->
                <t t-else="">
                    <!-- Editor Top Bar -->
                    <div class="p-3 bg-light border-bottom flex-shrink-0">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-3">
                                <button type="button" class="btn btn-outline-secondary btn-sm" t-on-click="closeEditor">
                                    <i class="fa fa-arrow-left me-1"/> Back to Quotations
                                </button>
                                <div class="fs-5 fw-bold text-dark">
                                    Editing Quotation: <span class="text-primary font-monospace" t-esc="state.editingQuote.name"/>
                                </div>
                                <span t-if="state.editingQuote.state === 'sent'" class="badge bg-info text-white px-2 py-1">Sent</span>
                                <span t-elif="state.editingQuote.state === 'draft'" class="badge bg-warning text-dark px-2 py-1">Draft</span>
                                <span t-if="state.isDirty" class="badge bg-warning-subtle text-dark border border-warning px-2 py-1">
                                    <i class="fa fa-pencil me-1"/> Unsaved Changes
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Quoted Total:</span>
                                <span class="fw-bold fs-5 text-success" t-esc="formatMoney(computedEditTotal)"/>
                            </div>
                        </div>

                        <!-- Customer & Metadata row -->
                        <div class="row g-2 align-items-end mt-1">
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">Customer</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white"><i class="fa fa-user text-secondary"/></span>
                                    <input type="text" class="form-control bg-white" readonly="readonly"
                                           t-att-value="state.editPartnerName || 'No customer selected'"/>
                                    <button class="btn btn-outline-primary" type="button" t-on-click="changeEditCustomer">
                                        Change
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-muted mb-1">Customer Phone (WhatsApp)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-white"><i class="fa fa-whatsapp text-success"/></span>
                                    <input type="text" class="form-control"
                                           placeholder="e.g. 03001234567"
                                           t-model="state.editPartnerPhone"/>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-muted mb-1">Validity Date (Optional)</label>
                                <input type="date" class="form-control form-control-sm"
                                       t-model="state.editValidityDate"/>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small text-muted mb-1">Quotation Notes</label>
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="Notes / Delivery info"
                                       t-model="state.editNote"/>
                            </div>
                        </div>
                    </div>

                    <!-- Add Product Search Bar -->
                    <div class="p-2 px-3 bg-white border-bottom flex-shrink-0 position-relative">
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa fa-barcode text-primary"/></span>
                            <input type="text"
                                   class="form-control"
                                   placeholder="Scan barcode or type product name/brand to add item to quotation..."
                                   t-att-value="state.productSearchQuery"
                                   t-on-input="onProductSearchInput"/>
                            <span t-if="state.searchingProducts" class="input-group-text bg-white">
                                <i class="fa fa-circle-o-notch fa-spin text-primary"/>
                            </span>
                        </div>

                        <!-- Dropdown of matching products to add -->
                        <div t-if="state.productSearchResults.length"
                             class="position-absolute bg-white border rounded shadow-lg p-0"
                             style="top: 100%; left: 1rem; right: 1rem; z-index: 1050; max-height: 250px; overflow-y: auto;">
                            <div class="list-group list-group-flush">
                                <a t-foreach="state.productSearchResults" t-as="item" t-key="item.id"
                                   href="#"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2"
                                   t-on-click.prevent="() => this.addProductToEditQuote(item)">
                                    <div>
                                        <strong class="text-dark" t-esc="item.name"/>
                                        <span t-if="item.brand_name" class="badge bg-primary-subtle text-primary border ms-2" t-esc="item.brand_name"/>
                                        <span t-if="item.barcode" class="small text-muted font-monospace ms-2" t-esc="item.barcode"/>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <span class="badge bg-light text-muted border">Stock: <t t-esc="item.on_hand"/> <t t-esc="item.uom"/></span>
                                        <span class="fw-bold text-primary" t-esc="formatMoney(item.list_price)"/>
                                        <span class="btn btn-sm btn-primary py-0 px-2">+ Add</span>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Quoted Lines Table -->
                    <div class="pos-retail-table-wrapper flex-grow-1 overflow-auto p-0">
                        <div t-if="!state.editLines.length" class="text-center p-5 text-muted">
                            <i class="fa fa-cube fa-3x mb-2 text-black-50"/>
                            <div>No items in this quotation yet. Search above to add products.</div>
                        </div>

                        <table t-else="" class="table table-hover align-middle mb-0" style="font-size: 0.92rem;">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 5%;">#</th>
                                    <th style="width: 32%;">Product &amp; Brand</th>
                                    <th style="width: 14%;">SKU / Barcode</th>
                                    <th class="text-center" style="width: 16%;">Quantity</th>
                                    <th class="text-end" style="width: 13%;">Unit Price</th>
                                    <th class="text-center" style="width: 8%;">Disc %</th>
                                    <th class="text-end" style="width: 12%;">Subtotal</th>
                                    <th class="text-center" style="width: 5%;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.editLines" t-as="line" t-key="line.product_id + '_' + line_index">
                                    <td class="text-muted small" t-esc="line_index + 1"/>
                                    <td>
                                        <div class="fw-bold text-dark" t-esc="line.product_name"/>
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <span t-if="line.brand_name" class="badge bg-primary-subtle text-primary border px-2 py-0">
                                                <i class="fa fa-tag me-1"/> <t t-esc="line.brand_name"/>
                                            </span>
                                            <span class="small text-muted">UoM: <strong t-esc="line.uom"/></span>
                                        </div>
                                    </td>
                                    <td>
                                        <div t-if="line.barcode" class="small font-monospace text-primary fw-semibold">
                                            <i class="fa fa-barcode me-1"/> <t t-esc="line.barcode"/>
                                        </div>
                                        <div t-if="line.default_code" class="small text-muted font-monospace" t-esc="line.default_code"/>
                                        <div t-if="!line.barcode and !line.default_code" class="text-muted small">-</div>
                                    </td>
                                    <td class="text-center">
                                        <div class="input-group input-group-sm d-inline-flex" style="max-width: 140px;">
                                            <button class="btn btn-outline-secondary" type="button"
                                                    t-on-click="() => this.updateLineQty(line, -1)">-</button>
                                            <input type="number" step="any" min="0.01"
                                                   class="form-control text-center fw-bold"
                                                   t-att-value="line.qty"
                                                   t-on-change="(ev) => this.onLineQtyChange(line, ev)"/>
                                            <button class="btn btn-outline-secondary" type="button"
                                                    t-on-click="() => this.updateLineQty(line, 1)">+</button>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <input type="number" step="any" min="0"
                                               class="form-control form-control-sm text-end fw-semibold ms-auto"
                                               style="max-width: 120px;"
                                               t-att-value="line.price_unit"
                                               t-on-change="(ev) => this.onLinePriceChange(line, ev)"/>
                                    </td>
                                    <td class="text-center">
                                        <input type="number" step="any" min="0" max="100"
                                               class="form-control form-control-sm text-center"
                                               style="max-width: 70px; margin: 0 auto;"
                                               t-att-value="line.discount"
                                               t-on-change="(ev) => this.onLineDiscountChange(line, ev)"/>
                                    </td>
                                    <td class="text-end fw-bold text-dark fs-6">
                                        <t t-esc="formatMoney(line.qty * line.price_unit * (1 - (line.discount || 0) / 100))"/>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-outline-danger btn-sm p-1 px-2"
                                                title="Delete Line"
                                                t-on-click="() => this.removeLine(line_index)">
                                            <i class="fa fa-trash"/>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Editor Footer Bar -->
                    <div class="pos-retail-modal-footer p-3 bg-light border-top d-flex justify-content-between align-items-center flex-shrink-0">
                        <div class="d-flex align-items-center gap-3">
                            <span class="fs-6 text-muted">Total Quoted Amount:</span>
                            <span class="fw-bold fs-4 text-success" t-esc="formatMoney(computedEditTotal)"/>
                            <span class="badge bg-secondary" t-esc="state.editLines.length + ' item(s)'"/>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <!-- Edit in POS Register Cart -->
                            <button type="button" class="btn btn-outline-dark"
                                    title="Open this quotation in the POS cash register to scan items with barcode scanner"
                                    t-on-click="editInPosCart">
                                <i class="fa fa-desktop me-1"/> Edit in POS Cart
                            </button>
                            <!-- Print PDF -->
                            <button type="button" class="btn btn-outline-secondary"
                                    t-on-click="() => this.printQuotationPdf(state.editingQuote)">
                                <i class="fa fa-print me-1"/> Print
                            </button>
                            <!-- Send on WhatsApp -->
                            <button type="button" class="btn btn-success fw-bold"
                                    style="background-color: #25D366; border-color: #25D366;"
                                    t-att-disabled="state.sharingQuoteId === state.editingQuote.id"
                                    t-on-click="shareEditorWhatsApp">
                                <i t-if="state.sharingQuoteId === state.editingQuote.id" class="fa fa-circle-o-notch fa-spin me-1"/>
                                <i t-else="" class="fa fa-whatsapp me-1"/> WhatsApp
                            </button>
                            <!-- Save Changes -->
                            <button type="button" class="btn btn-primary fw-bold px-4"
                                    t-att-disabled="state.editSaving"
                                    t-on-click="saveQuotationChanges">
                                <i t-if="state.editSaving" class="fa fa-circle-o-notch fa-spin me-1"/>
                                <i t-else="" class="fa fa-save me-1"/> Save Changes
                            </button>
                        </div>
                    </div>
                </t>

            </div>
        </Dialog>
    </t>

</templates>
