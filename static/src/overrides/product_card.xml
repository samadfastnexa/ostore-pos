<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Price, allowed selling range and stock on the product card. Core shows
         no price here at all, so this is purely additive. Skipped inside the
         combo configurator popup, where the card is a compact chooser and the
         extra lines would only add noise.
         The getter is materialised ONCE via t-set: OWL does not memoize
         getters, and referencing it per-expression re-ran the whole
         computation (formatCurrency x3 + a variant reduce) up to 8 times per
         card, per render, across a grid of up to 100 cards on every search
         keystroke and screen transition. -->
    <t t-name="pos_retail.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="inside">
            <t t-if="!props.isComboPopup" t-set="posRetailInfo" t-value="posRetailPriceInfo"/>
            <t t-if="!props.isComboPopup and posRetailInfo">
                <!-- A live brand campaign, so a cashier sees the offer sitting
                     on the grid before it is ever on a bill. Top-start is the
                     one corner nothing else claims: core keeps the combo
                     extra-price badge top-end, and this file's own quantity
                     badge fix above already moved the cart-count marker there
                     too. Positioned absolute against the outer article element
                     itself (the nearest position-relative ancestor), even
                     though this span lives inside product-content: that div
                     sets no position of its own, so top-0/start-0 still
                     measure from the whole card, not from partway down the
                     text column. -->
                <span t-if="posRetailInfo.campaignPercent"
                      class="pos-retail-card-campaign position-absolute top-0 start-0 m-1 px-2 rounded-pill text-white fw-bolder"
                      t-attf-title="{{posRetailInfo.campaignPercent}}% off right now">
                    <t t-esc="posRetailInfo.campaignPercent"/>% OFF
                </span>
                <div class="pos-retail-card-price">
                    <t t-esc="posRetailInfo.price"/><small t-if="posRetailInfo.priceSuffix"
                        class="pos-retail-card-uom" t-esc="posRetailInfo.priceSuffix"/>
                </div>
                <div t-if="posRetailInfo.hasRange"
                     class="pos-retail-card-range"
                     title="Allowed selling range">
                    <i class="fa fa-arrows-h me-1"/><t t-esc="posRetailInfo.range"/>
                </div>
                <div t-if="posRetailInfo.isStorable"
                     class="pos-retail-card-stock"
                     t-att-class="{ 'pos-retail-card-stock--out': posRetailInfo.qty &lt;= 0 }">
                    <t t-if="posRetailInfo.qty &gt; 0">
                        <t t-esc="posRetailInfo.qtyLabel"/> in stock
                    </t>
                    <t t-else="">Out of stock</t>
                </div>
            </t>
        </xpath>
    </t>

</templates>
