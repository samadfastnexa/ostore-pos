<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_retail.LineDiscountPopup">
        <Dialog title="'Product Discount'" size="'md'">
            <div class="pos-retail-line-discount-popup d-flex flex-column p-1">

                <!-- 1. Product Header -->
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold fs-5 text-truncate" style="max-width: 75%;">
                        <i class="fa fa-cube text-primary me-2"/>
                        <t t-esc="product.display_name"/>
                    </span>
                    <span class="badge bg-secondary">Qty: <t t-esc="line.qty"/></span>
                </div>

                <div class="d-flex flex-wrap gap-3 text-muted small mb-3 pb-2 border-bottom">
                    <div>Original: <strong class="text-dark"><t t-esc="formatCurrency(originalUnitPrice)"/></strong></div>
                    <div t-if="minPrice">Minimum Allowed: <strong class="text-danger"><t t-esc="formatCurrency(minPrice)"/></strong></div>
                    <div t-if="minPrice">Max Discount: <strong class="text-success"><t t-esc="maxAllowedDiscountPercent.toFixed(1)"/>%</strong></div>
                </div>

                <!-- 2. Simple Mode Switcher (Discount % vs New Price) -->
                <div class="btn-group w-100 mb-3" role="group">
                    <button type="button" class="btn btn-lg py-2"
                            t-att-class="state.tab === 'percent' ? 'btn-primary fw-bold' : 'btn-outline-primary'"
                            t-on-click="() => this.setTab('percent')">
                        <i class="fa fa-percent me-2"/>Discount %
                    </button>
                    <button type="button" class="btn btn-lg py-2"
                            t-att-class="state.tab === 'price' ? 'btn-primary fw-bold' : 'btn-outline-primary'"
                            t-on-click="() => this.setTab('price')">
                        <i class="fa fa-tag me-2"/>New Price (<t t-esc="pos.currency.symbol || ''"/>)
                    </button>
                </div>

                <!-- 3A. Discount % Mode -->
                <div t-if="state.tab === 'percent'" class="d-flex flex-column gap-2 mb-3">
                    <div class="input-group input-group-lg shadow-sm">
                        <input type="number" step="1" min="0" max="100"
                               class="form-control text-center fs-2 fw-bolder"
                               t-att-class="isBelowMinimum ? 'is-invalid text-danger' : 'text-primary'"
                               t-att-value="state.pctInput"
                               t-on-input="(ev) => this.onPctInput(ev)"
                               placeholder="0" autofocus="autofocus"/>
                        <span class="input-group-text fs-3 fw-bold bg-light">%</span>
                    </div>

                    <div class="d-flex flex-wrap gap-1 justify-content-center mt-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" t-on-click="() => this.applyPresetPercent(5)">5%</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" t-on-click="() => this.applyPresetPercent(10)">10%</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" t-on-click="() => this.applyPresetPercent(15)">15%</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary px-3" t-on-click="() => this.applyPresetPercent(20)">20%</button>
                        <button t-if="minPrice" type="button" class="btn btn-sm btn-outline-success fw-bold px-2"
                                t-on-click="() => this.applyMaxAllowed()">
                            Max (<t t-esc="maxAllowedDiscountPercent.toFixed(1)"/>%)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger px-2 ms-auto" t-on-click="() => this.clearAll()">
                            Clear
                        </button>
                    </div>
                </div>

                <!-- 3B. New Price Mode -->
                <div t-if="state.tab === 'price'" class="d-flex flex-column gap-2 mb-3">
                    <div class="input-group input-group-lg shadow-sm">
                        <span class="input-group-text fs-3 fw-bold bg-light"><t t-esc="pos.currency.symbol || ''"/></span>
                        <input type="number" step="1" min="0"
                               class="form-control text-center fs-2 fw-bolder"
                               t-att-class="isBelowMinimum ? 'is-invalid text-danger' : 'text-primary'"
                               t-att-value="state.priceInput"
                               t-on-input="(ev) => this.onPriceInput(ev)"
                               placeholder="0.00" autofocus="autofocus"/>
                    </div>

                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-1">
                        <button t-if="minPrice" type="button" class="btn btn-sm btn-outline-danger fw-bold px-3"
                                t-on-click="() => this.applyPresetPrice(minPrice)">
                            Min Price (<t t-esc="formatCurrency(minPrice)"/>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary px-3"
                                t-on-click="() => this.applyPresetPrice(defaultPrice)">
                            Original Price (<t t-esc="formatCurrency(defaultPrice)"/>)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger px-2 ms-auto" t-on-click="() => this.clearAll()">
                            Clear
                        </button>
                    </div>
                </div>

                <!-- 4. Crystal-Clear Customer Price Summary -->
                <div class="card p-3 mb-2 text-center border-2 shadow-sm"
                     t-att-class="isBelowMinimum ? 'bg-danger-subtle border-danger' : 'bg-success-subtle border-success'">
                    <div class="small fw-semibold text-uppercase text-muted">Customer Pays</div>
                    <div class="fs-2 fw-bolder" t-att-class="isBelowMinimum ? 'text-danger' : 'text-success'">
                        <t t-esc="formatCurrency(currentFinalPrice)"/>
                    </div>
                    <div class="small fw-bold" t-att-class="isBelowMinimum ? 'text-danger' : 'text-success'">
                        Discount: <t t-esc="currentPercent.toFixed(1)"/>% (-<t t-esc="formatCurrency(currentDiscountAmount)"/>)
                        <t t-if="line.qty &gt; 1">
                            • Total for <t t-esc="line.qty"/> units: <t t-esc="formatCurrency(totalFinalPrice)"/>
                        </t>
                    </div>
                </div>

                <!-- 5. Clear Warning when Below Minimum -->
                <div t-if="isBelowMinimum" class="alert alert-danger py-2 px-3 small mb-2 d-flex align-items-center shadow-sm">
                    <i class="fa fa-exclamation-triangle me-2 fs-5 text-danger"/>
                    <div>
                        <strong>Price is below minimum (<t t-esc="formatCurrency(minPrice)"/>).</strong><br/>
                        <t t-if="canManagerOverride">
                            <span class="text-primary fw-bold"><i class="fa fa-lock me-1"/>Manager PIN approval required to apply.</span>
                        </t>
                        <t t-else="">
                            Please enter a price of at least <t t-esc="formatCurrency(minPrice)"/>.
                        </t>
                    </div>
                </div>

                <!-- 6. Reason and Options -->
                <div class="d-flex flex-column gap-2 mb-2">
                    <div>
                        <input type="text" class="form-control form-control-sm"
                               placeholder="Reason for discount (optional)"
                               t-model="state.reason"/>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="pos_retail_apply_all_check"
                               t-model="state.applyToAll"/>
                        <label class="form-check-label small fw-semibold cursor-pointer" for="pos_retail_apply_all_check">
                            Apply this discount to all items in cart (validates each minimum price)
                        </label>
                    </div>
                </div>

            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary px-3" t-on-click="() => this.props.close()">
                    Cancel
                </button>
                <button class="btn btn-lg px-4"
                        t-att-class="isBelowMinimum ? 'btn-warning text-dark fw-bold' : 'btn-success text-white fw-bold'"
                        t-on-click="() => this.confirm()">
                    <t t-if="isBelowMinimum and canManagerOverride">
                        <i class="fa fa-lock me-2"/>Manager Approve &amp; Apply
                    </t>
                    <t t-else="">
                        <i class="fa fa-check me-2"/>Apply (<t t-esc="formatCurrency(currentFinalPrice)"/>)
                    </t>
                </button>
            </t>
        </Dialog>
    </t>

</templates>
