<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_retail.LineDiscountPopup">
        <Dialog title="'Product Discount &amp; Price Adjustment'" size="'md'">
            <div class="pos-retail-line-discount-popup d-flex flex-column gap-3 p-1">

                <!-- Product Summary Card -->
                <div class="card bg-light border-0 shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold fs-5 text-truncate" style="max-width: 75%;">
                            <i class="fa fa-cube text-primary me-2"/>
                            <t t-esc="product.display_name"/>
                        </span>
                        <span class="badge bg-secondary fs-6">
                            Qty: <t t-esc="line.qty"/>
                        </span>
                    </div>

                    <div class="row g-2 text-muted small">
                        <div class="col-4">
                            <div>Original Price:</div>
                            <div class="fw-bold text-dark fs-6"><t t-esc="formatCurrency(originalUnitPrice)"/></div>
                        </div>
                        <div class="col-4">
                            <div>Minimum Allowed:</div>
                            <div class="fw-bold text-danger fs-6">
                                <t t-if="minPrice" t-esc="formatCurrency(minPrice)"/>
                                <t t-else="">None</t>
                            </div>
                        </div>
                        <div class="col-4">
                            <div>Max Discount:</div>
                            <div class="fw-bold text-success fs-6">
                                <t t-if="minPrice">
                                    <t t-esc="maxAllowedDiscountPercent.toFixed(1)"/>% / <t t-esc="formatCurrency(maxAllowedDiscountAmount)"/>
                                </t>
                                <t t-else="">100%</t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick One-Tap Targets & Presets -->
                <div class="d-flex flex-wrap gap-1 align-items-center">
                    <span class="small fw-semibold text-muted me-1">Quick:</span>
                    <button t-if="minPrice and minPrice &lt; originalUnitPrice"
                            type="button" class="btn btn-sm btn-outline-danger fw-bold"
                            title="Sell at exact minimum allowed price"
                            t-on-click="() => this.applyTargetPrice(minPrice)">
                        Min Price (<t t-esc="formatCurrency(minPrice)"/>)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            title="Reset to default retail price"
                            t-on-click="() => this.applyTargetPrice(defaultPrice)">
                        Original Price
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.applyPreset(2)">2%</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.applyPreset(5)">5%</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.applyPreset(10)">10%</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.applyPreset(15)">15%</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" t-on-click="() => this.applyPreset(20)">20%</button>
                    <button type="button" class="btn btn-sm btn-outline-dark ms-auto" t-on-click="() => this.clearDiscount()">
                        Clear
                    </button>
                </div>

                <!-- 3 Synchronized Inputs: Discount %, Amount Off, and New Selling Price -->
                <div class="row g-2">
                    <div class="col-4">
                        <label class="form-label small fw-bold mb-1" for="pos_retail_line_disc_pct">
                            <i class="fa fa-percent me-1"/>Discount (%)
                        </label>
                        <div class="input-group">
                            <input id="pos_retail_line_disc_pct" type="number" step="0.1" min="0" max="100"
                                   class="form-control form-control-lg fw-bold"
                                   t-att-class="isBelowMinimum ? 'is-invalid border-danger text-danger' : ''"
                                   t-att-value="state.discountPct"
                                   t-on-input="(ev) => this.onPercentInput(ev)"
                                   placeholder="0"/>
                            <span class="input-group-text">%</span>
                        </div>
                    </div>

                    <div class="col-4">
                        <label class="form-label small fw-bold mb-1" for="pos_retail_line_disc_fixed">
                            <i class="fa fa-minus-circle me-1"/>Amount Off
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><t t-esc="pos.currency.symbol || ''"/></span>
                            <input id="pos_retail_line_disc_fixed" type="number" step="0.01" min="0"
                                   class="form-control form-control-lg fw-bold"
                                   t-att-class="isBelowMinimum ? 'is-invalid border-danger text-danger' : ''"
                                   t-att-value="state.discountFixed"
                                   t-on-input="(ev) => this.onFixedInput(ev)"
                                   placeholder="0.00"/>
                        </div>
                    </div>

                    <div class="col-4">
                        <label class="form-label small fw-bold mb-1 text-primary" for="pos_retail_line_target_price">
                            <i class="fa fa-tag me-1"/>New Selling Price
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-primary-subtle text-primary fw-bold"><t t-esc="pos.currency.symbol || ''"/></span>
                            <input id="pos_retail_line_target_price" type="number" step="0.01" min="0"
                                   class="form-control form-control-lg fw-bold border-primary"
                                   t-att-class="isBelowMinimum ? 'is-invalid border-danger text-danger' : ''"
                                   t-att-value="state.targetPrice"
                                   t-on-input="(ev) => this.onTargetPriceInput(ev)"
                                   placeholder="0.00"/>
                        </div>
                    </div>
                </div>

                <!-- Live Price Summary Card -->
                <div class="card p-3 shadow-sm" t-att-class="isBelowMinimum ? 'bg-danger-subtle border-danger' : 'bg-success-subtle border-success'">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small text-muted fw-semibold">Final Selling Price (Unit):</div>
                            <div class="fs-3 fw-bolder" t-att-class="isBelowMinimum ? 'text-danger' : 'text-success'">
                                <t t-esc="formatCurrency(finalUnitPrice)"/>
                            </div>
                            <div t-if="line.qty &gt; 1" class="small text-muted">
                                Total (<t t-esc="line.qty"/> units): <strong><t t-esc="formatCurrency(totalFinalPrice)"/></strong>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="small text-muted fw-semibold">Discount Saved:</div>
                            <div class="fs-4 fw-bold text-danger">
                                -<t t-esc="formatCurrency(discountAmountUnit)"/> <span class="small text-muted">/ unit</span>
                            </div>
                            <div t-if="line.qty &gt; 1" class="small text-muted">
                                Total Saved: <strong>-<t t-esc="formatCurrency(totalDiscountAmount)"/></strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Warning when below minimum price -->
                <div t-if="isBelowMinimum" class="alert alert-danger mb-0 p-2 d-flex flex-column gap-1 shadow-sm">
                    <div class="fw-bold d-flex align-items-center text-danger">
                        <i class="fa fa-exclamation-triangle me-2 fs-5"/>
                        <span>⚠️ Discount Not Allowed (Below Minimum Price)</span>
                    </div>
                    <div class="small">
                        This discount reduces the selling price below the minimum allowed price of 
                        <strong><t t-esc="formatCurrency(minPrice)"/></strong>. Current entered price is <strong><t t-esc="formatCurrency(finalUnitPrice)"/></strong>.
                    </div>
                    <div t-if="canManagerOverride" class="text-primary small mt-1 fw-bold">
                        <i class="fa fa-lock me-1"/>Manager PIN approval is required to sell at this price.
                    </div>
                    <div t-else="" class="text-danger small mt-1 fw-bold">
                        Please raise the selling price to at least <t t-esc="formatCurrency(minPrice)"/>.
                    </div>
                </div>

                <!-- Reason Field -->
                <div>
                    <label class="form-label small mb-1" for="pos_retail_line_disc_reason">
                        Reason / Notes <t t-if="pos.config.pos_retail_line_discount_require_reason"><span class="text-danger">*</span></t>
                    </label>
                    <input id="pos_retail_line_disc_reason" type="text"
                           class="form-control"
                           placeholder="e.g. Clearance, bulk discount, customer negotiation"
                           t-model="state.reason"/>
                </div>

                <!-- Apply to all products checkbox -->
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" id="pos_retail_apply_all_check"
                           t-model="state.applyToAll"/>
                    <label class="form-check-label small fw-semibold cursor-pointer" for="pos_retail_apply_all_check">
                        Apply this discount to ALL products in cart (checks each product's minimum price independently)
                    </label>
                </div>

            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary px-3" t-on-click="() => this.props.close()">
                    Cancel
                </button>
                <button class="btn px-4"
                        t-att-class="isBelowMinimum ? 'btn-warning text-dark fw-bold' : 'btn-primary fw-bold'"
                        t-on-click="() => this.confirm()">
                    <t t-if="isBelowMinimum and canManagerOverride">
                        <i class="fa fa-lock me-1"/>Manager Approve &amp; Apply
                    </t>
                    <t t-else="">
                        <i class="fa fa-check me-1"/>Apply
                    </t>
                </button>
            </t>
        </Dialog>
    </t>

</templates>
