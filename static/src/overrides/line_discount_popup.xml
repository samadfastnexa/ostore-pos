<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_retail.LineDiscountPopup">
        <Dialog title="'Product Discount'" size="'md'">
            <div class="pos-retail-line-discount-popup d-flex flex-column gap-3 p-1">

                <!-- Product Summary Card -->
                <div class="card bg-light border-0 shadow-sm p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold fs-5 text-truncate" style="max-width: 75%;">
                            <i class="fa fa-cube text-primary me-2"/>
                            <t t-esc="product.display_name"/>
                        </span>
                        <span class="badge bg-secondary">
                            Qty: <t t-esc="line.qty"/>
                        </span>
                    </div>

                    <div class="row g-2 text-muted small">
                        <div class="col-4">
                            <div>Original Price:</div>
                            <div class="fw-bold text-dark fs-6"><t t-esc="formatCurrency(originalUnitPrice)"/></div>
                        </div>
                        <div class="col-4">
                            <div>Minimum Price:</div>
                            <div class="fw-bold text-danger fs-6">
                                <t t-if="minPrice" t-esc="formatCurrency(minPrice)"/>
                                <t t-else="">None</t>
                            </div>
                        </div>
                        <div class="col-4">
                            <div>Max Allowed:</div>
                            <div class="fw-bold text-success fs-6">
                                <t t-if="minPrice">
                                    <t t-esc="maxAllowedDiscountPercent.toFixed(1)"/>% / <t t-esc="formatCurrency(maxAllowedDiscountAmount)"/>
                                </t>
                                <t t-else="">100%</t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Preset Quick Buttons -->
                <div class="d-flex flex-wrap gap-1 align-items-center">
                    <span class="small text-muted me-1">Presets:</span>
                    <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="() => this.applyPreset(2)">2%</button>
                    <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="() => this.applyPreset(5)">5%</button>
                    <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="() => this.applyPreset(10)">10%</button>
                    <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="() => this.applyPreset(15)">15%</button>
                    <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="() => this.applyPreset(20)">20%</button>
                    <button t-if="minPrice and maxAllowedDiscountPercent &gt; 0"
                            type="button" class="btn btn-sm btn-outline-success fw-bold"
                            title="Set to maximum allowed discount without manager approval"
                            t-on-click="() => this.applyMaxAllowed()">
                        Max Allowed (<t t-esc="maxAllowedDiscountPercent.toFixed(1)"/>%)
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" t-on-click="() => this.clearDiscount()">
                        Clear
                    </button>
                </div>

                <!-- Discount Input Fields: % and Fixed Amount -->
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small fw-bold mb-1" for="pos_retail_line_disc_pct">
                            <i class="fa fa-percent me-1"/>Percentage (%)
                        </label>
                        <div class="input-group">
                            <input id="pos_retail_line_disc_pct" type="number" step="0.1" min="0" max="100"
                                   class="form-control form-control-lg fw-bold"
                                   t-att-class="isBelowMinimum ? 'is-invalid border-danger text-danger' : ''"
                                   t-att-value="state.discountPct"
                                   t-on-input="(ev) => this.onPercentInput(ev)"
                                   placeholder="0"/>
                            <span class="input-group-text">%</span>
                        </div>
                    </div>

                    <div class="col-6">
                        <label class="form-label small fw-bold mb-1" for="pos_retail_line_disc_fixed">
                            <i class="fa fa-money me-1"/>Amount Off
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><t t-esc="pos.currency.symbol || ''"/></span>
                            <input id="pos_retail_line_disc_fixed" type="number" step="0.01" min="0"
                                   class="form-control form-control-lg fw-bold"
                                   t-att-class="isBelowMinimum ? 'is-invalid border-danger text-danger' : ''"
                                   t-att-value="state.discountFixed"
                                   t-on-input="(ev) => this.onFixedInput(ev)"
                                   placeholder="0.00"/>
                        </div>
                    </div>
                </div>

                <!-- Live Final Price Display -->
                <div class="card p-3" t-att-class="isBelowMinimum ? 'bg-danger-subtle border-danger' : 'bg-success-subtle border-success'">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small text-muted">Final Unit Price:</div>
                            <div class="fs-4 fw-bolder" t-att-class="isBelowMinimum ? 'text-danger' : 'text-success'">
                                <t t-esc="formatCurrency(finalUnitPrice)"/>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="small text-muted">Discount / Unit:</div>
                            <div class="fs-5 fw-bold text-muted">
                                -<t t-esc="formatCurrency(discountAmountUnit)"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Warning when below minimum price -->
                <div t-if="isBelowMinimum" class="alert alert-danger mb-0 p-2 d-flex flex-column gap-1">
                    <div class="fw-bold d-flex align-items-center">
                        <i class="fa fa-exclamation-triangle me-2 fs-5"/>
                        <span>⚠️ Discount Not Allowed (Below Minimum)</span>
                    </div>
                    <div class="small">
                        This discount reduces the selling price below the minimum allowed price of 
                        <strong><t t-esc="formatCurrency(minPrice)"/></strong>. Current price: <strong><t t-esc="formatCurrency(finalUnitPrice)"/></strong>.
                    </div>
                    <div t-if="canManagerOverride" class="text-primary small mt-1 fw-bold">
                        <i class="fa fa-lock me-1"/>Manager override required to apply this discount.
                    </div>
                    <div t-else="" class="text-danger small mt-1 fw-bold">
                        Please reduce the discount.
                    </div>
                </div>

                <!-- Optional Reason Field -->
                <div>
                    <label class="form-label small mb-1" for="pos_retail_line_disc_reason">
                        Reason / Notes <t t-if="pos.config.pos_retail_line_discount_require_reason"><span class="text-danger">*</span></t>
                    </label>
                    <input id="pos_retail_line_disc_reason" type="text"
                           class="form-control"
                           placeholder="e.g. Clearance, damaged pack, loyal customer"
                           t-model="state.reason"/>
                </div>

                <!-- Apply to all products checkbox -->
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" id="pos_retail_apply_all_check"
                           t-model="state.applyToAll"/>
                    <label class="form-check-label small fw-semibold" for="pos_retail_apply_all_check">
                        Apply this discount to ALL products in cart (checks each minimum price independently)
                    </label>
                </div>

            </div>

            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">
                    Cancel
                </button>
                <button class="btn"
                        t-att-class="isBelowMinimum ? 'btn-warning' : 'btn-primary'"
                        t-on-click="() => this.confirm()">
                    <t t-if="isBelowMinimum and canManagerOverride">
                        <i class="fa fa-lock me-1"/>Manager Approve &amp; Apply
                    </t>
                    <t t-else="">
                        <i class="fa fa-check me-1"/>Apply Discount
                    </t>
                </button>
            </t>
        </Dialog>
    </t>

</templates>
