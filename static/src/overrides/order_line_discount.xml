<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Clear, touch-friendly Discount and Price action buttons on each cart line -->
    <t t-name="pos_retail.OrderlineDiscountButton" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-name')]" position="inside">
            <div t-if="line.qty &gt; 0 and !line.refunded_orderline_id and !line.isGlobalDiscountLine?.()"
                 class="pos-retail-line-actions d-inline-flex align-items-center gap-1 ms-2">
                <button t-if="props.onDiscount"
                        class="pos-retail-line-disc-btn btn btn-sm py-0 px-2"
                        t-att-class="line.discount ? 'btn-warning text-dark fw-bold' : 'btn-outline-secondary'"
                        style="font-size: 0.72rem; line-height: 1.4; border-radius: 4px;"
                        title="Apply Discount (% or Amount or Target Price)"
                        t-on-pointerdown.stop="() => {}"
                        t-on-pointerup.stop="() => {}"
                        t-on-click.stop="() => props.onDiscount(line, 'discount')">
                    <i class="fa fa-percent me-1"/>
                    <t t-if="line.discount"><t t-esc="line.discount"/>%</t>
                    <t t-else="">Discount</t>
                </button>
                <button t-if="props.onDiscount"
                        class="pos-retail-line-price-btn btn btn-sm btn-outline-primary py-0 px-2"
                        style="font-size: 0.72rem; line-height: 1.4; border-radius: 4px;"
                        title="Set Selling Price directly"
                        t-on-pointerdown.stop="() => {}"
                        t-on-pointerup.stop="() => {}"
                        t-on-click.stop="() => props.onDiscount(line, 'price')">
                    <i class="fa fa-tag me-1"/>Price
                </button>
            </div>
        </xpath>

        <!-- Enhance the discount display line to show % and amount off -->
        <xpath expr="//li[@t-if='vals.discount']" position="replace">
            <li t-if="vals.discount" class="price-per-unit text-danger fw-semibold">
                <i class="fa fa-tag pe-1"/>Discount: <t t-esc="vals.discount"/>% (-<t t-esc="this.posRetailDiscountAmount(line)"/>)
                <span class="text-muted fw-normal ms-1">| Original: <t t-esc="vals.noDiscountPrice"/></span>
            </li>
        </xpath>
    </t>

    <!-- Pass onDiscount callback from OrderSummary to Orderline -->
    <t t-name="pos_retail.OrderSummaryLineDiscount" t-inherit="point_of_sale.OrderSummary" t-inherit-mode="extension">
        <xpath expr="//Orderline" position="attributes">
            <attribute name="onDiscount">(line, mode) => this.posRetailOpenLineDiscount(line, mode)</attribute>
            <attribute name="onSetPrice">(line) => this.posRetailOpenLineDiscount(line, 'price')</attribute>
        </xpath>
    </t>

</templates>
