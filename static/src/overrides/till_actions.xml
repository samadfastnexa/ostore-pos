<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Counter Actions in POS Actions Dialog:
         - Stock & Inventory (Show all stocks & adjust on the spot)
         - Make Quotation (Save current cart as a quotation)
         - Quotation History (View, load to cart, print quotes)
         - Today's Sales (Register summary)
         - Print Label (Thermal barcode shelf tag) -->
    <t t-name="pos_retail.TillActions" t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <!-- 1. Stock & Inventory: Show all stock & adjust -->
            <button t-if="posRetailCanAdjustStock"
                    class="btn btn-secondary btn-lg py-4 pos-retail-action-btn pos-retail-action-stock"
                    t-on-click="() => this.onClickStockInventory()">
                <div class="d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="fa fa-cubes fa-2x mb-1 text-primary"/>
                    <span class="fw-bold fs-6">Stock &amp; Inventory</span>
                    <span class="small text-muted" style="font-size: 0.72rem;">Show All &amp; Adjust</span>
                </div>
            </button>

            <!-- 2. Make Quotation from Cart -->
            <button class="btn btn-secondary btn-lg py-4 pos-retail-action-btn pos-retail-action-make-quote"
                    t-on-click="() => this.onClickMakeQuotation()">
                <div class="d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="fa fa-file-text-o fa-2x mb-1 text-success"/>
                    <span class="fw-bold fs-6" t-esc="posRetailEditingQuoteName ? 'Update Quote' : 'Make Quotation'"/>
                    <span t-if="posRetailEditingQuoteName" class="badge bg-primary-subtle text-primary font-monospace mt-1" style="font-size: 0.72rem;" t-esc="posRetailEditingQuoteName"/>
                    <span t-else="" class="small text-muted" style="font-size: 0.72rem;">Save Cart as Quote</span>
                </div>
            </button>

            <!-- 3. Quotation History: View, Settle & Print -->
            <button class="btn btn-secondary btn-lg py-4 pos-retail-action-btn pos-retail-action-quote-history"
                    t-on-click="() => this.onClickQuotationHistory()">
                <div class="d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="fa fa-history fa-2x mb-1 text-info"/>
                    <span class="fw-bold fs-6">Quotation History</span>
                    <span class="small text-muted" style="font-size: 0.72rem;">View &amp; Settle Quotes</span>
                </div>
            </button>

            <!-- 4. Today's Takings / Daily Sales -->
            <button t-if="posRetailCanSeeDailySales"
                    class="btn btn-secondary btn-lg py-4 pos-retail-action-btn pos-retail-daily-btn"
                    t-on-click="() => this.onClickDailySales()">
                <div class="d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="fa fa-line-chart fa-2x mb-1 text-warning"/>
                    <span class="fw-bold fs-6">Today's Sales</span>
                    <span class="small text-muted" style="font-size: 0.72rem;">Day Takings Summary</span>
                </div>
            </button>

            <!-- 5. Print Barcode Label -->
            <button class="btn btn-secondary btn-lg py-4 pos-retail-action-btn pos-retail-label-btn"
                    t-on-click="() => this.onClickPrintThermalLabel()">
                <div class="d-flex flex-column align-items-center justify-content-center text-center">
                    <i class="fa fa-barcode fa-2x mb-1 text-secondary"/>
                    <span class="fw-bold fs-6">Print Label</span>
                    <span class="small text-muted" style="font-size: 0.72rem;">Thermal Shelf Tag</span>
                </div>
            </button>
        </xpath>
    </t>

</templates>
