<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Inject Download PDF and Share on WhatsApp buttons into the list
         view's control panel, visible only when records are selected and
         the model has reports registered. -->
    <t t-name="pos_retail.BulkActions" t-inherit="web.ListView.Buttons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_list_buttons')]" position="inside">
            <t t-if="this.posRetailReportConfig and this.posRetailSelectedIds.length">
                <button class="btn btn-light pos-retail-bulk-action ms-1"
                        t-on-click="() => this.posRetailDownloadPdf()">
                    <i class="fa fa-file-pdf-o me-1"/>Download PDF
                </button>
                <button class="btn btn-light pos-retail-bulk-action ms-1"
                        t-on-click="() => this.posRetailShareWhatsApp()">
                    <i class="fa fa-whatsapp me-1"/>WhatsApp
                </button>
            </t>
        </xpath>
    </t>

</templates>
