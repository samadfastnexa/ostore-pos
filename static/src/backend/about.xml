<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- White-label the Settings > About block.
         The product name is our own, but the attribution line stays: Odoo
         Community is LGPLv3, which requires the copyright notice and the
         licence notice to be preserved in derivative works (GPLv3 s5/s7b,
         incorporated by LGPLv3). Rebranding the trademark is fine; dropping
         the copyright is not. Keep this line if the About block is ever
         restyled again. -->
    <t t-name="pos_retail.AboutBranding" t-inherit="res_config_edition" t-inherit-mode="extension">
        <xpath expr="//h3" position="replace">
            <h3 class="px-0">OStore Retail POS</h3>
            <div class="fw-bold" style="color:#7c3aed;">Powered by Zipnix Technology</div>
        </xpath>
        <xpath expr="//small" position="replace">
            <small>
                Built on Odoo <t t-esc="serverVersion"/> Community Edition,
                Copyright © Odoo S.A., licensed under
                <a id="license" target="_blank" href="http://www.gnu.org/licenses/lgpl.html"
                   style="text-decoration: underline;">GNU LGPL v3</a>.
            </small>
        </xpath>
    </t>

</templates>
