<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_retail.Sidebar">
        <aside class="pos-retail-side" t-att-class="{ 'pos-retail-side--collapsed': state.collapsed }">

            <div class="pos-retail-side__brand">
                <span class="pos-retail-side__mark">O</span>
                <span class="pos-retail-side__brandname">OStore</span>
                <button class="pos-retail-side__toggle"
                        t-att-title="state.collapsed ? 'Expand menu' : 'Collapse menu'"
                        t-on-click="() => this.toggle()">
                    <i class="fa" t-att-class="state.collapsed ? 'fa-angle-double-right' : 'fa-angle-double-left'"/>
                </button>
            </div>

            <!-- Menu search. Hidden while collapsed: there is no room for a
                 field, and the icon rail is for jumping between apps. -->
            <div t-if="!state.collapsed" class="pos-retail-side__search">
                <i class="fa fa-search pos-retail-side__search-icon"/>
                <input type="text" class="pos-retail-side__search-input"
                       placeholder="Search menu..."
                       aria-label="Search menu"
                       t-model="state.query"
                       t-on-keydown="onSearchKeydown"/>
                <button t-if="isSearching" class="pos-retail-side__search-clear"
                        title="Clear" aria-label="Clear search"
                        t-on-click="() => this.clearSearch()">
                    <i class="fa fa-times"/>
                </button>
            </div>

            <!-- Results replace the app list rather than filtering in place.
                 A tree with most branches hidden still reads as a tree, and
                 the user has to work out why things moved; a flat list of
                 "App / Section / Item" answers the question directly. -->
            <nav t-if="isSearching" class="pos-retail-side__nav pos-retail-side__results">
                <t t-if="!searchResults.length">
                    <div class="pos-retail-side__noresult">
                        No menu matches "<t t-esc="state.query"/>"
                    </div>
                </t>
                <t t-foreach="searchResults" t-as="result" t-key="result.id">
                    <button class="pos-retail-side__result"
                            t-att-title="(result.parents ? result.parents + ' / ' : '') + result.label"
                            t-on-click="() => this.openResult(result)">
                        <span class="pos-retail-side__result-name" t-esc="result.label"/>
                        <span t-if="result.parents" class="pos-retail-side__result-path"
                              t-esc="result.parents"/>
                    </button>
                </t>
            </nav>

            <nav t-if="!isSearching" class="pos-retail-side__nav">
                <t t-foreach="apps" t-as="app" t-key="app.id">
                <!-- Each app is one block; the OPEN app's block becomes an
                     inset panel so its sections/items read as contents of
                     that app, clearly set apart from the other app rows. -->
                <div class="pos-retail-side__block"
                     t-att-class="{ 'is-open': isCurrentApp(app) and !state.collapsed }">

                    <button class="pos-retail-side__app"
                            t-att-class="{ 'is-active': isCurrentApp(app) }"
                            t-att-title="app.name"
                            t-on-click="() => this.onClickMenu(app)">
                        <img t-if="app.webIconData" class="pos-retail-side__icon"
                             t-att-src="app.webIconData" alt=""/>
                        <span t-else="" class="pos-retail-side__icon pos-retail-side__icon--fallback">
                            <i class="fa fa-th-large"/>
                        </span>
                        <span class="pos-retail-side__text" t-esc="app.name"/>
                    </button>

                    <!-- Sections of the app you are currently in. A menu that
                         groups other menus becomes a collapsible section
                         header; a grouping menu INSIDE a section becomes a
                         sub-group label with its own (deeper) items, so
                         third-level menus stay reachable. -->
                    <t t-if="isCurrentApp(app) and !state.collapsed">
                        <t t-foreach="sections" t-as="section" t-key="section.id">
                            <t t-if="hasChildren(section)">
                                <button class="pos-retail-side__group"
                                        t-att-class="{ 'is-open': isSectionOpen(section) }"
                                        t-att-title="section.name"
                                        t-on-click="() => this.toggleSection(section)">
                                    <i class="fa pos-retail-side__chev"
                                       t-att-class="isSectionOpen(section) ? 'fa-chevron-down' : 'fa-chevron-right'"/>
                                    <span class="pos-retail-side__text" t-esc="section.name"/>
                                </button>
                                <t t-if="isSectionOpen(section)">
                                    <!-- Guide-rail block: the open section's
                                         items live in one indented container
                                         with a vertical line, so their nesting
                                         under the header is visually explicit. -->
                                    <div class="pos-retail-side__items">
                                        <t t-foreach="section.childrenTree" t-as="child" t-key="child.id">
                                            <t t-if="hasChildren(child)">
                                                <div class="pos-retail-side__subgroup" t-esc="child.name"/>
                                                <t t-foreach="child.childrenTree" t-as="leaf" t-key="leaf.id">
                                                    <button class="pos-retail-side__item pos-retail-side__item--sub"
                                                            t-att-class="{ 'is-active': isActive(leaf) }"
                                                            t-att-title="leaf.name"
                                                            t-on-click="() => this.onClickMenu(leaf)"
                                                            t-esc="leaf.name"/>
                                                </t>
                                            </t>
                                            <button t-else="" class="pos-retail-side__item"
                                                    t-att-class="{ 'is-active': isActive(child) }"
                                                    t-att-title="child.name"
                                                    t-on-click="() => this.onClickMenu(child)"
                                                    t-esc="child.name"/>
                                        </t>
                                    </div>
                                </t>
                            </t>
                            <button t-else="" class="pos-retail-side__item pos-retail-side__item--top"
                                    t-att-class="{ 'is-active': isActive(section) }"
                                    t-att-title="section.name"
                                    t-on-click="() => this.onClickMenu(section)"
                                    t-esc="section.name"/>
                        </t>
                    </t>

                </div>
                </t>
            </nav>
        </aside>
    </t>

</templates>
