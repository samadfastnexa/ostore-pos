<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- A plain labelled button, not an icon: the person using it is at a
         counter with a queue, and an icon they have to guess at is one more
         thing standing between them and the till. -->
    <t t-name="pos_retail.BackToTill">
        <div class="o_menu_systray_item d-flex align-items-center px-2">
            <button type="button" class="btn btn-sm btn-primary" t-on-click="goBack">
                <i class="fa fa-shopping-basket me-1" aria-hidden="true"/>Back to Till
            </button>
        </div>
    </t>

</templates>
