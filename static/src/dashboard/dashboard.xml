<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_retail.Dashboard">
        <div class="o_pos_retail_dashboard">
        <div class="o_pos_retail_dashboard_scroll p-3">

            <!-- Header -->
            <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
                <h1 class="h4 mb-0">
                    <i class="fa fa-shopping-cart me-2"/>POS Dashboard
                    <i class="fa fa-info-circle text-muted ms-1" style="font-size:.85rem; cursor:help;"
                       role="img" aria-label="Info" title="Info"
                       data-tooltip="Purpose: at-a-glance sales, inventory and financial health for this store.
How to use: switch Today/Week/Month/Custom above to change the period; click any tile or table row to drill into the underlying records."/>
                    <small class="text-muted ms-2" t-if="state.data" t-esc="state.data.company_name"/>
                </h1>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-success" t-on-click="() => this.openRegister()">
                        <i class="fa fa-play me-1"/>Open Register
                    </button>
                    <div class="btn-group" role="group">
                        <button class="btn btn-sm"
                                t-att-class="state.period === 'today' ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.setPeriod('today')"><i class="fa fa-clock-o me-1"/>Today</button>
                        <button class="btn btn-sm"
                                t-att-class="state.period === 'week' ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.setPeriod('week')"><i class="fa fa-calendar-o me-1"/>Week</button>
                        <button class="btn btn-sm"
                                t-att-class="state.period === 'month' ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.setPeriod('month')"><i class="fa fa-calendar me-1"/>Month</button>
                        <button class="btn btn-sm"
                                t-att-class="state.period === 'custom' ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.toggleCustom()"><i class="fa fa-sliders me-1"/>Custom</button>
                    </div>
                    <div class="d-flex align-items-center gap-1" t-if="state.showCustom">
                        <input type="date" class="form-control form-control-sm" t-model="state.dateFrom"/>
                        <span class="text-muted">to</span>
                        <input type="date" class="form-control form-control-sm" t-model="state.dateTo"/>
                        <button class="btn btn-sm btn-primary" t-on-click="() => this.applyCustom()"><i class="fa fa-check me-1"/>Apply</button>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.refresh()">
                        <i class="fa fa-refresh"/>
                    </button>
                </div>
            </div>

            <t t-if="state.loading">
                <div class="row g-3 mb-1">
                    <t t-foreach="[1,2,3,4,5,6,7,8]" t-as="n" t-key="n">
                        <div class="col-6 col-md-3">
                            <div class="o_kpi_card o_skeleton"/>
                        </div>
                    </t>
                </div>
                <div class="row g-3 mt-0">
                    <div class="col-12 col-lg-8"><div class="o_dash_panel o_skeleton" style="height:240px;"/></div>
                    <div class="col-12 col-lg-4"><div class="o_dash_panel o_skeleton" style="height:240px;"/></div>
                </div>
            </t>

            <t t-else="">
                <!-- Negative stock alert banner -->
                <div class="alert alert-danger d-flex align-items-center justify-content-between py-2 px-3 mb-3"
                     t-if="state.data.kpis.negative_stock_count &gt; 0">
                    <span>
                        <i class="fa fa-exclamation-circle me-2"/>
                        <t t-esc="state.data.kpis.negative_stock_count"/>
                        product(s) sold below zero stock — inventory needs reconciliation.
                    </span>
                    <button class="btn btn-sm btn-outline-light border-danger text-danger" t-on-click="() => this.openNegativeStock()">
                        <i class="fa fa-search me-1"/>View details
                    </button>
                </div>
                <!-- KPI tiles -->
                <div class="row g-3 mb-1">
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_sales" t-on-click="() => this.openOrders([['state','in',['paid','done']]], 'Sales Orders')">
                            <i class="fa fa-money o_kpi_icon"/>
                            <div class="o_kpi_label"><t t-esc="periodLabel"/> Sales</div>
                            <div class="o_kpi_value" t-esc="money(state.data.kpis.sales)"/>
                            <div class="o_kpi_trend" t-att-class="trendClass(state.trend.sales_pct)">
                                <i class="fa" t-att-class="trendIcon(state.trend.sales_pct)"/>
                                <t t-esc="trendLabel(state.trend.sales_pct)"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_txn">
                            <i class="fa fa-shopping-basket o_kpi_icon"/>
                            <div class="o_kpi_label">Transactions</div>
                            <div class="o_kpi_value" t-esc="state.data.kpis.transactions"/>
                            <div class="o_kpi_trend" t-att-class="trendClass(state.trend.transactions_pct)">
                                <i class="fa" t-att-class="trendIcon(state.trend.transactions_pct)"/>
                                <t t-esc="trendLabel(state.trend.transactions_pct)"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_basket">
                            <i class="fa fa-calculator o_kpi_icon"/>
                            <div class="o_kpi_label">Avg. Basket</div>
                            <div class="o_kpi_value" t-esc="money(state.data.kpis.avg_basket)"/>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_profit">
                            <i class="fa fa-line-chart o_kpi_icon"/>
                            <div class="o_kpi_label">Gross Profit</div>
                            <div class="o_kpi_value" t-esc="money(state.data.kpis.gross_profit)"/>
                            <div class="o_kpi_sub" t-esc="state.data.kpis.margin_pct.toFixed(1) + '% margin'"/>
                            <div class="o_kpi_trend" t-att-class="trendClass(state.trend.gross_profit_pct)">
                                <i class="fa" t-att-class="trendIcon(state.trend.gross_profit_pct)"/>
                                <t t-esc="trendLabel(state.trend.gross_profit_pct)"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_cash">
                            <i class="fa fa-inbox o_kpi_icon"/>
                            <div class="o_kpi_label">Cash in Drawer</div>
                            <div class="o_kpi_value" t-esc="money(state.data.kpis.cash_in_drawer)"/>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_shifts">
                            <i class="fa fa-clock-o o_kpi_icon"/>
                            <div class="o_kpi_label">Open Shifts</div>
                            <div class="o_kpi_value" t-esc="state.data.kpis.open_sessions"/>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_cust">
                            <i class="fa fa-users o_kpi_icon"/>
                            <div class="o_kpi_label">Customers</div>
                            <div class="o_kpi_value" t-esc="state.data.kpis.customers"/>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_refund" t-on-click="() => this.openOrders([['amount_total','&lt;',0],['state','in',['paid','done']]], 'Refunds')">
                            <i class="fa fa-undo o_kpi_icon"/>
                            <div class="o_kpi_label">Refunds</div>
                            <div class="o_kpi_value" t-esc="money(state.data.refunds.amount)"/>
                            <div class="o_kpi_sub" t-esc="state.data.refunds.count + ' order(s)'"/>
                        </div>
                    </div>
                </div>

                <!-- Financial detail tiles -->
                <div class="row g-3 mt-0 mb-1">
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_netsales">
                            <i class="fa fa-usd o_kpi_icon"/>
                            <div class="o_kpi_label">Net Sales</div>
                            <div class="o_kpi_value" t-esc="money(state.data.kpis.net_sales)"/>
                            <div class="o_kpi_sub">excl. tax</div>
                            <div class="o_kpi_trend" t-att-class="trendClass(state.trend.net_sales_pct)">
                                <i class="fa" t-att-class="trendIcon(state.trend.net_sales_pct)"/>
                                <t t-esc="trendLabel(state.trend.net_sales_pct)"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_cogs">
                            <i class="fa fa-cubes o_kpi_icon"/>
                            <div class="o_kpi_label">Cost of Goods Sold</div>
                            <div class="o_kpi_value" t-esc="money(state.data.kpis.cogs)"/>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_tax">
                            <i class="fa fa-percent o_kpi_icon"/>
                            <div class="o_kpi_label">Taxes Collected</div>
                            <div class="o_kpi_value" t-esc="money(state.data.kpis.taxes_collected)"/>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_discount">
                            <i class="fa fa-tag o_kpi_icon"/>
                            <div class="o_kpi_label">Discounts Given</div>
                            <div class="o_kpi_value" t-esc="money(state.data.kpis.discounts_given)"/>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_expense"
                             t-on-click="() => this.openExpenses([['date','=', this.today]], 'Expenses Today')">
                            <i class="fa fa-credit-card o_kpi_icon"/>
                            <div class="o_kpi_label">Expenses Today</div>
                            <div class="o_kpi_value" t-esc="money(state.data.kpis.expenses_today)"/>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="o_kpi_card o_kpi_expense"
                             t-on-click="() => this.openExpenses([['date','&gt;=', this.today.slice(0, 8) + '01']], 'Expenses This Month')">
                            <i class="fa fa-credit-card o_kpi_icon"/>
                            <div class="o_kpi_label">Expenses This Month</div>
                            <div class="o_kpi_value" t-esc="money(state.data.kpis.expenses_month)"/>
                        </div>
                    </div>
                </div>

                <!-- Inventory snapshot -->
                <div class="row g-3 mt-0 mb-1">
                    <div class="col-12">
                        <div class="o_dash_panel">
                            <div class="o_dash_panel_title">Inventory snapshot</div>
                            <div class="o_inv_grid">
                                <div class="o_inv_stat">
                                    <div class="o_inv_stat_value" t-esc="state.data.kpis.total_products"/>
                                    <div class="o_inv_stat_label">Products in POS</div>
                                </div>
                                <div class="o_inv_stat">
                                    <div class="o_inv_stat_value" t-esc="state.data.kpis.total_stock_qty"/>
                                    <div class="o_inv_stat_label">Total stock qty</div>
                                </div>
                                <div class="o_inv_stat">
                                    <div class="o_inv_stat_value" t-esc="money(state.data.kpis.inventory_value_cost)"/>
                                    <div class="o_inv_stat_label">Value @ cost</div>
                                </div>
                                <div class="o_inv_stat">
                                    <div class="o_inv_stat_value" t-esc="money(state.data.kpis.inventory_value_selling)"/>
                                    <div class="o_inv_stat_label">Value @ selling price</div>
                                </div>
                                <div class="o_inv_stat"
                                     t-att-class="state.data.kpis.out_of_stock_count > 0 ? 'o_status_serious' : ''">
                                    <div class="o_inv_stat_value" t-esc="state.data.kpis.out_of_stock_count"/>
                                    <div class="o_inv_stat_label">Out of stock</div>
                                </div>
                                <div class="o_inv_stat o_click_row"
                                     t-att-class="state.data.kpis.negative_stock_count > 0 ? 'o_status_critical' : ''"
                                     t-on-click="() => this.openNegativeStock()">
                                    <div class="o_inv_stat_value" t-esc="state.data.kpis.negative_stock_count"/>
                                    <div class="o_inv_stat_label">Negative stock</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stock movement, losses and turnover -->
                <div class="row g-3 mt-0 mb-1">
                    <div class="col-12">
                        <div class="o_dash_panel">
                            <div class="o_dash_panel_title">Stock movement and losses</div>
                            <div class="o_inv_grid">
                                <div class="o_inv_stat">
                                    <div class="o_inv_stat_value" t-esc="money(state.data.kpis.stock_in_value_today)"/>
                                    <div class="o_inv_stat_label">
                                        Stock in today
                                        <span class="o_inv_stat_sub" t-esc="qtyLabel(state.data.kpis.stock_in_qty_today)"/>
                                    </div>
                                </div>
                                <div class="o_inv_stat">
                                    <div class="o_inv_stat_value" t-esc="money(state.data.kpis.stock_out_value_today)"/>
                                    <div class="o_inv_stat_label">
                                        Stock out today
                                        <span class="o_inv_stat_sub" t-esc="qtyLabel(state.data.kpis.stock_out_qty_today)"/>
                                    </div>
                                </div>
                                <div class="o_inv_stat"
                                     t-att-class="state.data.kpis.damaged_value > 0 ? 'o_status_warning' : ''">
                                    <div class="o_inv_stat_value" t-esc="money(state.data.kpis.damaged_value)"/>
                                    <div class="o_inv_stat_label">
                                        Damaged (scrapped)
                                        <span class="o_inv_stat_sub" t-esc="qtyLabel(state.data.kpis.damaged_qty)"/>
                                    </div>
                                </div>
                                <div class="o_inv_stat"
                                     t-att-class="state.data.kpis.expired_value > 0 ? 'o_status_serious' : ''">
                                    <div class="o_inv_stat_value" t-esc="money(state.data.kpis.expired_value)"/>
                                    <div class="o_inv_stat_label">
                                        Expired stock
                                        <span class="o_inv_stat_sub"
                                              t-esc="state.data.kpis.expired_lot_count + ' lot(s)'"/>
                                    </div>
                                </div>
                                <div class="o_inv_stat"
                                     t-att-class="state.data.kpis.dead_stock_value > 0 ? 'o_status_warning' : ''">
                                    <div class="o_inv_stat_value" t-esc="money(state.data.kpis.dead_stock_value)"/>
                                    <div class="o_inv_stat_label">
                                        Dead stock
                                        <span class="o_inv_stat_sub"
                                              t-esc="state.data.kpis.dead_stock_count + ' product(s)'"/>
                                    </div>
                                </div>
                                <div class="o_inv_stat">
                                    <div class="o_inv_stat_value" t-esc="turnoverLabel"/>
                                    <div class="o_inv_stat_label">
                                        Stock turnover
                                        <span class="o_inv_stat_sub">cost of sales vs stock value</span>
                                    </div>
                                </div>
                                <div class="o_inv_stat">
                                    <div class="o_inv_stat_value" t-esc="money(state.data.kpis.reorder_cost)"/>
                                    <div class="o_inv_stat_label">
                                        Expected reorder cost
                                        <span class="o_inv_stat_sub"
                                              t-esc="state.data.kpis.reorder_product_count + ' product(s)'"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- What moves, what does not -->
                <div class="row g-3 mt-0 mb-1">
                    <div class="col-12 col-lg-4">
                        <div class="o_dash_panel h-100">
                            <div class="o_dash_panel_title">Fast moving</div>
                            <t t-if="!state.data.fast_movers.length">
                                <div class="o_empty">No sales in this period.</div>
                            </t>
                            <t t-else="">
                                <div t-foreach="state.data.fast_movers" t-as="row" t-key="row.product_id"
                                     class="o_list_row">
                                    <span class="o_list_name" t-esc="row.name"/>
                                    <span class="o_list_value">
                                        <t t-esc="row.qty_sold"/> sold
                                    </span>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="o_dash_panel h-100">
                            <div class="o_dash_panel_title">Slow moving</div>
                            <t t-if="!state.data.slow_movers.length">
                                <div class="o_empty">No sales in this period.</div>
                            </t>
                            <t t-else="">
                                <div t-foreach="state.data.slow_movers" t-as="row" t-key="row.product_id"
                                     class="o_list_row">
                                    <span class="o_list_name" t-esc="row.name"/>
                                    <span class="o_list_value">
                                        <t t-esc="row.qty_sold"/> sold
                                    </span>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="o_dash_panel h-100">
                            <div class="o_dash_panel_title">
                                Dead stock
                                <span class="o_dash_panel_hint">in stock, nothing sold</span>
                            </div>
                            <t t-if="!state.data.dead_stock.length">
                                <div class="o_empty">Everything on the shelf sold at least once.</div>
                            </t>
                            <t t-else="">
                                <div t-foreach="state.data.dead_stock" t-as="row" t-key="row.product_id"
                                     class="o_list_row">
                                    <span class="o_list_name" t-esc="row.name"/>
                                    <span class="o_list_value" t-esc="money(row.stock_value)"/>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-0">
                    <!-- Sales trend -->
                    <div class="col-12 col-lg-8">
                        <div class="o_dash_panel h-100">
                            <div class="o_dash_panel_title">Sales — last 30 days</div>
                            <svg class="o_sales_chart" viewBox="0 0 720 200" preserveAspectRatio="none">
                                <line x1="0" t-att-y1="chart.baseline" x2="720" t-att-y2="chart.baseline" class="o_chart_axis"/>
                                <t t-foreach="chart.bars" t-as="bar" t-key="bar.date">
                                    <rect class="o_chart_bar" t-att-x="bar.x" t-att-y="bar.y"
                                          t-att-width="bar.w" t-att-height="bar.h" rx="1.5">
                                        <title t-esc="bar.label + ': ' + money(bar.total)"/>
                                    </rect>
                                </t>
                            </svg>
                            <div class="o_chart_caption text-muted">Peak day: <span t-esc="money(chart.max)"/></div>
                        </div>
                    </div>

                    <!-- Payment breakdown -->
                    <div class="col-12 col-lg-4">
                        <div class="o_dash_panel h-100">
                            <div class="o_dash_panel_title">Payment methods</div>
                            <t t-if="!payments.length">
                                <div class="o_empty">No payments in this period.</div>
                            </t>
                            <t t-else="">
                                <div t-foreach="payments" t-as="p" t-key="p.name" class="o_pay_row">
                                    <div class="d-flex justify-content-between">
                                        <span><span class="o_swatch" t-attf-style="background:{{p.color}}"/><t t-esc="p.name"/></span>
                                        <span class="font-monospace" t-esc="money(p.amount)"/>
                                    </div>
                                    <div class="o_pay_track">
                                        <div class="o_pay_fill" t-attf-style="width:{{p.pct}}%;background:{{p.color}}"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Low stock -->
                    <div class="col-12 col-lg-6">
                        <div class="o_dash_panel h-100">
                            <div class="o_dash_panel_title">
                                <i class="fa fa-exclamation-triangle text-warning me-1"/>Low stock alerts
                            </div>
                            <t t-if="!state.data.low_stock.length">
                                <div class="o_empty">All products above their reorder level. 👍</div>
                            </t>
                            <table t-else="" class="table table-sm align-middle mb-0">
                                <thead><tr><th>Product</th><th class="text-end">On hand</th><th class="text-end">Min</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="state.data.low_stock" t-as="s" t-key="s.product_id"
                                        class="o_click_row" t-on-click="() => this.openProduct(s.product_id)">
                                        <td t-esc="s.name"/>
                                        <td class="text-end o_status_serious fw-bold" t-esc="s.on_hand"/>
                                        <td class="text-end text-muted" t-esc="s.min"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Expiring soon -->
                    <div class="col-12 col-lg-6">
                        <div class="o_dash_panel h-100">
                            <div class="o_dash_panel_title">
                                <i class="fa fa-clock-o text-danger me-1"/>Expiring soon (30 days)
                            </div>
                            <t t-if="!state.data.expiring_soon.length">
                                <div class="o_empty">No lots expiring in the next 30 days.</div>
                            </t>
                            <table t-else="" class="table table-sm align-middle mb-0">
                                <thead><tr><th>Product</th><th>Lot</th><th class="text-end">Expires</th><th class="text-end">Days</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="state.data.expiring_soon" t-as="e" t-key="e.lot">
                                        <td t-esc="e.name"/>
                                        <td class="text-muted" t-esc="e.lot"/>
                                        <td class="text-end" t-esc="e.expiration_date"/>
                                        <td class="text-end fw-bold" t-att-class="expiryClass(e.days_left)" t-esc="e.days_left"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Top products -->
                    <div class="col-12">
                        <div class="o_dash_panel">
                            <div class="o_dash_panel_title">Top selling products — <t t-esc="periodLabel"/></div>
                            <t t-if="!state.data.top_products.length">
                                <div class="o_empty">No sales yet in this period.</div>
                            </t>
                            <table t-else="" class="table table-sm align-middle mb-0">
                                <thead><tr><th style="width:3rem">#</th><th>Product</th><th class="text-end">Qty sold</th><th class="text-end">Revenue</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="state.data.top_products" t-as="p" t-key="p.product_id"
                                        class="o_click_row" t-on-click="() => this.openProduct(p.product_id)">
                                        <td class="text-muted" t-esc="p_index + 1"/>
                                        <td t-esc="p.name"/>
                                        <td class="text-end" t-esc="p.qty"/>
                                        <td class="text-end" t-esc="money(p.revenue)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Sales by cashier -->
                    <div class="col-12 col-lg-6">
                        <div class="o_dash_panel h-100">
                            <div class="o_dash_panel_title">Sales by cashier — <t t-esc="periodLabel"/></div>
                            <t t-if="!state.data.sales_by_cashier.length">
                                <div class="o_empty">No cashier sales yet in this period.</div>
                            </t>
                            <table t-else="" class="table table-sm align-middle mb-0">
                                <thead><tr><th>Cashier</th><th class="text-end">Transactions</th><th class="text-end">Sales</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="state.data.sales_by_cashier" t-as="c" t-key="c.employee_id"
                                        class="o_click_row" t-on-click="() => this.openCashier(c.employee_id, c.name)">
                                        <td t-esc="c.name"/>
                                        <td class="text-end" t-esc="c.transactions"/>
                                        <td class="text-end" t-esc="money(c.sales)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Top customers -->
                    <div class="col-12 col-lg-6">
                        <div class="o_dash_panel h-100">
                            <div class="o_dash_panel_title">Top customers — <t t-esc="periodLabel"/></div>
                            <t t-if="!state.data.top_customers.length">
                                <div class="o_empty">No customer-linked sales yet in this period.</div>
                            </t>
                            <table t-else="" class="table table-sm align-middle mb-0">
                                <thead><tr><th>Customer</th><th class="text-end">Transactions</th><th class="text-end">Sales</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="state.data.top_customers" t-as="c" t-key="c.partner_id"
                                        class="o_click_row" t-on-click="() => this.openCustomer(c.partner_id, c.name)">
                                        <td t-esc="c.name"/>
                                        <td class="text-end" t-esc="c.transactions"/>
                                        <td class="text-end" t-esc="money(c.sales)"/>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </div>
        </div>
    </t>

</templates>
