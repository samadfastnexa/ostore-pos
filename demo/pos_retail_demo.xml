    <!-- ===================== Promotions / Offers ===================== -->

    <!-- Product discount: Coke 20% off -->
    <record id="promo_coke_20" model="loyalty.program">
        <field name="name">Coca-Cola 20% Off</field>
        <field name="program_type">promotion</field>
        <field name="trigger">auto</field>
        <field name="applies_on">current</field>
    </record>
    <record id="promo_coke_20_rule" model="loyalty.rule">
        <field name="program_id" ref="promo_coke_20"/>
        <field name="product_ids" eval="[(6, 0, [ref('prod_coke')])]"/>
        <field name="minimum_qty">1</field>
    </record>
    <record id="promo_coke_20_reward" model="loyalty.reward">
        <field name="program_id" ref="promo_coke_20"/>
        <field name="reward_type">discount</field>
        <field name="discount">20</field>
        <field name="discount_mode">percent</field>
        <field name="discount_applicability">specific</field>
        <field name="discount_product_ids" eval="[(6, 0, [ref('prod_coke')])]"/>
    </record>

    <!-- Order discount: 10% off over 5000 -->
    <record id="promo_order_10" model="loyalty.program">
        <field name="name">10% Off Orders Over 5000</field>
        <field name="program_type">promotion</field>
        <field name="trigger">auto</field>
        <field name="applies_on">current</field>
    </record>
    <record id="promo_order_10_rule" model="loyalty.rule">
