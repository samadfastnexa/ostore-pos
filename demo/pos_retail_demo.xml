<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Reproducible sample store. Loaded automatically on any demo/eval install
        of pos_retail, so every fresh database (and every sales demo) gets a
        realistic, ready-to-use retail shop. Production installs (no demo data)
        stay clean.
    -->

    <!-- ============================ Brands ============================ -->
    <record id="brand_nestle" model="product.brand"><field name="name">Nestle</field></record>
    <record id="brand_coca_cola" model="product.brand"><field name="name">Coca-Cola</field></record>
    <record id="brand_pepsi" model="product.brand"><field name="name">Pepsi</field></record>
    <record id="brand_olpers" model="product.brand"><field name="name">Olpers</field></record>
    <record id="brand_national" model="product.brand"><field name="name">National</field></record>

    <!-- ===================== Product categories ====================== -->
    <record id="categ_beverages" model="product.category">
        <field name="name">Beverages</field>
        <field name="parent_id" ref="product.product_category_goods"/>
    </record>
    <record id="categ_snacks" model="product.category">
        <field name="name">Snacks</field>
        <field name="parent_id" ref="product.product_category_goods"/>
    </record>
    <record id="categ_dairy" model="product.category">
        <field name="name">Dairy</field>
        <field name="parent_id" ref="product.product_category_goods"/>
    </record>
    <record id="categ_grocery" model="product.category">
        <field name="name">Grocery</field>
        <field name="parent_id" ref="product.product_category_goods"/>
    </record>
    <record id="categ_apparel" model="product.category">
        <field name="name">Apparel</field>
        <field name="parent_id" ref="product.product_category_goods"/>
    </record>

    <!-- ======================= POS categories ======================== -->
    <record id="poscat_beverages" model="pos.category"><field name="name">Beverages</field></record>
    <record id="poscat_snacks" model="pos.category"><field name="name">Snacks</field></record>
    <record id="poscat_dairy" model="pos.category"><field name="name">Dairy</field></record>
    <record id="poscat_grocery" model="pos.category"><field name="name">Grocery</field></record>
    <record id="poscat_apparel" model="pos.category"><field name="name">Apparel</field></record>

    <!-- ========================= Product tags ======================== -->
    <record id="tag_imported" model="product.tag"><field name="name">Imported</field><field name="color">1</field></record>
    <record id="tag_halal" model="product.tag"><field name="name">Halal</field><field name="color">10</field></record>
    <record id="tag_local" model="product.tag"><field name="name">Local</field><field name="color">4</field></record>

    <!-- ===================== Products (variants) ===================== -->
    <record id="prod_coke" model="product.product">
        <field name="name">Coca-Cola 500ml</field>
        <field name="default_code">COKE500</field>
        <field name="barcode">5449000000996</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="available_in_pos">True</field>
        <field name="list_price">80</field>
        <field name="standard_price">55</field>
        <field name="categ_id" ref="categ_beverages"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('poscat_beverages')])]"/>
        <field name="brand_id" ref="brand_coca_cola"/>
        <field name="product_tag_ids" eval="[(6, 0, [ref('tag_imported'), ref('tag_halal')])]"/>
    </record>

    <record id="prod_pepsi" model="product.product">
        <field name="name">Pepsi 500ml</field>
        <field name="default_code">PEPSI500</field>
        <field name="barcode">5410000110015</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="available_in_pos">True</field>
        <field name="list_price">75</field>
        <field name="standard_price">52</field>
        <field name="categ_id" ref="categ_beverages"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('poscat_beverages')])]"/>
        <field name="brand_id" ref="brand_pepsi"/>
        <field name="product_tag_ids" eval="[(6, 0, [ref('tag_imported'), ref('tag_halal')])]"/>
    </record>

    <record id="prod_water" model="product.product">
        <field name="name">Nestle Water 1.5L</field>
        <field name="default_code">WATER15</field>
        <field name="barcode">6001240000015</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="available_in_pos">True</field>
        <field name="list_price">60</field>
        <field name="standard_price">40</field>
        <field name="categ_id" ref="categ_beverages"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('poscat_beverages')])]"/>
        <field name="brand_id" ref="brand_nestle"/>
        <field name="product_tag_ids" eval="[(6, 0, [ref('tag_halal')])]"/>
    </record>

    <record id="prod_lays" model="product.product">
        <field name="name">Lays Classic Chips</field>
        <field name="default_code">LAYS-CL</field>
        <field name="barcode">8964000110022</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="available_in_pos">True</field>
        <field name="list_price">50</field>
        <field name="standard_price">33</field>
        <field name="categ_id" ref="categ_snacks"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('poscat_snacks')])]"/>
        <field name="product_tag_ids" eval="[(6, 0, [ref('tag_local'), ref('tag_halal')])]"/>
    </record>

    <record id="prod_masala" model="product.product">
        <field name="name">National Chicken Masala</field>
        <field name="default_code">NAT-MASALA</field>
        <field name="barcode">8964000220033</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="available_in_pos">True</field>
        <field name="list_price">120</field>
        <field name="standard_price">90</field>
        <field name="categ_id" ref="categ_grocery"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('poscat_grocery')])]"/>
        <field name="brand_id" ref="brand_national"/>
        <field name="product_tag_ids" eval="[(6, 0, [ref('tag_local'), ref('tag_halal')])]"/>
    </record>

    <record id="prod_sugar" model="product.product">
        <field name="name">Refined Sugar (per Kg)</field>
        <field name="default_code">SUGAR-KG</field>
        <field name="barcode">8964000330044</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="available_in_pos">True</field>
        <field name="list_price">140</field>
        <field name="standard_price">120</field>
        <field name="categ_id" ref="categ_grocery"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('poscat_grocery')])]"/>
        <field name="uom_id" ref="uom.product_uom_kgm"/>
        <field name="product_tag_ids" eval="[(6, 0, [ref('tag_local')])]"/>
    </record>

    <!-- Expiry-tracked product -->
    <record id="prod_milk" model="product.product">
        <field name="name">Olpers Milk 1L</field>
        <field name="default_code">OLPERS1L</field>
        <field name="barcode">8964000440055</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="available_in_pos">True</field>
        <field name="list_price">210</field>
        <field name="standard_price">180</field>
        <field name="categ_id" ref="categ_dairy"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('poscat_dairy')])]"/>
        <field name="brand_id" ref="brand_olpers"/>
        <field name="product_tag_ids" eval="[(6, 0, [ref('tag_local'), ref('tag_halal')])]"/>
        <field name="tracking">lot</field>
        <field name="use_expiration_date">True</field>
        <field name="expiration_time">15</field>
    </record>

    <!-- ================== Variant product (Apparel) ================== -->
    <record id="attr_size" model="product.attribute">
        <field name="name">Size</field>
        <field name="create_variant">always</field>
    </record>
    <record id="attr_size_s" model="product.attribute.value">
        <field name="name">S</field><field name="attribute_id" ref="attr_size"/>
    </record>
    <record id="attr_size_m" model="product.attribute.value">
        <field name="name">M</field><field name="attribute_id" ref="attr_size"/>
    </record>
    <record id="attr_size_l" model="product.attribute.value">
        <field name="name">L</field><field name="attribute_id" ref="attr_size"/>
    </record>
    <record id="prod_tshirt" model="product.template">
        <field name="name">Cotton T-Shirt</field>
        <field name="default_code">TSHIRT</field>
        <field name="type">consu</field>
        <field name="is_storable">True</field>
        <field name="available_in_pos">True</field>
        <field name="list_price">500</field>
        <field name="standard_price">300</field>
        <field name="categ_id" ref="categ_apparel"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('poscat_apparel')])]"/>
        <field name="attribute_line_ids" eval="[(0, 0, {
            'attribute_id': ref('attr_size'),
            'value_ids': [(6, 0, [ref('attr_size_s'), ref('attr_size_m'), ref('attr_size_l')])],
        })]"/>
    </record>

    <!-- ========================== Combo ============================== -->
    <record id="combo_drink" model="product.combo">
        <field name="name">Choose a Drink</field>
        <field name="combo_item_ids" eval="[
            (0, 0, {'product_id': ref('prod_coke')}),
            (0, 0, {'product_id': ref('prod_pepsi')}),
            (0, 0, {'product_id': ref('prod_water')}),
        ]"/>
    </record>
    <record id="combo_snack" model="product.combo">
        <field name="name">Choose a Snack</field>
        <field name="combo_item_ids" eval="[
            (0, 0, {'product_id': ref('prod_lays')}),
            (0, 0, {'product_id': ref('prod_masala')}),
        ]"/>
    </record>
    <record id="prod_combo" model="product.template">
        <field name="name">Snack + Drink Combo</field>
        <field name="default_code">COMBO1</field>
        <field name="type">combo</field>
        <field name="available_in_pos">True</field>
        <field name="list_price">120</field>
        <field name="combo_ids" eval="[(6, 0, [ref('combo_drink'), ref('combo_snack')])]"/>
    </record>

    <!-- ==================== Initial stock (quants) =================== -->
    <record id="stock_coke" model="stock.quant">
        <field name="product_id" ref="prod_coke"/>
        <field name="quantity">120</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>
    <record id="stock_pepsi" model="stock.quant">
        <field name="product_id" ref="prod_pepsi"/>
        <field name="quantity">90</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>
    <record id="stock_water" model="stock.quant">
        <field name="product_id" ref="prod_water"/>
        <field name="quantity">80</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>
    <record id="stock_lays" model="stock.quant">
        <field name="product_id" ref="prod_lays"/>
        <field name="quantity">200</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>
    <record id="stock_masala" model="stock.quant">
        <field name="product_id" ref="prod_masala"/>
        <field name="quantity">60</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>
    <record id="stock_sugar" model="stock.quant">
        <field name="product_id" ref="prod_sugar"/>
        <field name="quantity">50</field>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
    </record>

    <!-- ====================== Reorder rules ========================== -->
    <record id="op_coke" model="stock.warehouse.orderpoint">
        <field name="product_id" ref="prod_coke"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
        <field name="product_min_qty">20</field>
        <field name="product_max_qty">150</field>
    </record>
    <record id="op_lays" model="stock.warehouse.orderpoint">
        <field name="product_id" ref="prod_lays"/>
        <field name="warehouse_id" ref="stock.warehouse0"/>
        <field name="location_id" model="stock.location" eval="obj().env.ref('stock.warehouse0').lot_stock_id.id"/>
        <field name="product_min_qty">30</field>
        <field name="product_max_qty">250</field>
    </record>

