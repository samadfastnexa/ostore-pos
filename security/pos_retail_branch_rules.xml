<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

        <!-- Multi-company visibility for the two catalogue models Odoo ships
             without a company: without a rule the new company_id field would be
             a label only, since the back office would still list every branch's
             sections and brands to everyone. The domain is Odoo's own standard
             shape - a record with no branch is shared, otherwise it belongs to
             one of the branches the user may see. -->

        <record id="pos_category_branch_rule" model="ir.rule">
            <field name="name">POS Category: visible to its own branch</field>
            <field name="model_id" ref="point_of_sale.model_pos_category"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="product_brand_branch_rule" model="ir.rule">
            <field name="name">Product Brand: visible to its own branch</field>
            <field name="model_id" ref="model_product_brand"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="product_category_branch_rule" model="ir.rule">
            <field name="name">Product Category: visible to its own branch</field>
            <field name="model_id" ref="product.model_product_category"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Stop a branch inheriting its parent company's records.

             Odoo's own multi-company rules on these models are written with
             'parent_of', which lets a child company use anything an ancestor
             owns. That is right for a group of legal entities sharing a head
             office; it is wrong for two shops, where the whole point is that
             each one keeps its own catalogue and its own contacts. Measured on
             this database before these rules existed: ticking Branch 2 alone
             listed 912 products, its own 455 plus the parent's 455, every item
             twice; and a branch that owned nothing still showed the parent's
             2 vendors and 16 customers.

             Global rules on one model are ANDed, so these do not replace
             Odoo's; they intersect with them. The result is the stricter of
             the two, which means core keeps whatever else its rule protects
             and an Odoo upgrade cannot quietly undo this.

             Records with no company stay shared, exactly as before. -->

        <record id="res_partner_branch_rule" model="ir.rule">
            <field name="name">Contacts: visible to their own branch</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <!-- partner_share = False is carried over from Odoo's own rule on
                 purpose. Those are the internal contacts behind users and
                 employees; dropping the clause would hide staff records from
                 every branch and break user administration. -->
            <field name="domain_force">['|', '|', ('partner_share', '=', False), ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="product_template_branch_rule" model="ir.rule">
            <field name="name">Product: visible to its own branch</field>
            <field name="model_id" ref="product.model_product_template"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="product_supplierinfo_branch_rule" model="ir.rule">
            <field name="name">Vendor Pricelist: visible to its own branch</field>
            <field name="model_id" ref="product.model_product_supplierinfo"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="product_pricelist_branch_rule" model="ir.rule">
