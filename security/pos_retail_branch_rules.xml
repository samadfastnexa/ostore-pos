            <field name="model_id" ref="product.model_product_pricelist"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Expenses had NO record rule of any kind, which is this module's own
             omission rather than Odoo's: the model carries a company_id and
             nothing was enforcing it, so every branch could read every other
             branch's rent, salaries and electricity. -->
        <record id="pos_retail_expense_branch_rule" model="ir.rule">
            <field name="name">Expense: visible to its own branch</field>
            <field name="model_id" ref="model_pos_retail_expense"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <!-- ── Transactional models: replace core's parent_of rules ─────────

             Core's multi-company rules on these models use parent_of, which
             lets a child company see the parent's records.  That is wrong for
             shops that must be isolated from each other and from the holding
             company.  Global rules on the same model are ANDed, so adding a
             strict 'in company_ids' rule intersects with core's and tightens
             it, without removing whatever else core protects.

             Records with company_id = False remain shared (global).  Journals
             and accounts are deliberately excluded: branches share their
             parent's chart of accounts and journals. -->

        <record id="sale_order_branch_rule" model="ir.rule">
            <field name="name">Sale Order: visible to its own branch</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
