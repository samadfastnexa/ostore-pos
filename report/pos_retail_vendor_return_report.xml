<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vendor Return Note. The Goods Receipt Note's mirror image: instead of
         what came in and what it cost, this is what is going back out and
         what it is worth, the figure the Vendor Refunds report expects to
         eventually see matched by a credit note from the supplier. Ordered
         quantity has no place here (nothing was ordered back), so the table
         is simpler than the GRN's: what is returning, why, and its value. -->
    <template id="report_vendor_return_document">
        <t t-set="original" t-value="o.return_id"/>
        <t t-call="web.external_layout">
            <div class="page">
                <h2>Vendor Return Note <span t-esc="o.name"/></h2>

                <div class="row mt-3">
                    <div class="col-6">
                        <table class="table table-sm table-borderless">
                            <tr><td class="fw-bold">Return No.</td><td t-esc="o.name"/></tr>
                            <tr t-if="original"><td class="fw-bold">Original Goods Receipt</td><td t-esc="original.name"/></tr>
                            <tr t-if="original and original.purchase_id"><td class="fw-bold">Purchase Order</td><td t-esc="original.purchase_id.name"/></tr>
                            <tr t-if="o.origin"><td class="fw-bold">Source</td><td t-esc="o.origin"/></tr>
                            <tr><td class="fw-bold">Warehouse</td><td t-esc="o.picking_type_id.warehouse_id.name or ''"/></tr>
                        </table>
                    </div>
                    <div class="col-6">
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td class="fw-bold">Return Date</td>
                                <td><span t-esc="o.date_done or o.scheduled_date" t-options='{"widget": "datetime"}'/></td>
                            </tr>
                            <tr><td class="fw-bold">Returned By</td><td t-esc="o.user_id.name or ''"/></tr>
                            <tr t-if="o.pos_retail_vendor_return_reason_id">
                                <td class="fw-bold">Return Reason</td><td t-esc="o.pos_retail_vendor_return_reason_id.name"/>
                            </tr>
                            <tr><td class="fw-bold">Status</td><td t-esc="dict(o._fields['state'].selection).get(o.state, o.state)"/></tr>
                        </table>
                    </div>
                </div>

                <div class="mt-2" t-if="o.partner_id">
                    <strong>Vendor</strong>
                    <div t-esc="o.partner_id.name"/>
                    <div t-if="o.partner_id.vendor_contact_person">Contact: <t t-esc="o.partner_id.vendor_contact_person"/></div>
                    <div t-if="o.partner_id.phone">Tel: <t t-esc="o.partner_id.phone"/></div>
                    <div t-if="o.partner_id.email"><t t-esc="o.partner_id.email"/></div>
                </div>

                <t t-set="lines" t-value="o.move_ids.filtered(lambda m: m.product_uom_qty or m.quantity)"/>
                <t t-set="total_qty" t-value="sum(lines.mapped('quantity'))"/>
                <t t-set="total_value" t-value="0"/>
                <table class="table table-sm o_main_table mt-3">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>SKU</th>
                            <th>Barcode</th>
                            <th class="text-end">Qty Returned</th>
                            <th>UoM</th>
                            <th class="text-end">Unit Cost</th>
                            <th class="text-end">Total Value</th>
                            <th>Batch / Expiry</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="lines" t-as="move">
                            <!-- Unit cost from the original receipt's purchase line where one
                                 exists, so the value credited back matches what was actually
                                 paid for it rather than today's (possibly changed) cost. -->
                            <t t-set="orig_move" t-value="move.origin_returned_move_id"/>
                            <t t-set="pol" t-value="orig_move.purchase_line_id if orig_move else move.purchase_line_id"/>
                            <t t-set="unit_cost" t-value="pol.price_unit if pol else move.product_id.standard_price"/>
                            <t t-set="line_total" t-value="unit_cost * move.quantity"/>
                            <t t-set="total_value" t-value="total_value + line_total"/>
                            <td t-esc="move.product_id.display_name"/>
                            <td t-esc="move.product_id.default_code or ''"/>
                            <td t-esc="move.product_id.barcode or ''"/>
                            <td class="text-end" t-esc="move.quantity"/>
                            <td t-esc="move.product_uom.name or ''"/>
                            <td class="text-end">
                                <span t-esc="unit_cost" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                            </td>
                            <td class="text-end">
                                <span t-esc="line_total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                            </td>
                            <td>
                                <div t-foreach="move.move_line_ids.filtered(lambda ml: ml.lot_id)" t-as="ml">
                                    <span t-esc="ml.lot_id.name"/>
                                    <t t-if="ml.lot_id.expiration_date">
                                        (exp. <span t-esc="ml.lot_id.expiration_date" t-options='{"widget": "date"}'/>)
                                    </t>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <div class="row justify-content-end">
                    <div class="col-5">
                        <table class="table table-sm">
                            <tr><td>Total Products</td><td class="text-end" t-esc="len(lines)"/></tr>
                            <tr><td>Total Quantity Returned</td><td class="text-end" t-esc="total_qty"/></tr>
                            <tr class="fw-bold">
                                <td>Total Value Returned</td>
                                <td class="text-end">
                                    <span t-esc="total_value" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="pos-retail-pdf-rule mt-3"/>
                <div class="text-muted" style="font-size:85%;">
                    This note records goods physically leaving for the supplier. The
                    Total Value Returned above is expected, not yet posted: it becomes
                    an actual credit only once the supplier issues (or the shop records)
                    the matching vendor refund, which is what the Vendor Ledger and
                    Vendor Refunds report track.
                </div>

                <div class="row mt-5">
                    <div class="col-3">
                        <div style="border-top:1px solid #000; padding-top:4px; min-height:70px;">
                            <strong>Returned By</strong>
                            <div t-if="o.signature">
                                <img t-att-src="image_data_uri(o.signature)"
                                     style="max-height:2.5cm; max-width:100%;" alt="Signature"/>
                            </div>
                            <div t-esc="o.user_id.name or ''"/>
                        </div>
                    </div>
                    <div class="col-3">
                        <div style="border-top:1px solid #000; padding-top:4px; min-height:70px;">
                            <strong>Checked By</strong>
                        </div>
                    </div>
                    <div class="col-3">
                        <div style="border-top:1px solid #000; padding-top:4px; min-height:70px;">
                            <strong>Approved By</strong>
                        </div>
                    </div>
                    <div class="col-3">
                        <div style="border-top:1px solid #000; padding-top:4px; min-height:70px;">
                            <strong>Vendor Representative (Received)</strong>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_vendor_return">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="pos_retail.report_vendor_return_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_vendor_return" model="ir.actions.report">
        <field name="name">Vendor Return Note</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_retail.report_vendor_return</field>
        <field name="report_file">pos_retail.report_vendor_return</field>
        <field name="print_report_name">'Vendor Return Note - %s' % ((object.name or '').replace('/', '-'))</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="domain">[('pos_retail_is_vendor_return', '=', True)]</field>
    </record>

</odoo>
