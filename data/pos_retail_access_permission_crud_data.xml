    <record id="perm_sales_create" model="pos.retail.access.permission">
        <field name="name">Create Quotations &amp; Sales Orders</field>
        <field name="category">sales</field>
        <field name="sequence">30</field>
        <!-- Includes the native salesperson group: Odoo's quote-creation flow
             reads fields that core gates on that group at FIELD level, which
             no ACL row can cross. Verified empirically; a pure ACL slice
             cannot create a quotation at all. -->
        <field name="implied_ids" eval="[(6, 0, [ref('sales_team.group_sale_salesman')])]"/>
        <field name="description">Add and edit quotations and sales orders (their own documents). Odoo requires the salesperson access level to make quotes, so creating and editing come together here; deleting stays separate.</field>
    </record>
    <record id="access_perm_sales_create_order" model="ir.model.access">
        <field name="name">Permission Create Quotations &amp; Sales Orders: sale_order</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="group_id" ref="perm_sales_create_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="access_perm_sales_create_line" model="ir.model.access">
        <field name="name">Permission Create Quotations &amp; Sales Orders: sale_order_line</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="group_id" ref="perm_sales_create_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="perm_sales_edit" model="pos.retail.access.permission">
        <field name="name">Edit Quotations &amp; Sales Orders</field>
        <field name="category">sales</field>
        <field name="sequence">40</field>
        <!-- Same field-level core gate as the Create permission (see there):
             editing a quote recomputes the same salesperson-gated fields, so
             this also carries the native salesperson group and is effectively
             the same access level as Create. -->
        <field name="implied_ids" eval="[(6, 0, [ref('sales_team.group_sale_salesman')])]"/>
        <field name="description">Modify quotations and sales orders (their own documents). Odoo requires the salesperson access level for this, which also allows creating quotes; deleting stays separate.</field>
    </record>
    <record id="access_perm_sales_edit_order" model="ir.model.access">
        <field name="name">Permission Edit Quotations &amp; Sales Orders: sale_order</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="group_id" ref="perm_sales_edit_res_groups"/>
