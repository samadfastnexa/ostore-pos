    <record id="perm_products_price" model="pos.retail.access.permission">
        <field name="name">Change Sales Price on Existing Products</field>
        <field name="category">products</field>
        <field name="sequence">40</field>
        <field name="grants_price_edit" eval="True"/>
        <field name="description">Lift the Sales Price lock: members may change the Sales Price of a product that already exists. Pair with "Edit Products" to be usable. Anyone in a role WITHOUT this permission cannot change existing prices, no matter what other groups they hold.</field>
    </record>

    <record id="perm_products_cost" model="pos.retail.access.permission">
        <field name="name">Change Cost on Existing Products</field>
        <field name="category">products</field>
        <field name="sequence">50</field>
        <field name="grants_cost_edit" eval="True"/>
        <field name="description">Lift the Cost lock: members may change the Cost of a product that already exists. Automatic cost updates from stock valuation are never blocked, with or without this permission.</field>
    </record>

