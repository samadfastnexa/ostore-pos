<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- The predefined permission catalog. Every permission record here
         auto-creates its backing res.groups with the xmlid
         "<permission xmlid>_res_groups" (same noupdate flag); the separate
         ir.model.access records below reference those group xmlids directly.
         Access rows are deliberately standalone records, not nested commands:
         each gets its own xmlid, so uninstall removes them cleanly and the
         required "name" is explicit in the data instead of relying on the
         model's create() helper. Loaded before all views; the menus file
         references the group xmlids. -->

    <!-- ============ Products ============ -->

    <record id="perm_products_create" model="pos.retail.access.permission">
        <field name="name">Create Products</field>
        <field name="category">products</field>
        <field name="sequence">10</field>
        <field name="description">Add new products (with any starting price and cost), including their brand and vendor lines, and edit product details. Does not allow deleting products. The Sales Price and Cost of a product that already exists stay locked unless those permissions are also granted. Note: editing product details is included because Odoo's product creation itself writes to the product record; grant "Edit Products" instead for someone who should modify but never add.</field>
    </record>
    <record id="access_perm_products_create_template" model="ir.model.access">
        <field name="name">Permission Create Products: product.template</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="group_id" ref="perm_products_create_res_groups"/>
        <field name="perm_read" eval="True"/>
        <!-- Write is REQUIRED to create: the variant-creation step inside
             product.template.create() performs a write() on the template
             (orm/models.py, _inherits parent write). Verified empirically;
             a create-only ACL cannot add a product at all. -->
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="access_perm_products_create_product" model="ir.model.access">
        <field name="name">Permission Create Products: product.product</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="group_id" ref="perm_products_create_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="access_perm_products_create_supplierinfo" model="ir.model.access">
        <field name="name">Permission Create Products: product.supplierinfo</field>
        <field name="model_id" ref="product.model_product_supplierinfo"/>
