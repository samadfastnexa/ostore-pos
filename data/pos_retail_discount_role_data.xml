        <field name="max_percentage_discount">10.0</field>
        <field name="is_unlimited">False</field>
        <field name="can_approve">False</field>
    </record>

    <record id="discount_role_manager" model="pos.retail.discount.role">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="max_fixed_discount">0.0</field>
        <field name="max_percentage_discount">0.0</field>
        <field name="is_unlimited">True</field>
        <field name="can_approve">True</field>
    </record>

    <record id="discount_role_administrator" model="pos.retail.discount.role">
        <field name="name">Administrator</field>
        <field name="sequence">40</field>
        <field name="max_fixed_discount">0.0</field>
        <field name="max_percentage_discount">0.0</field>
        <field name="is_unlimited">True</field>
        <field name="can_approve">True</field>
    </record>

</odoo>
