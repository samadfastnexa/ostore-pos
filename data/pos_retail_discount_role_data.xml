<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="discount_role_cashier" model="pos.retail.discount.role">
        <field name="name">Cashier</field>
        <field name="sequence">10</field>
        <field name="max_fixed_discount">100.0</field>
        <field name="max_percentage_discount">5.0</field>
        <field name="is_unlimited">False</field>
        <field name="can_approve">False</field>
    </record>

    <record id="discount_role_senior_cashier" model="pos.retail.discount.role">
