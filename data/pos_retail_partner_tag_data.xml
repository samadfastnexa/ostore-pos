<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

    <!-- Starter counter tags. These are ordinary partner categories, so they
         also work everywhere else in Odoo (filters, reports, pricelists);
         the POS shows them on the customer card so the cashier knows who they
         are dealing with before ringing anything up. Shops can rename, delete
         or add their own. -->

    <record id="partner_tag_vip" model="res.partner.category">
        <field name="name">VIP</field>
        <field name="color">3</field>
    </record>

    <record id="partner_tag_wholesale" model="res.partner.category">
        <field name="name">Wholesale</field>
        <field name="color">4</field>
    </record>

    <record id="partner_tag_regular" model="res.partner.category">
        <field name="name">Regular</field>
        <field name="color">10</field>
    </record>

    <record id="partner_tag_pays_on_time" model="res.partner.category">
        <field name="name">Pays on time</field>
        <field name="color">7</field>
    </record>

    <record id="partner_tag_slow_payer" model="res.partner.category">
        <field name="name">Slow payer</field>
        <field name="color">2</field>
    </record>

    <record id="partner_tag_allow_credit" model="res.partner.category">
        <field name="name">Allow credit</field>
        <field name="color">5</field>
    </record>

    <record id="partner_tag_home_delivery" model="res.partner.category">
        <field name="name">Deliver to home</field>
        <field name="color">6</field>
    </record>

    <record id="partner_tag_invoice_required" model="res.partner.category">
        <field name="name">Invoice required</field>
        <field name="color">1</field>
    </record>

        <!-- The customer a counter sale belongs to when the buyer is nobody in
             particular. Deliberately company-less so every register can use the
             one record, and so its POS history is not split per company. -->
        <record id="partner_walk_in_customer" model="res.partner">
            <field name="name">Walk-in Customer</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>

    <!-- Repair pass, OUTSIDE noupdate so it runs on every install and upgrade.
         Idempotent, and it never overrules a register that already names its
         own default customer. -->
    <function model="pos.config" name="_pos_retail_ensure_default_customer"/>

</odoo>
