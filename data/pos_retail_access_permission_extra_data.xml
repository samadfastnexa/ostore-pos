<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Catalogue gaps.

         The shop went through the list and found parts of their own system
         with no permission covering them at all: the promotions screen, the
         business dashboard, the two audit logs, and stock counts as distinct
         from stock transfers. A permission catalogue that cannot describe
         half the app is not a permission system, it is a suggestion.

         Every entry here follows the same shape as the rest: a real group,
         real ir.model.access rows, and a description written for whoever is
         composing a role rather than for whoever wrote the code. -->

    <!-- ============ Promotions ============ -->

    <!-- Promotions decide what customers are charged, which puts them closer
         to pricing than to configuration. Kept apart from the price
         permissions all the same: running a weekend offer is a shop-floor
         decision, changing a product's own price is not. -->
    <record id="perm_promotions_view" model="pos.retail.access.permission">
        <field name="name">View Promotions &amp; Discounts</field>
        <field name="category">pos</field>
        <field name="sequence">40</field>
        <field name="description">See the promotions and discount offers that are running, and which products they apply to. Read-only: it does not allow creating an offer or changing one.</field>
    </record>
    <record id="access_perm_promotions_view_campaign" model="ir.model.access">
        <field name="name">Permission View Promotions: pos.retail.brand.campaign</field>
        <field name="model_id" ref="model_pos_retail_brand_campaign"/>
        <field name="group_id" ref="perm_promotions_view_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="perm_promotions_manage" model="pos.retail.access.permission">
        <field name="name">Manage Promotions &amp; Discounts</field>
        <field name="category">pos</field>
        <field name="sequence">41</field>
        <field name="description">Create and change promotions: percentage off, a fixed amount off, or a fixed selling price, aimed at everything or at chosen products, a category, a brand or a set of tags. An offer takes effect at every till the moment its start time passes, so this is a permission to change what customers pay.</field>
    </record>
    <record id="access_perm_promotions_manage_campaign" model="ir.model.access">
        <field name="name">Permission Manage Promotions: pos.retail.brand.campaign</field>
        <field name="model_id" ref="model_pos_retail_brand_campaign"/>
        <field name="group_id" ref="perm_promotions_manage_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ============ Reporting ============ -->

    <!-- The dashboard shows takings, margins and stock value for the whole
         branch. Separate from the read-only POS reports, because a figure
         that answers "how is the shop doing" is a different disclosure from
         a list of the day's orders. -->
    <record id="perm_dashboard" model="pos.retail.access.permission">
        <field name="name">View Business Dashboard</field>
        <field name="category">reporting</field>
        <field name="sequence">10</field>
        <field name="description">Open the business dashboard: sales, margins, stock value and the top products, over any date range. This is the whole branch's performance in one screen, so give it to whoever is accountable for the branch rather than to whoever is standing at the till.</field>
    </record>
    <record id="access_perm_dashboard" model="ir.model.access">
        <field name="name">Permission View Business Dashboard: pos.retail.dashboard</field>
        <field name="model_id" ref="model_pos_retail_dashboard"/>
        <field name="group_id" ref="perm_dashboard_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Both audit logs are read-only by design, for everybody. They exist to
         be evidence, and evidence that the people it describes can edit is
         not evidence. Nobody gets write access to these, not even an
         administrator, through any role. -->
    <record id="perm_audit_logs" model="pos.retail.access.permission">
        <field name="name">View Discount &amp; Stock Audit Logs</field>
        <field name="category">reporting</field>
        <field name="sequence">20</field>
        <field name="description">Read the two audit trails: every discount given, by whom, for what reason and who approved it; and every stock movement caused by a sale. Both are permanently read-only for everyone, including administrators, because a log the people in it can edit proves nothing.</field>
    </record>
    <record id="access_perm_audit_discount_log" model="ir.model.access">
        <field name="name">Permission View Audit Logs: pos.retail.discount.log</field>
        <field name="model_id" ref="model_pos_retail_discount_log"/>
        <field name="group_id" ref="perm_audit_logs_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="access_perm_audit_inventory_movement" model="ir.model.access">
        <field name="name">Permission View Audit Logs: pos.retail.inventory.movement</field>
        <field name="model_id" ref="model_pos_retail_inventory_movement"/>
        <field name="group_id" ref="perm_audit_logs_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ============ Inventory ============ -->

    <!-- Counting what is on the shelf and moving goods between places are
         different jobs. A cashier correcting a count of screws should not
         thereby be able to transfer stock to another branch, and the
         catalogue had only the second. -->
    <record id="perm_stock_counts" model="pos.retail.access.permission">
        <field name="name">Correct Stock Counts</field>
        <field name="category">inventory</field>
        <field name="sequence">40</field>
        <field name="description">Count what is physically on the shelf and correct the figure, including from the till. Every correction is recorded as an inventory adjustment carrying the name of whoever made it. This does not allow transferring stock between locations or branches.</field>
        <field name="till_capability">_can_stock_adjust</field>
    </record>
    <record id="access_perm_stock_counts_quant" model="ir.model.access">
        <field name="name">Permission Correct Stock Counts: stock.quant</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="group_id" ref="perm_stock_counts_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ============ Back office from the till ============ -->

    <!-- Not seeded onto any everyday permission, deliberately. Leaving the
         till for the back office is a real step up from selling, so it has
         to be granted on purpose rather than arriving with "Use Point of
         Sale". What the cashier then sees there is bounded by the rest of
         their role, not by this. -->
    <record id="perm_back_office" model="pos.retail.access.permission">
        <field name="name">Open Back Office from the Till</field>
        <field name="category">pos</field>
        <field name="sequence">32</field>
        <field name="description">Adds a Back Office entry to the till's menu. The cashier confirms with their own PIN and the back office opens as them, showing only what the rest of their role allows, with no dashboard and no settings. A "Back to Till" entry returns the device to the till afterwards. The cashier needs a login of their own for this to work.</field>
        <field name="till_capability">_can_back_office</field>
    </record>

    <!-- ============ Point of Sale ============ -->

    <!-- Refunds move money back out of the drawer, so a shop may well want to
         name who can give one. It is seeded onto "Use Point of Sale" rather
         than standing alone, so nothing changes for a shop that has not
         thought about it: every cashier keeps the button. Moving the
         capability onto this permission instead is how a shop restricts it.-->
    <record id="perm_refund" model="pos.retail.access.permission">
        <field name="name">Give Refunds at the Till</field>
        <field name="category">pos</field>
        <field name="sequence">30</field>
        <field name="description">Refund a previous sale from the till. Money leaves the drawer, so a shop that wants refunds limited to senior staff should put this permission on their role and take the till capability off "Use Point of Sale (Till)". Until that is done every cashier can refund, which is how the shop worked before this permission existed.</field>
    </record>


    <!-- Promotions had View and Manage only; Configuration Lists had Create,
         Edit and Delete but no View. These complete the four boxes for both,
         the same split every other area has. "Manage" stays as the one box
         that grants all of it. -->

    <record id="perm_promotions_create" model="pos.retail.access.permission">
        <field name="name">Create Promotions &amp; Discounts</field>
        <field name="category">pos</field>
        <field name="sequence">42</field>
        <field name="description">Add a new promotion. Does not allow changing or removing existing ones.</field>
    </record>
    <record id="access_perm_promotions_create_pos_retail_brand_campaign" model="ir.model.access">
        <field name="name">Permission Create Promotions and Discounts: pos.retail.brand.campaign</field>
        <field name="model_id" ref="model_pos_retail_brand_campaign"/>
        <field name="group_id" ref="perm_promotions_create_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="perm_promotions_edit" model="pos.retail.access.permission">
        <field name="name">Edit Promotions &amp; Discounts</field>
        <field name="category">pos</field>
        <field name="sequence">43</field>
        <field name="description">Change an existing promotion: its dates, its discount, the products it covers. Does not allow adding or removing promotions.</field>
    </record>
    <record id="access_perm_promotions_edit_pos_retail_brand_campaign" model="ir.model.access">
        <field name="name">Permission Edit Promotions and Discounts: pos.retail.brand.campaign</field>
        <field name="model_id" ref="model_pos_retail_brand_campaign"/>
        <field name="group_id" ref="perm_promotions_edit_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="perm_promotions_delete" model="pos.retail.access.permission">
        <field name="name">Delete Promotions &amp; Discounts</field>
        <field name="category">pos</field>
        <field name="sequence">44</field>
        <field name="description">Remove a promotion. Does not allow adding or changing promotions.</field>
    </record>
    <record id="access_perm_promotions_delete_pos_retail_brand_campaign" model="ir.model.access">
        <field name="name">Permission Delete Promotions and Discounts: pos.retail.brand.campaign</field>
        <field name="model_id" ref="model_pos_retail_brand_campaign"/>
        <field name="group_id" ref="perm_promotions_delete_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="perm_config_lists_view" model="pos.retail.access.permission">
        <field name="name">View Configuration Lists (Read-Only)</field>
        <field name="category">configuration</field>
        <field name="sequence">5</field>
        <field name="description">See the POS configuration lists (membership levels, discount roles and reasons, return reasons, price reasons and the rest) without being able to add, change or remove anything.</field>
    </record>
    <record id="access_perm_config_lists_view_pos_membership_level" model="ir.model.access">
        <field name="name">Permission View Configuration Lists: pos.membership.level</field>
        <field name="model_id" ref="model_pos_membership_level"/>
        <field name="group_id" ref="perm_config_lists_view_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="access_perm_config_lists_view_pos_retail_discount_role" model="ir.model.access">
        <field name="name">Permission View Configuration Lists: pos.retail.discount.role</field>
        <field name="model_id" ref="model_pos_retail_discount_role"/>
        <field name="group_id" ref="perm_config_lists_view_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="access_perm_config_lists_view_pos_retail_discount_reason" model="ir.model.access">
        <field name="name">Permission View Configuration Lists: pos.retail.discount.reason</field>
        <field name="model_id" ref="model_pos_retail_discount_reason"/>
        <field name="group_id" ref="perm_config_lists_view_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="access_perm_config_lists_view_pos_retail_return_reason" model="ir.model.access">
        <field name="name">Permission View Configuration Lists: pos.retail.return.reason</field>
        <field name="model_id" ref="model_pos_retail_return_reason"/>
        <field name="group_id" ref="perm_config_lists_view_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="access_perm_config_lists_view_pos_retail_price_reason" model="ir.model.access">
        <field name="name">Permission View Configuration Lists: pos.retail.price.reason</field>
        <field name="model_id" ref="model_pos_retail_price_reason"/>
        <field name="group_id" ref="perm_config_lists_view_res_groups"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
