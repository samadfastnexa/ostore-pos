<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Contacts" says nothing about who is in there. For a shop the app
         holds the people it sells to and the people it buys from, so name it
         that. -->
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="name">Customers &amp; Vendors</field>
        <field name="sequence">30</field>
    </record>
    <record id="contacts.res_partner_menu_contacts" model="ir.ui.menu">
        <field name="name">All Contacts</field>
    </record>

    <!-- Customers and Vendors get their own sidebar entries. res.partner is one
         shared table, so an unfiltered list also holds the partner row behind
         every company, user login and employee work contact (Cash & Carry,
         Administrator, Cashier Ali...). Those are system records, not
         address-book entries: staff belong in Employees, the company in
         Settings. Splitting the menu answers the question the shop actually
         asks ("who do I sell to / buy from") instead of making them filter a
         mixed list every time.
         All Contacts is left unfiltered and keeps its own name honest: it is
         still the way to reach a record that is neither. -->
    <menuitem id="pos_retail_menu_customers"
              name="Customers"
              action="pos_retail.action_pos_retail_customers"
              parent="contacts.menu_contacts"
              sequence="1"/>
    <menuitem id="pos_retail_menu_vendors"
              name="Vendors"
              action="pos_retail.action_pos_retail_vendors"
              parent="contacts.menu_contacts"
              sequence="2"/>
    <record id="contacts.res_partner_menu_contacts" model="ir.ui.menu">
        <field name="sequence">3</field>
    </record>
    <record id="contacts.res_partner_menu_config" model="ir.ui.menu">
        <field name="sequence">10</field>
    </record>

    <!-- App order: a shop opens the till all day, the books occasionally and
         the rest rarely, so the sidebar follows that rather than Odoo's
         generic ordering, which buried Point of Sale in fourth place. -->
    <record id="point_of_sale.menu_point_root" model="ir.ui.menu">
        <field name="sequence">10</field>
    </record>
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="sequence">20</field>
    </record>

    <!-- Hide Odoo's spreadsheet "Dashboards" app. It ships seven empty
         category groups for lines of business this shop does not run, and its
         name claims the one thing it is not: the real dashboard lives at
         Point of Sale > Dashboard. Set active back to True to restore it. -->
    <record id="spreadsheet_dashboard.spreadsheet_dashboard_menu_root" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <!-- Invoicing had "Customers" as a section AND as an item inside it,
         while the contact list already lives in its own app: the same word
         meant three different things on one screen. The section is named for
         what it holds, and the duplicate contact shortcut is dropped. -->
    <record id="account.menu_finance_receivables" model="ir.ui.menu">
        <field name="name">Sales Billing</field>
    </record>
    <record id="account.menu_finance_payables" model="ir.ui.menu">
        <field name="name">Purchase Billing</field>
    </record>
    <record id="account.menu_account_customer" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <!-- Products > Product Brands -->
    <menuitem id="menu_product_brand"
        name="Product Brands"
        parent="point_of_sale.pos_config_menu_catalog"
        action="product_brand_action"
        sequence="7"/>

    <!-- Products > Product Packages -->
    <menuitem id="menu_pos_retail_packages"
        name="Product Packages"
        parent="point_of_sale.pos_config_menu_catalog"
        action="action_pos_retail_packages"
        sequence="8"/>

    <!-- Configuration list menus: also visible to holders of the "Manage POS
         Configuration Lists" catalog permission (the perm_*_res_groups xmlids
         are the auto-created groups behind the seeded permissions). NOTE:
         menuitem groups= produces additive (4) links on upgrade; removing a
         group from this attribute later does NOT remove it from the DB. -->

    <!-- Configuration > Membership Levels -->
    <menuitem id="menu_pos_membership_level"
        name="Membership Levels"
        parent="point_of_sale.menu_point_config_product"
        action="pos_membership_level_action"
        sequence="60"
        groups="point_of_sale.group_pos_manager,perm_config_lists_res_groups,perm_config_lists_create_res_groups,perm_config_lists_edit_res_groups,perm_config_lists_delete_res_groups"/>

    <!-- Configuration > Discount Roles -->
    <menuitem id="menu_pos_retail_discount_role"
        name="Discount Roles"
        parent="point_of_sale.menu_point_config_product"
        action="pos_retail_discount_role_action"
        sequence="70"
        groups="point_of_sale.group_pos_manager,perm_config_lists_res_groups,perm_config_lists_create_res_groups,perm_config_lists_edit_res_groups,perm_config_lists_delete_res_groups"/>

    <!-- Configuration > Discount Reasons -->
    <menuitem id="menu_pos_retail_discount_reason"
        name="Discount Reasons"
        parent="point_of_sale.menu_point_config_product"
        action="pos_retail_discount_reason_action"
        sequence="80"
        groups="point_of_sale.group_pos_manager,perm_config_lists_res_groups,perm_config_lists_create_res_groups,perm_config_lists_edit_res_groups,perm_config_lists_delete_res_groups"/>

    <!-- Configuration > Return Reasons -->
    <menuitem id="menu_pos_retail_return_reason"
        name="Return Reasons"
        parent="point_of_sale.menu_point_config_product"
        action="pos_retail_return_reason_action"
        sequence="85"
        groups="point_of_sale.group_pos_manager,perm_config_lists_res_groups,perm_config_lists_create_res_groups,perm_config_lists_edit_res_groups,perm_config_lists_delete_res_groups"/>

    <!-- Configuration > Price Reasons -->
    <menuitem id="menu_pos_retail_price_reason"
        name="Price Reasons"
        parent="point_of_sale.menu_point_config_product"
        action="pos_retail_price_reason_action"
        sequence="86"
        groups="point_of_sale.group_pos_manager,perm_config_lists_res_groups,perm_config_lists_create_res_groups,perm_config_lists_edit_res_groups,perm_config_lists_delete_res_groups"/>

    <!-- Reporting > Customer Ledger. Gated on POS Manager, the persona this
         was built for: point_of_sale's own ACL already grants POS users READ
         on account.move.line, so a manager can genuinely open this list. The
         customer-form smart button stays accounting-gated separately, because
         the res.partner.credit field it displays is itself field-level
         restricted to those groups in core. -->
    <!-- Sequence 8: keep all single-page report entries clustered together
         (Inventory Movements 5, Discount Log 6, Returns 7, Customer Ledger 8,
         Expenses by Category 9) ahead of the report sub-groups (10/12/14) so
         none of them gets lost between two groups' children. -->
    <menuitem id="pos_retail_menu_customer_ledger" name="Customer Ledger"
        parent="point_of_sale.menu_point_rep" action="action_pos_retail_customer_ledger"
        sequence="8" groups="point_of_sale.group_pos_manager,account.group_account_invoice,account.group_account_readonly,perm_reporting_res_groups"/>

    <!-- Reporting > Credit Approvals -->
    <menuitem id="pos_retail_menu_credit_overrides" name="Credit Approvals"
        parent="point_of_sale.menu_point_rep" action="action_pos_retail_credit_overrides"
        sequence="11" groups="point_of_sale.group_pos_manager,perm_reporting_res_groups"/>

    <!-- Reporting > Package Reports -->
    <menuitem id="pos_retail_menu_package_reports" name="Package Reports"
        parent="point_of_sale.menu_point_rep" sequence="13"
        groups="point_of_sale.group_pos_manager,perm_reporting_res_groups"/>

    <menuitem id="pos_retail_menu_package_sales" name="Sales by Package"
        parent="pos_retail_menu_package_reports" action="action_pos_retail_package_sales" sequence="10"/>
    <menuitem id="pos_retail_menu_package_top_sizes" name="Most Sold Package Sizes"
        parent="pos_retail_menu_package_reports" action="action_pos_retail_package_top_sizes" sequence="20"/>
    <menuitem id="pos_retail_menu_package_inventory" name="Package Inventory and Profitability"
        parent="pos_retail_menu_package_reports" action="action_pos_retail_package_inventory" sequence="30"/>

    <!-- Reporting > Price Reports -->
    <menuitem id="pos_retail_menu_price_reports" name="Price Reports"
        parent="point_of_sale.menu_point_rep" sequence="14"
        groups="point_of_sale.group_pos_manager,perm_reporting_res_groups"/>

    <menuitem id="pos_retail_menu_price_analysis" name="Price Analysis"
        parent="pos_retail_menu_price_reports" action="action_pos_retail_price_analysis" sequence="10"/>
    <menuitem id="pos_retail_menu_price_overrides" name="Price Overrides"
        parent="pos_retail_menu_price_reports" action="action_pos_retail_price_overrides" sequence="20"/>
    <menuitem id="pos_retail_menu_price_below" name="Sold Below Default Price"
        parent="pos_retail_menu_price_reports" action="action_pos_retail_price_below_default" sequence="30"/>
    <menuitem id="pos_retail_menu_price_above" name="Sold Above Default Price"
        parent="pos_retail_menu_price_reports" action="action_pos_retail_price_above_default" sequence="40"/>
    <menuitem id="pos_retail_menu_price_by_manager" name="Manager Price Overrides"
        parent="pos_retail_menu_price_reports" action="action_pos_retail_price_by_manager" sequence="50"/>
    <menuitem id="pos_retail_menu_price_by_reason" name="Price Adjustment Reasons"
        parent="pos_retail_menu_price_reports" action="action_pos_retail_price_by_reason" sequence="60"/>

    <!-- Purchase > Orders > Goods Receipts -->
    <menuitem id="pos_retail_menu_goods_receipts" name="Goods Receipts"
        parent="purchase.menu_procurement_management" action="action_pos_retail_goods_receipts"
        sequence="15"
        groups="purchase.group_purchase_user,perm_purchases_view_res_groups,perm_inventory_view_res_groups"/>

    <!-- Purchase > Reporting > Vendor Reports. Also opened up to plain
         purchase users so the "Manage Purchases" catalog permission (implying
         purchase.group_purchase_user) covers them; all child action models
         are readable to that group. The payment summary child keeps its own
         stricter accounting gate. -->
    <menuitem id="pos_retail_menu_vendor_reports" name="Vendor Reports"
        parent="purchase.purchase_report_main" sequence="10"
        groups="purchase.group_purchase_manager,purchase.group_purchase_user"/>

    <menuitem id="pos_retail_menu_vendor_purchase_summary" name="Vendor Purchase Summary"
        parent="pos_retail_menu_vendor_reports" action="action_vendor_purchase_summary" sequence="10"/>
    <menuitem id="pos_retail_menu_top_vendors" name="Top Vendors by Purchase Value"
        parent="pos_retail_menu_vendor_reports" action="action_top_vendors_by_purchase_value" sequence="20"/>
    <menuitem id="pos_retail_menu_purchase_price_history" name="Purchase Price History"
        parent="pos_retail_menu_vendor_reports" action="action_purchase_price_history" sequence="30"/>
    <menuitem id="pos_retail_menu_products_by_vendor" name="Products by Vendor"
        parent="pos_retail_menu_vendor_reports" action="action_products_by_vendor" sequence="40"/>
    <menuitem id="pos_retail_menu_vendor_payment_summary" name="Vendor Payment Summary"
        parent="pos_retail_menu_vendor_reports" action="action_vendor_payment_summary" sequence="50"
        groups="purchase.group_purchase_manager,account.group_account_invoice"/>
    <menuitem id="pos_retail_menu_vendor_performance" name="Vendor Performance"
        parent="pos_retail_menu_vendor_reports" action="action_vendor_performance" sequence="60"/>
    <menuitem id="pos_retail_menu_products_no_vendor" name="Products with No Assigned Vendor"
        parent="pos_retail_menu_vendor_reports" action="action_products_no_vendor" sequence="70"/>

    <!-- Point of Sale > Reporting > Inventory Movements -->
    <menuitem id="pos_retail_menu_inventory_movement" name="Inventory Movements"
        parent="point_of_sale.menu_point_rep" action="pos_retail_inventory_movement_action"
        sequence="5" groups="point_of_sale.group_pos_manager,perm_reporting_res_groups"/>

    <!-- Point of Sale > Reporting > Returns and Refunds -->
    <menuitem id="pos_retail_menu_returns" name="Returns and Refunds"
        parent="point_of_sale.menu_point_rep" action="action_pos_retail_returns"
        sequence="7" groups="point_of_sale.group_pos_manager,perm_reporting_res_groups"/>

    <!-- Point of Sale > Orders > Receipt History -->
    <menuitem id="pos_retail_menu_receipt_history" name="Receipt History"
        parent="point_of_sale.menu_point_of_sale" action="action_pos_retail_receipt_history"
        sequence="5" groups="point_of_sale.group_pos_manager,perm_reporting_res_groups"/>

    <!-- Point of Sale > Orders > Quotations. Gated on POS Manager as well as
         salespeople: the store admin runs quotations without being a
         "salesperson" in Odoo's sense (sale.order read comes via the
         stock-user group POS Manager already implies). -->
    <menuitem id="pos_retail_menu_quotations" name="Quotations"
        parent="point_of_sale.menu_point_of_sale" action="action_pos_retail_quotations"
        sequence="4" groups="point_of_sale.group_pos_manager,sales_team.group_sale_salesman,perm_sales_view_res_groups,perm_sales_create_res_groups,perm_sales_edit_res_groups,perm_sales_delete_res_groups"/>

    <!-- Point of Sale > Order Reception. Sits with the other shop-floor
         stock jobs: whoever unpacks the delivery is the same person who
         counts the shelf and writes off breakages. -->
    <menuitem id="pos_retail_menu_reception" name="Order Reception"
        parent="point_of_sale.menu_point_root" action="action_pos_retail_reception"
        sequence="14" groups="point_of_sale.group_pos_manager,stock.group_stock_user,purchase.group_purchase_user,perm_inventory_view_res_groups"/>

    <!-- Point of Sale > Stock Count and Record Damage. Placed under Point of
         Sale rather than Inventory on purpose: these are daily shop-floor jobs
         done by counter staff, who have no reason to open the Inventory app. -->
    <menuitem id="pos_retail_menu_stock_count" name="Stock Count"
        parent="point_of_sale.menu_point_root" action="action_pos_retail_stock_count"
        sequence="16" groups="point_of_sale.group_pos_manager,stock.group_stock_user,perm_inventory_view_res_groups"/>

    <menuitem id="pos_retail_menu_record_damage" name="Record Damage"
        parent="point_of_sale.menu_point_root" action="action_pos_retail_record_damage"
        sequence="17" groups="point_of_sale.group_pos_manager,stock.group_stock_user,perm_inventory_view_res_groups"/>

    <!-- Point of Sale > Expenses -->
    <menuitem id="pos_retail_menu_expense" name="Expenses"
        parent="point_of_sale.menu_point_root" action="pos_retail_expense_action"
        sequence="15" groups="point_of_sale.group_pos_manager,perm_expenses_res_groups,perm_expenses_create_res_groups,perm_expenses_edit_res_groups,perm_expenses_delete_res_groups"/>

    <!-- Point of Sale > Reporting > Expenses by Category -->
    <menuitem id="pos_retail_menu_expense_pivot" name="Expenses by Category"
        parent="point_of_sale.menu_point_rep" action="pos_retail_expense_action_pivot"
        sequence="9" groups="point_of_sale.group_pos_manager,perm_expenses_res_groups,perm_expenses_create_res_groups,perm_expenses_edit_res_groups,perm_expenses_delete_res_groups,perm_reporting_res_groups"/>

    <!-- Point of Sale > Reporting > POS Sales Reports -->
    <menuitem id="pos_retail_menu_pos_reports" name="POS Sales Reports"
        parent="point_of_sale.menu_point_rep" sequence="10"
        groups="point_of_sale.group_pos_manager,perm_reporting_res_groups"/>

    <menuitem id="pos_retail_menu_sales_by_category" name="Sales by Category"
        parent="pos_retail_menu_pos_reports" action="action_pos_retail_sales_by_category" sequence="10"/>
    <menuitem id="pos_retail_menu_sales_by_payment_method" name="Sales by Payment Method"
        parent="pos_retail_menu_pos_reports" action="action_pos_retail_sales_by_payment_method" sequence="20"/>
    <menuitem id="pos_retail_menu_top_customers" name="Top Customers"
        parent="pos_retail_menu_pos_reports" action="action_pos_retail_top_customers" sequence="30"/>
    <menuitem id="pos_retail_menu_sales_by_cashier" name="Sales by Cashier"
        parent="pos_retail_menu_pos_reports" action="action_pos_retail_sales_by_cashier" sequence="40"/>
    <menuitem id="pos_retail_menu_product_discounts" name="Product Discounts"
        parent="pos_retail_menu_pos_reports" action="action_pos_retail_product_discounts" sequence="50"/>

    <!-- Point of Sale > Discount Audit Log -->
    <menuitem id="pos_retail_menu_discount_log" name="Discount Audit Log"
        parent="point_of_sale.menu_point_rep" action="pos_retail_discount_log_action"
        sequence="6" groups="point_of_sale.group_pos_manager,perm_reporting_res_groups"/>

    <!-- Point of Sale > Reporting > Discount Reports -->
    <menuitem id="pos_retail_menu_discount_reports" name="Discount Reports"
        parent="point_of_sale.menu_point_rep" sequence="12"
        groups="point_of_sale.group_pos_manager,perm_reporting_res_groups"/>

    <menuitem id="pos_retail_menu_discount_totals" name="Total Order Discounts"
        parent="pos_retail_menu_discount_reports" action="pos_retail_discount_report_totals" sequence="10"/>
    <menuitem id="pos_retail_menu_discount_roundoff" name="Round-Off Adjustments"
        parent="pos_retail_menu_discount_reports" action="pos_retail_discount_report_roundoff" sequence="20"/>
    <menuitem id="pos_retail_menu_discount_by_cashier" name="Discounts by Cashier"
        parent="pos_retail_menu_discount_reports" action="pos_retail_discount_report_by_cashier" sequence="30"/>
    <menuitem id="pos_retail_menu_discount_by_manager" name="Discounts by Manager"
        parent="pos_retail_menu_discount_reports" action="pos_retail_discount_report_by_manager" sequence="40"/>
    <menuitem id="pos_retail_menu_discount_by_branch" name="Discounts by Branch"
        parent="pos_retail_menu_discount_reports" action="pos_retail_discount_report_by_branch" sequence="50"/>
    <menuitem id="pos_retail_menu_discount_by_date" name="Discounts by Date"
        parent="pos_retail_menu_discount_reports" action="pos_retail_discount_report_by_date" sequence="60"/>
    <menuitem id="pos_retail_menu_discount_by_reason" name="Discount Reasons"
        parent="pos_retail_menu_discount_reports" action="pos_retail_discount_report_by_reason" sequence="70"/>
    <menuitem id="pos_retail_menu_discount_high_value" name="High Discount Transactions"
        parent="pos_retail_menu_discount_reports" action="pos_retail_discount_report_high_value" sequence="80"/>

    <!-- Configuration > Roles & Permissions. Super-Admin-only (base.group_system,
         not point_of_sale.group_pos_manager): this screen configures real
         security, so managing it is kept out of reach of a plain manager. -->
    <menuitem id="menu_pos_retail_access_role"
        name="Roles &amp; Permissions"
        parent="point_of_sale.menu_point_config_product"
        action="pos_retail_access_role_action"
        sequence="90"
        groups="base.group_system"/>

    <!-- Configuration > Permissions Catalog (same super-admin gate). -->
    <menuitem id="menu_pos_retail_access_permission"
        name="Permissions Catalog"
        parent="point_of_sale.menu_point_config_product"
        action="pos_retail_access_permission_action"
        sequence="95"
        groups="base.group_system"/>

    <!-- Core menu gates opened to catalog permissions. Direct catalog
         permissions (ACL-based ones) do not imply group_pos_user, so the POS
         root menu and the manager-gated Configuration container must also
         accept their groups or the whole subtree stays hidden (a gated
         ancestor cuts its children). Idempotent (4) links; reapplied on every
         upgrade. Implied-group permissions (Use POS, Manage Purchases, etc.)
         need nothing here: the native gates already list their groups. -->
    <record id="point_of_sale.menu_point_root" model="ir.ui.menu">
        <field name="group_ids" eval="[
            (4, ref('perm_products_create_res_groups')),
            (4, ref('perm_products_edit_res_groups')),
            (4, ref('perm_products_delete_res_groups')),
            (4, ref('perm_expenses_res_groups')),
            (4, ref('perm_expenses_create_res_groups')),
            (4, ref('perm_expenses_edit_res_groups')),
            (4, ref('perm_expenses_delete_res_groups')),
            (4, ref('perm_reporting_res_groups')),
            (4, ref('perm_config_lists_res_groups')),
            (4, ref('perm_config_lists_create_res_groups')),
            (4, ref('perm_config_lists_edit_res_groups')),
            (4, ref('perm_config_lists_delete_res_groups')),
            (4, ref('perm_sales_view_res_groups')),
            (4, ref('perm_sales_create_res_groups')),
            (4, ref('perm_sales_edit_res_groups')),
            (4, ref('perm_sales_delete_res_groups')),
        ]"/>
    </record>
    <record id="point_of_sale.menu_point_config_product" model="ir.ui.menu">
        <field name="group_ids" eval="[
            (4, ref('perm_config_lists_res_groups')),
            (4, ref('perm_config_lists_create_res_groups')),
            (4, ref('perm_config_lists_edit_res_groups')),
            (4, ref('perm_config_lists_delete_res_groups')),
        ]"/>
    </record>
    <!-- Purchase > Reporting parent is manager-gated in core; open it to
         plain purchase users so "Manage Purchases" reaches Vendor Reports.
         Its native "Purchase" child stays manager-only. -->
    <record id="purchase.purchase_report_main" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <!-- App root menus for the per-area CRUD slices: the slices grant model
         access via their own ACL rows (not by implying the native app-user
         group), so the gated app roots must also accept their groups or the
         apps stay invisible. Menus INSIDE these apps are mostly ungated and
         appear automatically once the action's model is readable. -->
    <record id="purchase.menu_purchase_root" model="ir.ui.menu">
        <field name="group_ids" eval="[
            (4, ref('perm_purchases_view_res_groups')),
            (4, ref('perm_purchases_create_res_groups')),
            (4, ref('perm_purchases_edit_res_groups')),
            (4, ref('perm_purchases_delete_res_groups')),
        ]"/>
    </record>
    <record id="stock.menu_stock_root" model="ir.ui.menu">
        <field name="group_ids" eval="[
            (4, ref('perm_inventory_view_res_groups')),
            (4, ref('perm_inventory_create_res_groups')),
            (4, ref('perm_inventory_edit_res_groups')),
            (4, ref('perm_inventory_delete_res_groups')),
        ]"/>
    </record>
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="group_ids" eval="[
            (4, ref('perm_invoicing_view_res_groups')),
            (4, ref('perm_invoicing_create_res_groups')),
            (4, ref('perm_invoicing_edit_res_groups')),
            (4, ref('perm_invoicing_delete_res_groups')),
        ]"/>
    </record>

    <!--
        Hide the Discuss app tile from the apps switcher for this store.
        The `mail` module itself stays installed and fully functional (it's a
        hard dependency of point_of_sale/purchase/account for chatter, activities
        and outgoing email) — this only removes the standalone chat app icon.
        To bring it back: set active back to True (or delete this record).
    -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <!--
        Hide Odoo's two other routes to the contacts list, leaving
        Customers and Vendors as the single way in.

        Neither is a straight duplicate, which is why they were left alone until
        now: point_of_sale.menu_point_of_sale_customer applies a Customers
        filter as a removable search CHIP and defaults new contacts to
        is_company=True, and sale.res_partner_menu applies no filter at all.
        Both are worse here than pos_retail_menu_customers, which filters on a
        hard domain (customer_rank > 0) so a vendor or a cashier can never
        surface however the search box is used - the exact confusion that put
        Karachi Beverages Distributors in front of a cashier looking for a
        buyer. Defaulting a khata customer to a company is wrong for a shop
        where many of them are individuals.

        Menus only: the records, the actions and every other route to them are
        untouched. To bring either back, set active to True or delete the
        record.
    -->
    <record id="point_of_sale.menu_point_of_sale_customer" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <record id="sale.res_partner_menu" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

</odoo>
