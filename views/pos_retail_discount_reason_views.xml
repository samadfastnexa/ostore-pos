<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_retail_discount_reason_view_list" model="ir.ui.view">
        <field name="name">pos.retail.discount.reason.list</field>
        <field name="model">pos.retail.discount.reason</field>
        <field name="arch" type="xml">
            <list string="Discount Reasons">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="pos_retail_discount_reason_view_form" model="ir.ui.view">
        <field name="name">pos.retail.discount.reason.form</field>
        <field name="model">pos.retail.discount.reason</field>
        <field name="arch" type="xml">
            <form string="Discount Reason">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Price Match"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_retail_discount_reason_view_search" model="ir.ui.view">
        <field name="name">pos.retail.discount.reason.search</field>
        <field name="model">pos.retail.discount.reason</field>
        <field name="arch" type="xml">
            <search string="Discount Reasons">
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="pos_retail_discount_reason_action" model="ir.actions.act_window">
        <field name="name">Discount Reasons</field>
        <field name="res_model">pos.retail.discount.reason</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first discount reason</p>
            <p>Cashiers must pick one of these when applying an order-level discount.</p>
        </field>
    </record>

</odoo>
