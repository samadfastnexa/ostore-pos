<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_retail_discount_log_view_list" model="ir.ui.view">
        <field name="name">pos.retail.discount.log.list</field>
        <field name="model">pos.retail.discount.log</field>
        <field name="arch" type="xml">
            <list string="Discount Audit Log" create="false" decoration-info="manager_id">
                <field name="date"/>
                <field name="pos_order_ref"/>
                <field name="partner_id"/>
                <field name="cashier_name" string="Cashier"/>
                <field name="manager_name" string="Manager"/>
                <field name="config_id" string="Branch"/>
                <field name="original_amount"/>
                <field name="discount_amount"/>
                <field name="discount_percentage"/>
                <field name="discount_input_type" widget="badge" decoration-info="discount_input_type == 'percent'" decoration-warning="discount_input_type == 'fixed'"/>
                <field name="round_off_amount"/>
                <field name="final_amount"/>
                <field name="reason_id"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="pos_retail_discount_log_view_form" model="ir.ui.view">
        <field name="name">pos.retail.discount.log.form</field>
        <field name="model">pos.retail.discount.log</field>
        <field name="arch" type="xml">
            <form string="Discount Audit Log" create="false" edit="false">
                <sheet>
                    <div class="alert alert-info d-flex align-items-start gap-2 mb-3" role="alert">
                        <i class="fa fa-info-circle mt-1" role="img" aria-label="Info" title="Info"/>
                        <div>
                            <strong>Purpose:</strong> permanent, read-only record of every order discount and
                            round-off, for accountability.<br/>
                            <strong>How to use:</strong> nothing to fill in here — a row is created automatically
                            whenever a completed sale had a discount or rounding. Use the Discount Reports menu to analyze trends.
                        </div>
                    </div>
                    <div class="oe_title">
                        <h1><field name="pos_order_ref"/></h1>
                    </div>
                    <group>
                        <group string="Amounts">
                            <field name="currency_id" invisible="1"/>
                            <field name="original_amount"/>
                            <field name="discount_amount"/>
                            <field name="discount_percentage"/>
                            <field name="discount_input_type"/>
                            <field name="round_off_amount"/>
                            <field name="final_amount"/>
                        </group>
                        <group string="Who / Where">
                            <field name="order_id"/>
                            <field name="cashier_id"/>
                            <field name="manager_id"/>
                            <field name="partner_id"/>
                            <field name="config_id"/>
                            <field name="date"/>
                        </group>
                        <group string="Reason">
                            <field name="reason_id"/>
                            <field name="reason_notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_retail_discount_log_view_search" model="ir.ui.view">
        <field name="name">pos.retail.discount.log.search</field>
        <field name="model">pos.retail.discount.log</field>
        <field name="arch" type="xml">
            <search string="Discount Audit Log">
                <field name="pos_order_ref"/>
                <field name="partner_id"/>
                <field name="cashier_id"/>
                <field name="manager_id"/>
                <field name="config_id"/>
                <field name="reason_id"/>
                <separator/>
                <filter string="Today" name="filter_today"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Last 7 Days" name="filter_last_7_days"
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="This Month" name="filter_this_month"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01 00:00:00'))]"/>
                <separator/>
                <filter string="Manager Approved" name="filter_manager_approved" domain="[('manager_id', '!=', False)]"/>
                <filter string="High Discount" name="filter_high_discount" domain="[('discount_amount', '&gt;=', 50)]"/>
                <filter string="Has Round-Off" name="filter_has_roundoff" domain="[('round_off_amount', '!=', 0)]"/>
                <group>
                    <filter string="Cashier" name="group_cashier" context="{'group_by': 'cashier_id'}"/>
                    <filter string="Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'config_id'}"/>
                    <filter string="Reason" name="group_reason" context="{'group_by': 'reason_id'}"/>
                    <filter string="Date" name="group_date_day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pos_retail_discount_log_view_pivot" model="ir.ui.view">
        <field name="name">pos.retail.discount.log.pivot</field>
        <field name="model">pos.retail.discount.log</field>
        <field name="arch" type="xml">
            <pivot string="Discount Totals">
                <field name="config_id" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="discount_amount" type="measure"/>
                <field name="round_off_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="pos_retail_discount_log_view_graph" model="ir.ui.view">
        <field name="name">pos.retail.discount.log.graph</field>
        <field name="model">pos.retail.discount.log</field>
        <field name="arch" type="xml">
            <graph string="Discount Trend" type="line">
                <field name="date" interval="day"/>
                <field name="discount_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Main audit log -->
    <record id="pos_retail_discount_log_action" model="ir.actions.act_window">
        <field name="name">Discount Audit Log</field>
        <field name="res_model">pos.retail.discount.log</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No discounted or rounded orders yet</p>
            <p>A row is created automatically for every completed order that had
               an order-level discount and/or a round-off adjustment — this is a
               read-only audit trail, not a manual data-entry screen.</p>
        </field>
    </record>

    <!-- 1. Total Order Discounts -->
    <record id="pos_retail_discount_report_totals" model="ir.actions.act_window">
        <field name="name">Total Order Discounts</field>
        <field name="res_model">pos.retail.discount.log</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="pos_retail_discount_log_view_search"/>
    </record>

    <!-- 2. Round-Off Adjustments -->
    <record id="pos_retail_discount_report_roundoff" model="ir.actions.act_window">
        <field name="name">Round-Off Adjustments</field>
        <field name="res_model">pos.retail.discount.log</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="pos_retail_discount_log_view_search"/>
        <field name="domain">[('round_off_amount', '!=', 0)]</field>
        <field name="context">{'search_default_filter_has_roundoff': 1}</field>
    </record>

    <!-- 3. Discounts by Cashier -->
    <record id="pos_retail_discount_report_by_cashier" model="ir.actions.act_window">
        <field name="name">Discounts by Cashier</field>
        <field name="res_model">pos.retail.discount.log</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="pos_retail_discount_log_view_search"/>
        <field name="context">{'search_default_group_cashier': 1}</field>
    </record>

    <!-- 4. Discounts by Manager -->
    <record id="pos_retail_discount_report_by_manager" model="ir.actions.act_window">
        <field name="name">Discounts by Manager</field>
        <field name="res_model">pos.retail.discount.log</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="pos_retail_discount_log_view_search"/>
        <field name="domain">[('manager_id', '!=', False)]</field>
        <field name="context">{'search_default_group_manager': 1}</field>
    </record>

    <!-- 5. Discounts by Branch -->
    <record id="pos_retail_discount_report_by_branch" model="ir.actions.act_window">
        <field name="name">Discounts by Branch</field>
        <field name="res_model">pos.retail.discount.log</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="pos_retail_discount_log_view_search"/>
        <field name="context">{'search_default_group_branch': 1}</field>
    </record>

    <!-- 6. Discounts by Date -->
    <record id="pos_retail_discount_report_by_date" model="ir.actions.act_window">
        <field name="name">Discounts by Date</field>
        <field name="res_model">pos.retail.discount.log</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="pos_retail_discount_log_view_search"/>
    </record>

    <!-- 7. Discount Reasons -->
    <record id="pos_retail_discount_report_by_reason" model="ir.actions.act_window">
        <field name="name">Discount Reasons</field>
        <field name="res_model">pos.retail.discount.log</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="pos_retail_discount_log_view_search"/>
        <field name="context">{'search_default_group_reason': 1}</field>
    </record>

    <!-- 8. High Discount Transactions -->
    <record id="pos_retail_discount_report_high_value" model="ir.actions.act_window">
        <field name="name">High Discount Transactions</field>
        <field name="res_model">pos.retail.discount.log</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="pos_retail_discount_log_view_search"/>
        <field name="context">{'search_default_filter_high_discount': 1}</field>
    </record>

</odoo>
