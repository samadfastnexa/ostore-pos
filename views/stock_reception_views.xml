<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Order Reception: checking in a vendor delivery.

         A simplified view over the native incoming picking, not a new model.
         The moves, the valuation and the backorder handling stay Odoo's; what
         changes is that the person unpacking boxes is asked one question per
         line ("how many actually turned up?") instead of being asked about
         reservations, source locations, packages and owners. -->

    <record id="view_picking_form_pos_retail_reception" model="ir.ui.view">
        <field name="name">stock.picking.form.pos.retail.reception</field>
        <field name="model">stock.picking</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Order Reception">
                <header>
                    <button name="action_pos_retail_receive_all" type="object"
                            string="Receive Everything as Ordered" class="btn-primary"
                            invisible="state in ('done', 'cancel')"
                            help="Fill every line with the ordered quantity, then correct only what differs."/>
                    <button name="button_validate" type="object"
                            string="Confirm Receipt" class="btn-primary"
                            invisible="state in ('done', 'cancel')"
                            confirm="This adds the entered quantities to your stock. Confirm?"/>
                    <button name="action_pos_retail_receive_nothing" type="object"
                            string="Clear Quantities"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="%(pos_retail.action_report_goods_receipt)d" type="action"
                            string="Print Goods Receipt Note" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,assigned,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Delivery">
                            <field name="partner_id" string="Vendor" readonly="state == 'done'"/>
                            <field name="origin" string="Purchase Order" readonly="1"/>
                            <field name="scheduled_date" string="Expected On" readonly="state == 'done'"/>
                            <field name="date_done" string="Received On" readonly="1"
                                   invisible="state != 'done'"/>
                        </group>
                        <group string="Check">
                            <field name="pos_retail_expected_qty"/>
                            <field name="pos_retail_received_qty"/>
                            <field name="pos_retail_reception_state" string="Result" widget="badge"
                                   decoration-success="pos_retail_reception_state == 'exact'"
                                   decoration-danger="pos_retail_reception_state == 'short'"
                                   decoration-warning="pos_retail_reception_state == 'over'"
                                   decoration-info="pos_retail_reception_state == 'none'"/>
                            <field name="user_id" string="Received By"/>
                        </group>
                    </group>

                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="pos_retail_reception_state != 'short'">
                        <strong>Short delivery.</strong>
                        Less arrived than was ordered. Confirming will offer to keep the
                        remainder on order as a backorder, so the vendor still owes it to you.
                    </div>
                    <div class="alert alert-warning mb-3" role="alert"
                         invisible="pos_retail_reception_state != 'over'">
                        <strong>More than ordered.</strong>
                        Check the delivery note before confirming; you may be charged for the extra.
                    </div>

                    <separator string="What arrived"/>
                    <field name="move_ids" nolabel="1"
                           readonly="state in ('done', 'cancel')">
                        <list editable="bottom" create="false">
                            <field name="product_id" readonly="1"/>
                            <field name="product_uom_qty" string="Ordered" readonly="1"/>
                            <field name="quantity" string="Actually Arrived"/>
                            <field name="product_uom" string="Unit" readonly="1"
                                   groups="uom.group_uom" optional="hide"/>
                            <field name="picked" column_invisible="1"/>
                            <field name="state" column_invisible="1"/>
                        </list>
                    </field>
                    <!-- Warehouse plumbing: correct by default for a single
                         shop, and not a question to put to whoever is
                         unpacking the boxes. Still editable in the native
                         Inventory view for anyone who needs it. -->
                    <group invisible="1">
                        <field name="picking_type_id"/>
                        <field name="location_id"/>
                        <field name="location_dest_id"/>
                        <field name="company_id"/>
                        <field name="picking_type_code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_picking_list_pos_retail_reception" model="ir.ui.view">
        <field name="name">stock.picking.list.pos.retail.reception</field>
        <field name="model">stock.picking</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list string="Order Reception" create="false"
                  default_order="scheduled_date, id"
                  decoration-muted="state == 'cancel'"
                  decoration-success="state == 'done'">
                <field name="name" string="Reference"/>
                <field name="partner_id" string="Vendor"/>
                <field name="origin" string="Purchase Order" optional="show"/>
                <field name="scheduled_date" string="Expected On"/>
                <field name="date_done" string="Received On" optional="hide"/>
                <field name="pos_retail_expected_qty" string="Ordered" optional="hide"/>
                <field name="pos_retail_received_qty" string="Arrived" optional="hide"/>
                <field name="user_id" string="Received By" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('assigned', 'confirmed')"/>
            </list>
        </field>
    </record>

    <record id="view_picking_search_pos_retail_reception" model="ir.ui.view">
        <field name="name">stock.picking.search.pos.retail.reception</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Order Reception">
                <field name="name" string="Reference"/>
                <field name="partner_id" string="Vendor"/>
                <field name="origin" string="Purchase Order"/>
                <filter name="to_receive" string="Still to Receive"
                        domain="[('state', 'not in', ('done', 'cancel'))]"/>
                <filter name="received" string="Received"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="late" string="Overdue"
                        domain="[('scheduled_date', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('state', 'not in', ('done', 'cancel'))]"/>
                <separator/>
                <filter name="filter_scheduled" date="scheduled_date" string="Expected Date"/>
                <group>
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_retail_reception" model="ir.actions.act_window">
        <field name="name">Order Reception</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_picking_list_pos_retail_reception"/>
        <field name="search_view_id" ref="view_picking_search_pos_retail_reception"/>
        <field name="domain">[('picking_type_code', '=', 'incoming')]</field>
        <field name="context">{'search_default_to_receive': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing on its way in</p>
            <p>Deliveries appear here once you confirm a purchase order with a vendor.
               Open one as the boxes arrive, enter what actually turned up, and confirm it
               to add the goods to your stock.</p>
        </field>
    </record>

</odoo>
