<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_brand" model="ir.ui.view">
        <field name="name">product.template.form.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="brand_id"/>
            </field>
        </field>
    </record>

    <record id="product_template_form_view_pricing" model="ir.ui.view">
        <field name="name">product.template.form.pos.retail.pricing</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="group_standard_price" position="after">
                <group name="pos_retail_pricing" string="Selling Price Range">
                    <div class="text-muted small mb-2" colspan="2">
                        Cashiers may sell anywhere between the Minimum Selling Price and the MRP
                        without approval. Outside that range a manager PIN is required.
                        Leave a bound at 0 to leave that side unrestricted.
                    </div>
                    <field name="minimum_selling_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="mrp" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="wholesale_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                </group>
            </group>
        </field>
    </record>

    <record id="product_template_form_view_preferred_vendor" model="ir.ui.view">
        <field name="name">product.template.form.pos.retail.preferred.vendor</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="standard_price_uom" position="after">
                <field name="vendor_count" invisible="1"/>
                <field name="linked_vendor_ids" invisible="1"/>
                <field name="preferred_vendor_id"
                       options="{'no_create': True}"
                       domain="[('id', 'in', linked_vendor_ids)]"
                       invisible="type == 'combo' or (not is_product_variant and (product_variant_count &gt; 1 or (product_variant_count == 0 and is_dynamically_created)))"/>
                <span class="text-muted fst-italic" invisible="vendor_count != 0 or type == 'combo'">
                    No vendors linked yet — add one in the Vendors tab below.
                </span>
            </div>
        </field>
    </record>

    <record id="product_template_form_view_profit_discount" model="ir.ui.view">
        <field name="name">product.template.form.pos.retail.profit.discount</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="internal_notes" position="before">
                <field name="has_selling_below_cost" invisible="1"/>
                <field name="has_low_margin" invisible="1"/>
                <field name="has_min_selling_price_warning" invisible="1"/>

                <div class="alert alert-danger mb-2" role="alert" invisible="not has_selling_below_cost">
                    <strong>Selling at a loss:</strong> the Selling Price is below the Cost Price.
                </div>
                <div class="alert alert-warning mb-2" role="alert" invisible="not has_min_selling_price_warning">
                    <strong>Check pricing:</strong> the Minimum Selling Price is higher than the current Selling Price.
                </div>

                <group string="Profit Analysis" name="pos_retail_profit_analysis"
                       invisible="type == 'combo' or (not is_product_variant and (product_variant_count &gt; 1 or (product_variant_count == 0 and is_dynamically_created)))">
                    <field name="profit_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <label for="profit_margin_percent" string="Profit Margin"/>
                    <div>
                        <span invisible="not has_selling_below_cost" class="text-danger fw-bold">
                            <field name="profit_margin_percent" nolabel="1" class="oe_inline" digits="[16,1]"/>%
                        </span>
                        <span invisible="has_selling_below_cost or not has_low_margin" class="text-warning fw-bold">
                            <field name="profit_margin_percent" nolabel="1" class="oe_inline" digits="[16,1]"/>%
                        </span>
                        <span invisible="has_selling_below_cost or has_low_margin" class="text-success fw-bold">
                            <field name="profit_margin_percent" nolabel="1" class="oe_inline" digits="[16,1]"/>%
                        </span>
                    </div>
                </group>

                <group string="Discount" name="pos_retail_discount">
                    <field name="discount_type"/>
                    <field name="discount_value"/>
                    <field name="final_selling_price" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                </group>
            </group>
        </field>
    </record>

    <record id="product_template_search_view_brand" model="ir.ui.view">
        <field name="name">product.template.search.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="brand_id"/>
            </field>
            <filter name="group_by_categ_id" position="after">
                <filter string="Brand" name="group_by_brand_id"
                        context="{'group_by': 'brand_id'}"/>
            </filter>
        </field>
    </record>

    <!-- Report 7: Products with No Assigned Vendor -->
    <record id="action_products_no_vendor" model="ir.actions.act_window">
        <field name="name">Products with No Assigned Vendor</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('vendor_count', '=', 0)]</field>
    </record>

    <record id="product_template_search_view_vendor_filters" model="ir.ui.view">
        <field name="name">product.template.search.pos.retail.vendor</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="filter_to_purchase" position="after">
                <separator/>
                <filter string="Without Vendor" name="pos_retail_without_vendor" domain="[('vendor_count', '=', 0)]"/>
                <filter string="Multiple Vendors" name="pos_retail_multiple_vendors" domain="[('vendor_count', '&gt;', 1)]"/>
                <filter string="Preferred Vendor Products" name="pos_retail_preferred_vendor_products"
                        domain="[('seller_ids.is_preferred', '=', True)]"/>
            </filter>
        </field>
    </record>

</odoo>
