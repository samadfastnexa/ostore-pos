<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_brand" model="ir.ui.view">
        <field name="name">product.template.form.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="brand_id"/>
            </field>
        </field>
    </record>

    <record id="product_template_form_view_pricing" model="ir.ui.view">
        <field name="name">product.template.form.pos.retail.pricing</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Anchored on the two-column wrapper that holds Sales Price / Cost, not on
                 group_standard_price itself: dropping it inside that wrapper made it a third
                 child of a col=2 grid, so it rendered half-width on a second row under the
                 fold and read as "missing" to anyone who had switched tabs. As a sibling of
                 the wrapper it is a full-width section directly below the prices it bounds. -->
            <xpath expr="//page[@name='general_information']/group[group[@name='group_standard_price']]"
                   position="after">
                <group name="pos_retail_pricing" string="Selling Price Range" col="4">
                    <div class="text-muted small mb-2" colspan="4">
                        Cashiers may sell anywhere between the Minimum Selling Price (the lowest
                        allowed) and the Maximum Retail Price (the highest allowed, usually the
                        price printed on the pack) without approval. Outside that range a manager
                        PIN is required. Leave a price at 0 to leave that side unrestricted.
                    </div>
                    <field name="minimum_selling_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="mrp" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="wholesale_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                </group>
                <group name="pos_retail_branches" string="Branch Availability" col="4"
                       groups="base.group_multi_company">
                    <div class="text-muted small mb-2" colspan="4">
                        Leave this empty to sell the item at every branch, which is right for
                        almost all stock. Name one or more branches to offer it only there:
                        the registers of every other branch will not show it, and will not
                        find it by search or barcode either. Stock is unaffected - each
                        branch still counts its own quantity, and the product stays visible
                        in the back office so you can still move or reorder it.
                    </div>
                    <field name="pos_retail_branch_ids" widget="many2many_tags"
                           options="{'no_create': True}"
                           placeholder="All branches" colspan="4"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Unit & Measurement. Sits directly under Selling Price Range because the
         two answer the same question from opposite ends: what unit am I selling
         in, and what may I charge for it. The base unit itself stays where Odoo
         put it (next to Sales Price) rather than being duplicated here. -->
    <record id="product_template_form_view_measurement" model="ir.ui.view">
        <field name="name">product.template.form.pos.retail.measurement</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="pos_retail_pricing" position="after">
                <group name="pos_retail_measurement" string="Unit &amp; Measurement" col="4"
                       invisible="type == 'combo'">
                    <div class="text-muted small mb-2" colspan="4">
                        Stock is always counted in the <b>Unit</b> set above, whatever unit you
                        sell in. These settings only change how the till asks the cashier for a
                        quantity.
                    </div>
                    <field name="pos_retail_measurement_type"/>
                    <field name="pos_retail_allow_decimal"/>
                    <field name="pos_retail_quick_qty"
                           placeholder="e.g. 0.5, 1, 2, 5, 10"/>
                    <label for="uom_ids" string="Also Sold In"/>
                    <div>
                        <field name="uom_ids" widget="many2many_tags" nolabel="1"
                               options="{'no_quick_create': True}"
                               placeholder="e.g. Roll of 100 m, Box of 10"/>
                        <div class="text-muted small">
                            Extra units this item may be sold in. They must measure the same
                            thing as the base Unit, and Odoo converts back to it automatically.
                            For a pack with its own barcode and price, use the
                            <b>Packages</b> tab instead.
                        </div>
                    </div>
                </group>
            </group>
        </field>
    </record>

    <record id="product_template_form_view_preferred_vendor" model="ir.ui.view">
        <field name="name">product.template.form.pos.retail.preferred.vendor</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="standard_price_uom" position="after">
                <field name="vendor_count" invisible="1"/>
                <field name="linked_vendor_ids" invisible="1"/>
                <field name="preferred_vendor_id"
                       options="{'no_create': True}"
                       domain="[('id', 'in', linked_vendor_ids)]"
                       invisible="type == 'combo' or (not is_product_variant and (product_variant_count &gt; 1 or (product_variant_count == 0 and is_dynamically_created)))"/>
                <span class="text-muted fst-italic" invisible="vendor_count != 0 or type == 'combo'">
                    No vendors linked yet — add one in the Vendors tab below.
                </span>
            </div>
        </field>
    </record>

    <record id="product_template_form_view_profit_discount" model="ir.ui.view">
        <field name="name">product.template.form.pos.retail.profit.discount</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="internal_notes" position="before">
                <field name="has_selling_below_cost" invisible="1"/>
                <field name="has_low_margin" invisible="1"/>
                <field name="has_min_selling_price_warning" invisible="1"/>

                <div class="alert alert-danger mb-2" role="alert" invisible="not has_selling_below_cost">
                    <strong>Selling at a loss:</strong> the Selling Price is below the Cost Price.
                </div>
                <div class="alert alert-warning mb-2" role="alert" invisible="not has_min_selling_price_warning">
                    <strong>Check pricing:</strong> the Minimum Selling Price is higher than the current Selling Price.
                </div>

                <group string="Profit Analysis" name="pos_retail_profit_analysis"
                       invisible="type == 'combo' or (not is_product_variant and (product_variant_count &gt; 1 or (product_variant_count == 0 and is_dynamically_created)))">
                    <field name="profit_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <label for="profit_margin_percent" string="Profit Margin"/>
                    <div>
                        <span invisible="not has_selling_below_cost" class="text-danger fw-bold">
                            <field name="profit_margin_percent" nolabel="1" class="oe_inline" digits="[16,1]"/>%
                        </span>
                        <span invisible="has_selling_below_cost or not has_low_margin" class="text-warning fw-bold">
                            <field name="profit_margin_percent" nolabel="1" class="oe_inline" digits="[16,1]"/>%
                        </span>
                        <span invisible="has_selling_below_cost or has_low_margin" class="text-success fw-bold">
                            <field name="profit_margin_percent" nolabel="1" class="oe_inline" digits="[16,1]"/>%
                        </span>
                    </div>
                </group>

                <group string="Discount" name="pos_retail_discount">
                    <field name="discount_type"/>
                    <field name="discount_value"/>
                    <field name="final_selling_price" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                </group>
            </group>
        </field>
    </record>

    <!-- Roles & Permissions: grey out Sales Price / Cost for a user whose
         assigned role doesn't grant editing them on an already-saved product.
         View-level only; the real enforcement is the write() guard in
         models/product_template.py / product_product.py, this just avoids
         letting the user find out about the block only after clicking Save. -->
    <record id="product_template_form_view_price_lock" model="ir.ui.view">
        <field name="name">product.template.form.pos.retail.price.lock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="before">
                <field name="pos_retail_price_locked" invisible="1"/>
                <field name="pos_retail_cost_locked" invisible="1"/>
            </field>
            <field name="list_price" position="attributes">
                <attribute name="readonly">pos_retail_price_locked</attribute>
            </field>
            <field name="standard_price" position="attributes">
                <attribute name="readonly">pos_retail_cost_locked</attribute>
            </field>
        </field>
    </record>

    <!-- Same hint on the two VARIANT forms. The normal variant form inherits
         the template form (so the patch above reaches its standard_price),
         but core hides list_price there and shows an unpatched lst_price
         instead; the easy-edit form is a standalone primary view the template
         patch never reaches at all. Both delegated lock fields are available
         on product.product through _inherits. -->
    <record id="product_normal_form_view_price_lock" model="ir.ui.view">
        <field name="name">product.product.form.pos.retail.price.lock</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="lst_price" position="attributes">
                <attribute name="readonly">product_variant_count &gt; 1 or pos_retail_price_locked</attribute>
            </field>
        </field>
    </record>

    <record id="product_variant_easy_edit_view_price_lock" model="ir.ui.view">
        <field name="name">product.product.easy.edit.pos.retail.price.lock</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <field name="lst_price" position="before">
                <field name="pos_retail_price_locked" invisible="1"/>
                <field name="pos_retail_cost_locked" invisible="1"/>
            </field>
            <field name="lst_price" position="attributes">
                <attribute name="readonly">product_variant_count &gt; 1 or pos_retail_price_locked</attribute>
            </field>
            <field name="standard_price" position="attributes">
                <attribute name="readonly">pos_retail_cost_locked</attribute>
            </field>
        </field>
    </record>

    <record id="product_template_search_view_brand" model="ir.ui.view">
        <field name="name">product.template.search.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="brand_id"/>
            </field>
            <filter name="group_by_categ_id" position="after">
                <filter string="Brand" name="group_by_brand_id"
                        context="{'group_by': 'brand_id'}"/>
            </filter>
        </field>
    </record>

    <!-- Report 7: Products with No Assigned Vendor -->
    <record id="action_products_no_vendor" model="ir.actions.act_window">
        <field name="name">Products with No Assigned Vendor</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('vendor_count', '=', 0)]</field>
    </record>

    <record id="product_template_search_view_vendor_filters" model="ir.ui.view">
        <field name="name">product.template.search.pos.retail.vendor</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <filter name="filter_to_purchase" position="after">
                <separator/>
                <filter string="Without Vendor" name="pos_retail_without_vendor" domain="[('vendor_count', '=', 0)]"/>
                <filter string="Multiple Vendors" name="pos_retail_multiple_vendors" domain="[('vendor_count', '&gt;', 1)]"/>
                <filter string="Preferred Vendor Products" name="pos_retail_preferred_vendor_products"
                        domain="[('seller_ids.is_preferred', '=', True)]"/>
            </filter>
        </field>
    </record>

    <!-- Written-out help on the product form's everyday fields.

         The module shows a "?" beside every field (backend/required_fields.js)
         and falls back to a type description when a field carries no help, so
         a shopkeeper hovering Barcode was told "Short text." Several of these
         fields genuinely ship without help (barcode and default_code on the
         template are computed mirrors with none at all) and the rest are
         written for accountants. These are written for the person stocking
         the shelf: what the field is for, an example value, and whether it
         can be left empty.

         Three records because position="attributes" can only reach fields the
         PARENT view itself contains: price/cost/category sit in the base
         form, reference/barcode arrive via product_template_only_form_view,
         and the two tax fields via the account module's inherit. Targeting
         them all from one inherit of the base was a ParseError. -->
    <record id="product_template_form_help_base" model="ir.ui.view">
        <field name="name">product.template.form.pos.retail.help.base</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="attributes">
                <attribute name="help">The price the customer pays, shown on the POS tile and the receipt. Example: 250.00. If the product sells by metre or kg, this is the price for one unit of that measure.</attribute>
            </field>
            <field name="standard_price" position="attributes">
                <attribute name="help">What the shop pays to buy one unit, e.g. 19.00. Never shown to customers. Used to work out profit on the dashboard and to warn when something is being sold below cost.</attribute>
            </field>
            <field name="categ_id" position="attributes">
                <attribute name="help">Internal grouping used for reports and accounting, e.g. Sanitory fitting. This is NOT the tile category the cashier sees on the till; that one is the Point of Sale category.</attribute>
            </field>
        </field>
    </record>

    <record id="product_template_form_help_codes" model="ir.ui.view">
        <field name="name">product.template.form.pos.retail.help.codes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="help">Your own short code for this product, printed on labels and receipts, e.g. HW-PIPE-01. Optional; useful when two products have similar names.</attribute>
            </field>
            <field name="barcode" position="attributes">
                <attribute name="help">The number a scanner reads. If the packet already has a barcode, scan or type it here, e.g. 8964000112345. LEAVE IT EMPTY and the shop generates one automatically when the product is saved (with Generate Barcodes for New Products switched on in POS settings), so a shelf label can be printed straight away.</attribute>
            </field>
        </field>
    </record>

    <record id="product_template_form_help_taxes" model="ir.ui.view">
        <field name="name">product.template.form.pos.retail.help.taxes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="taxes_id" position="attributes">
                <attribute name="help">Tax added when this product is sold, e.g. 15% Sales Tax. Leave empty only for genuinely untaxed goods. Set once here; the POS applies it automatically.</attribute>
            </field>
            <field name="supplier_taxes_id" position="attributes">
                <attribute name="help">Tax the vendor charges on their bill for this product. Usually the purchase side of the same 15%. Leave empty if the vendor does not charge tax.</attribute>
            </field>
        </field>
    </record>

</odoo>