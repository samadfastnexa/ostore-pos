<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Only the Super Admin (Administration/Settings access, base.group_system)
         may change any password, including their own from My Profile. Everyone
         else must ask the Super Admin — enforced server-side in
         models/res_users.py::_change_password; this just hides the button so
         non-admins don't hit that error in the first place. -->
    <record id="view_users_form_simple_modif_pos_retail" model="ir.ui.view">
        <field name="name">res.users.form.simple.modif.pos.retail</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <div name="auth" position="attributes">
                <attribute name="groups">base.group_system</attribute>
            </div>
        </field>
    </record>

    <!-- Say what the sign-in name really is.

         The field on both user forms is `login`, not `email`. It is required
         because nobody can sign in without one, but it is never checked for an
         @ sign: a cashier called "ali" logs in perfectly well. The New dialog
         dresses it as an email anyway, with an envelope icon and a placeholder
         computed from the company's mail domain, so it reads as though an
         email address is compulsory. Shop staff do not all have one, and
         inventing fake addresses to get past a form is how you end up unable
         to tell who is who.

         Nothing about what is stored or required changes. Only the icon,
         placeholder and tooltip, so whoever fills the form knows a plain name
         is allowed. An email can still be added, and is what lets that person
         reset their own password later. -->

    <!-- The New dialog (base.view_users_simple_form). -->
    <record id="view_users_simple_form_pos_retail_login" model="ir.ui.view">
        <field name="name">res.users.simple.form.pos.retail.login</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_simple_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='email_domain_placeholder']/preceding-sibling::i[1]"
                   position="attributes">
                <attribute name="class">fa fa-fw me-1 fa-user text-primary</attribute>
                <attribute name="title">Sign-in name</attribute>
            </xpath>

            <xpath expr="//field[@name='login']" position="attributes">
                <attribute name="options">{}</attribute>
                <attribute name="placeholder">e.g. ali (an email is not needed)</attribute>
                <attribute name="help">The name this person types to sign in. It does NOT have to be an email address: a plain name such as ali or cashier1 works, and is quicker to type at a busy counter. It only has to be different from every other user's. Adding an email as well is optional, and is what lets them reset their own password.</attribute>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="domain">[('child_ids', '=', False)]</attribute>
            </xpath>

            <xpath expr="//field[@name='phone']/.." position="after">
                <div class="d-flex align-items-baseline w-100" invisible="id == uid">
                    <i class="fa fa-fw me-1 fa-lock text-primary" title="Password"/>
                    <field name="new_password" password="True" class="w-100"
                           placeholder="Set a password"/>
                </div>
            </xpath>

        </field>
    </record>

    <!-- The full user form (base.view_users_form). Core already labels this one
         "Login" and swaps in a key icon when it is not an email, so only the
         placeholder and the tooltip need saying more plainly. -->
    <record id="view_users_form_pos_retail_login" model="ir.ui.view">
        <field name="name">res.users.form.pos.retail.login</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='login']" position="attributes">
                <attribute name="placeholder">e.g. ali (an email is not needed)</attribute>
                <attribute name="help">The name this person types to sign in. It does NOT have to be an email address: a plain name such as ali or cashier1 works, and is quicker to type at a busy counter. Leave it blank and it is made from the person's name. It only has to be different from every other user's. Adding an email as well is optional, and is what lets them reset their own password.</attribute>
            </xpath>

            <!-- Core shows an envelope whenever login equals email, and on a
                 blank new record both are empty, so a form that has never seen
                 an email address still announces itself with one. Selected by
                 position, two icons back from the login box, because Odoo does
                 not allow title or class as an inheritance selector. -->
            <xpath expr="//field[@name='login']/preceding-sibling::i[2]"
                   position="attributes">
                <attribute name="class">fa fa-fw fa-user me-1 text-primary</attribute>
                <attribute name="title">Sign-in name</attribute>
            </xpath>

            <!-- Companies: shops for everyone, plus the holding company for
                 administrators. Filtering the parent out for EVERY user would
                 be a one-way door: there is no other screen anywhere that can
                 grant a company back, and without it in Companies the legal
                 entity cannot be administered at all. See
                 _compute_pos_retail_assignable_company_ids.

                 Default Company is narrowed to the ones this person has
                 actually been given above, which is what the field means and
                 what Odoo's own constraint requires: your landing company has
                 to be one you are allowed into. That alone keeps the holding
                 company off the New User form, because a new user starts in a
                 shop. -->
            <!-- Set the password while creating the person, not afterwards.

                 Core's only password control lives on the Security page, which
                 carries invisible="not id", so it does not exist until the
                 record has been saved. So making a cashier was: fill the form,
                 save, hunt for Actions or the Security tab, open a dialog, type
                 the password, confirm. Five steps to hand someone a till.

                 `new_password` is core's own field for this, and its help says
                 so: "Specify a value only when creating a user or if you're
                 changing the user's password". It was simply never put on a
                 form. Blank is ignored silently, so it costs nothing when
                 editing someone for another reason.

                 Hidden on your own record, where core requires the wizard so
                 the running session keeps working. -->
            <xpath expr="//field[@name='phone']/.." position="after">
                <h5 name="pos_retail_h5_password" class="d-flex flex-wrap align-items-baseline mb-0"
                    invisible="id == uid">
                    <i class="fa fa-fw fa-lock me-1 text-primary" title="Password"/>
                    <field name="new_password" password="True" class="w-75"
                           placeholder="Set a password"/>
                </h5>
            </xpath>

            <xpath expr="//field[@name='company_ids']" position="before">
                <field name="pos_retail_assignable_company_ids" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='company_ids']" position="attributes">
                <attribute name="domain">[('id', 'in', pos_retail_assignable_company_ids)]</attribute>
            </xpath>

            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="domain">[('id', 'in', company_ids)]</attribute>
            </xpath>

        </field>
    </record>

</odoo>
