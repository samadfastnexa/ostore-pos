<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Price Analysis, built on pos.order.line.
         Deliberately NOT on pos.retail.inventory.movement: that model only logs
         storable products that generated a stock picking, so services and
         non-storable goods would be missing from every price figure. The line
         already carries price_unit, discount, margin and total_cost, and reaches
         cashier / customer / branch / date through order_id.
         One model + one search view + several saved actions, matching the
         Discount Reports layout. -->

    <record id="pos_retail_price_report_search" model="ir.ui.view">
        <field name="name">pos.retail.price.report.search</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <search string="Price Analysis">
                <field name="product_id"/>
                <field name="order_id"/>
                <field name="pos_retail_price_manager_id"/>
                <field name="pos_retail_price_reason_id"/>

                <filter name="filter_adjusted" string="Price Adjusted"
                        domain="[('pos_retail_price_state', '=', 'adjusted')]"/>
                <filter name="filter_overridden" string="Price Overridden"
                        domain="[('pos_retail_price_state', '=', 'overridden')]"/>
                <separator/>
                <filter name="filter_below_default" string="Sold Below Default"
                        domain="[('pos_retail_price_variance', '&lt;', 0)]"/>
                <filter name="filter_above_default" string="Sold Above Default"
                        domain="[('pos_retail_price_variance', '>', 0)]"/>
                <separator/>
                <filter name="filter_manager_approved" string="Manager Approved"
                        domain="[('pos_retail_price_manager_id', '!=', False)]"/>

                <group>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Price Status" name="group_state" context="{'group_by': 'pos_retail_price_state'}"/>
                    <filter string="Approving Manager" name="group_manager" context="{'group_by': 'pos_retail_price_manager_id'}"/>
                    <filter string="Price Reason" name="group_reason" context="{'group_by': 'pos_retail_price_reason_id'}"/>
                    <filter string="Order" name="group_order" context="{'group_by': 'order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pos_retail_price_report_list" model="ir.ui.view">
        <field name="name">pos.retail.price.report.list</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <list string="Price Analysis" create="false" edit="false"
                  decoration-warning="pos_retail_price_state == 'adjusted'"
                  decoration-danger="pos_retail_price_state == 'overridden'">
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="qty" sum="Quantity"/>
                <field name="pos_retail_default_price" optional="show"/>
                <field name="price_unit" string="Sold At"/>
                <field name="pos_retail_price_variance" sum="Variance"/>
                <field name="pos_retail_min_price" optional="hide"/>
                <field name="pos_retail_max_price" optional="hide"/>
                <field name="discount" optional="hide"/>
                <field name="price_subtotal" sum="Revenue"/>
                <field name="margin" sum="Margin" optional="show"/>
                <field name="pos_retail_price_state"/>
                <field name="pos_retail_price_manager_id" optional="show"/>
                <field name="pos_retail_price_reason_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="pos_retail_price_report_pivot" model="ir.ui.view">
        <field name="name">pos.retail.price.report.pivot</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Price Analysis" sample="1">
                <field name="product_id" type="row"/>
                <field name="price_unit" type="measure"/>
                <field name="qty" type="measure"/>
                <field name="margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="pos_retail_price_report_graph" model="ir.ui.view">
        <field name="name">pos.retail.price.report.graph</field>
        <field name="model">pos.order.line</field>
        <field name="arch" type="xml">
            <graph string="Price Analysis" type="bar" sample="1">
                <field name="product_id"/>
                <field name="price_unit" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- The saved views. Every one of the requested reports is this single
         model with a different domain / default grouping. -->
    <record id="action_pos_retail_price_analysis" model="ir.actions.act_window">
        <field name="name">Price Analysis</field>
        <field name="res_model">pos.order.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="pos_retail_price_report_search"/>
        <field name="context">{'search_default_group_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sales yet</p>
            <p>Average selling price, margin and every price adjustment, per product.</p>
        </field>
    </record>

    <record id="action_pos_retail_price_overrides" model="ir.actions.act_window">
        <field name="name">Price Overrides</field>
        <field name="res_model">pos.order.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="pos_retail_price_report_search"/>
        <field name="domain">[('pos_retail_price_state', '=', 'overridden')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No price overrides</p>
            <p>Sales made outside the product's allowed range, with the approving manager and reason.</p>
        </field>
    </record>

    <record id="action_pos_retail_price_below_default" model="ir.actions.act_window">
        <field name="name">Sold Below Default Price</field>
        <field name="res_model">pos.order.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="pos_retail_price_report_search"/>
        <field name="context">{'search_default_filter_below_default': 1, 'search_default_group_product': 1}</field>
    </record>

    <record id="action_pos_retail_price_above_default" model="ir.actions.act_window">
        <field name="name">Sold Above Default Price</field>
        <field name="res_model">pos.order.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="pos_retail_price_report_search"/>
        <field name="context">{'search_default_filter_above_default': 1, 'search_default_group_product': 1}</field>
    </record>

    <record id="action_pos_retail_price_by_manager" model="ir.actions.act_window">
        <field name="name">Manager Price Overrides</field>
        <field name="res_model">pos.order.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="pos_retail_price_report_search"/>
        <field name="domain">[('pos_retail_price_manager_id', '!=', False)]</field>
        <field name="context">{'search_default_group_manager': 1}</field>
    </record>

    <record id="action_pos_retail_price_by_reason" model="ir.actions.act_window">
        <field name="name">Price Adjustment Reasons</field>
        <field name="res_model">pos.order.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="pos_retail_price_report_search"/>
        <field name="domain">[('pos_retail_price_reason_id', '!=', False)]</field>
        <field name="context">{'search_default_group_reason': 1}</field>
    </record>

</odoo>
