<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Returns and Refunds history/report. Built on pos.order filtered to
         refund orders (is_refund), since the return_reason_id lives on pos.order
         (report.pos.order does not carry it). Refund orders are created natively
         by the TicketScreen refund flow; this just surfaces them with reason,
         cashier, customer, date and amount. CSV/Excel export is free on the list. -->
    <record id="pos_retail_return_report_search" model="ir.ui.view">
        <field name="name">pos.retail.return.report.search</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <search string="Returns">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="return_reason_id"/>
                <filter name="filter_date" date="date_order"/>
                <group>
                    <filter string="Return Reason" name="group_reason" context="{'group_by': 'return_reason_id'}"/>
                    <filter string="Cashier" name="group_cashier" context="{'group_by': 'employee_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date_order:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pos_retail_return_report_pivot" model="ir.ui.view">
        <field name="name">pos.retail.return.report.pivot</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <pivot string="Returns by Reason" sample="1">
                <field name="return_reason_id" type="row"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="pos_retail_return_report_graph" model="ir.ui.view">
        <field name="name">pos.retail.return.report.graph</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <graph string="Returns" type="bar" sample="1">
                <field name="return_reason_id"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="pos_retail_return_report_list" model="ir.ui.view">
        <field name="name">pos.retail.return.report.list</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <list string="Returns" create="false">
                <field name="date_order"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="employee_id" optional="show"/>
                <field name="return_reason_id"/>
                <field name="refunded_order_id" optional="hide"/>
                <field name="amount_total" sum="Total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_pos_retail_returns" model="ir.actions.act_window">
        <field name="name">Returns and Refunds</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="pos_retail_return_report_search"/>
        <field name="domain">[('is_refund', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No returns yet</p>
            <p>Every refund/return appears here with its reason, cashier, customer and amount.</p>
        </field>
    </record>

</odoo>
