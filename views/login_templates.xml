<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Brand the login page: our own footer credit instead of the Odoo promo
         link, plus a hook class so the styling in login.scss stays scoped to
         this page and never leaks into the portal or database manager. -->
    <template id="login_layout_branding" inherit_id="web.login_layout" name="OStore Login Branding">
        <xpath expr="//div[hasclass('container')]" position="attributes">
            <attribute name="class" add="zipnix-login" separator=" "/>
        </xpath>
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <span class="zipnix-login__credit">Powered by <span class="zipnix-login__brand">Zipnix Technology</span></span>
        </xpath>
    </template>

    <!-- Drop the "choose a user" switcher. A shared shop terminal should not
         advertise who signed in before, and staff log in with their own
         account. Core hides the form (d-none) whenever the switcher takes over,
         so the form class is reset here as well, otherwise removing the
         switcher would leave the login page with no visible form at all. -->
    <template id="login_no_user_switch" inherit_id="web.login" name="OStore Login without user switch">
        <xpath expr="//owl-component[@name='web.user_switch']" position="replace"/>
        <xpath expr="//form[@data-captcha='login']" position="attributes">
            <attribute name="t-attf-class">oe_login_form</attribute>
        </xpath>
    </template>

</odoo>
