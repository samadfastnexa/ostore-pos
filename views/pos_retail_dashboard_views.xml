<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_pos_retail_dashboard" model="ir.actions.client">
        <field name="name">POS Dashboard</field>
        <field name="tag">pos_retail_dashboard</field>
    </record>

    <menuitem id="menu_pos_retail_dashboard"
        name="Dashboard"
        parent="point_of_sale.menu_point_root"
        action="action_pos_retail_dashboard"
        sequence="1"
        groups="point_of_sale.group_pos_manager"/>

    <!--
        Hide the native "Dashboard" menu (the pos.config kanban used to open/
        resume register sessions) so only ONE Dashboard menu remains — ours.
        Session management stays reachable via the "Open Register" button in
        the dashboard header (it opens this same native kanban action).
        To bring the native menu back: set active to True (or delete this record).
    -->
    <record id="point_of_sale.menu_pos_dashboard" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <!--
        Land POS MANAGERS on the dashboard after login, instead of the default
        Discuss/Apps screen.

        Managers only, and that restriction is not cosmetic. This used to set
        the home action for every internal user via an ir.default plus a blanket
        write. Once get_dashboard_data started refusing non-managers, which it
        must, being an AbstractModel with no access-rule layer of its own, that
        combination sent every cashier to a screen that greets them with
        "available to Point of Sale managers only" and nothing else, on every
        single login. The guard was right; forcing everyone at it was not.

        The ir.default is gone with it: it applied to users created LATER, so
        each new cashier inherited the same broken landing. res_users.py now
        sets the home action at create time, for managers only.

        To revert for one person: Settings > Users > (user) > Preferences >
        Home Action.
    -->
    <function model="res.users" name="_pos_retail_sync_dashboard_home"/>

</odoo>
