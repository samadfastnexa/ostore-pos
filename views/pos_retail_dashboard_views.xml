<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_pos_retail_dashboard" model="ir.actions.client">
        <field name="name">POS Dashboard</field>
        <field name="tag">pos_retail_dashboard</field>
    </record>

    <menuitem id="menu_pos_retail_dashboard"
        name="Dashboard"
        parent="point_of_sale.menu_point_root"
        action="action_pos_retail_dashboard"
        sequence="1"
        groups="point_of_sale.group_pos_manager"/>

    <!--
        Land every user on the POS Dashboard right after login, instead of the
        default Discuss/Apps screen.
        Two parts are needed: `ir.default` only supplies the value for users
        created AFTER this point (via default_get); it does not retroactively
        change already-stored `action_id` on existing users, since the web
        client reads that stored field directly at login (session_info).
        So we also write it onto every current internal user.
        To revert: Settings > Users > (user) > Preferences > Home Action.
    -->
    <function model="ir.default" name="set"
        eval="('res.users', 'action_id', ref('action_pos_retail_dashboard'), False)"/>
    <function model="res.users" name="write"
        eval="(obj().env['res.users'].search([('share', '=', False)]).ids,
               {'action_id': ref('action_pos_retail_dashboard')})"/>

</odoo>
