<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_retail_access_role_view_list" model="ir.ui.view">
        <field name="name">pos.retail.access.role.list</field>
        <field name="model">pos.retail.access.role</field>
        <field name="arch" type="xml">
            <list string="Roles &amp; Permissions">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="permission_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="pos_retail_access_role_view_form" model="ir.ui.view">
        <field name="name">pos.retail.access.role.form</field>
        <field name="model">pos.retail.access.role</field>
        <field name="arch" type="xml">
            <form string="Role">
                <header>
                    <!-- Whole-role shortcuts. The per-section links cover the
                         usual case; these are for building an owner's own
                         Admin role, or rebuilding one from nothing. Granting
                         everything carries every Delete and both price
                         permissions, so it asks first. -->
                    <button name="action_pos_retail_grant_all_permissions" type="object"
                            string="Select All Permissions" class="btn-secondary"
                            confirm="This gives the role every permission in the catalogue, including every Delete permission and the right to change prices and costs. Everyone assigned to this role receives all of it immediately. Continue?"/>
                    <button name="action_pos_retail_clear_all_permissions" type="object"
                            string="Clear All Permissions" class="btn-secondary"
                            confirm="This removes every permission from the role. The people assigned to it stay assigned but will hold nothing from this role until permissions are ticked again. Continue?"/>
                    <button name="action_archive" type="object" string="Archive"
                            invisible="not active"
                            confirm="Archiving this role immediately removes it from every assigned user. Continue?"/>
                    <button name="action_unarchive" type="object" string="Restore"
                            invisible="active"/>
                </header>
                <sheet>
                    <div class="alert alert-info d-flex align-items-start gap-2 mb-3" role="alert">
                        <i class="fa fa-info-circle mt-1" role="img" aria-label="Info" title="Info"/>
                        <div>
                            <strong>Purpose:</strong> a named set of permissions the Super Admin hands to a
                            user — e.g. "can add products, cannot delete them, cannot change prices on ones
                            that already exist."<br/>
                            <strong>How it works:</strong> tick permissions from the catalog below. This is
                            real Odoo security (the same engine behind Settings ▸ Groups); granting and
                            revoking take effect immediately. A role only ever <em>adds</em> access on top of
                            whatever else a user already has — it can never take access away.<br/>
                            <strong>Sales Price / Cost</strong> are the one exception: the two price
                            permissions are enforced directly by this app, so as soon as a user is in ANY
                            role, existing products' prices are locked unless a role grants them.
                        </div>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Product Adder"/></h1>
                    </div>
                    <group>
                        <field name="user_ids" widget="many2many_tags" string="Assigned Users"/>
                    </group>
                    <notebook>
                        <page string="Permissions" name="permissions">
                            <group>
                                <group string="Products">
                                    <field name="permission_ids" nolabel="1" colspan="2"
                                           widget="pos_retail_checkboxes_select_all"
                                           domain="[('category', '=', 'products')]"/>
                                </group>
                                <group string="Customers &amp; Vendors">
                                    <field name="permission_ids" nolabel="1" colspan="2"
                                           widget="pos_retail_checkboxes_select_all"
                                           domain="[('category', '=', 'partners')]"/>
                                </group>
                                <group string="Point of Sale">
                                    <field name="permission_ids" nolabel="1" colspan="2"
                                           widget="pos_retail_checkboxes_select_all"
                                           domain="[('category', '=', 'pos')]"/>
                                </group>
                                <group string="Sales">
                                    <field name="permission_ids" nolabel="1" colspan="2"
                                           widget="pos_retail_checkboxes_select_all"
                                           domain="[('category', '=', 'sales')]"/>
                                </group>
                                <group string="Purchases">
                                    <field name="permission_ids" nolabel="1" colspan="2"
                                           widget="pos_retail_checkboxes_select_all"
                                           domain="[('category', '=', 'purchases')]"/>
                                </group>
                                <group string="Inventory">
                                    <field name="permission_ids" nolabel="1" colspan="2"
                                           widget="pos_retail_checkboxes_select_all"
                                           domain="[('category', '=', 'inventory')]"/>
                                </group>
                                <group string="Invoicing">
                                    <field name="permission_ids" nolabel="1" colspan="2"
                                           widget="pos_retail_checkboxes_select_all"
                                           domain="[('category', '=', 'accounting')]"/>
                                </group>
                                <group string="Store Expenses">
                                    <field name="permission_ids" nolabel="1" colspan="2"
                                           widget="pos_retail_checkboxes_select_all"
                                           domain="[('category', '=', 'expenses')]"/>
                                </group>
                                <group string="Reporting">
                                    <field name="permission_ids" nolabel="1" colspan="2"
                                           widget="pos_retail_checkboxes_select_all"
                                           domain="[('category', '=', 'reporting')]"/>
                                </group>
                                <group string="Configuration">
                                    <field name="permission_ids" nolabel="1" colspan="2"
                                           widget="pos_retail_checkboxes_select_all"
                                           domain="[('category', '=', 'configuration')]"/>
                                </group>
                            </group>
                        </page>
                        <page string="Advanced (technical)" name="access" groups="base.group_no_one">
                            <p class="text-muted">
                                The raw access rules this role's group carries (including rules created before
                                the permission catalog existed). Read-only; compose roles with the Permissions
                                tab instead.
                            </p>
                            <field name="model_access" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="model_id" string="Model"/>
                                    <field name="perm_read" string="Read"/>
                                    <field name="perm_create" string="Create"/>
                                    <field name="perm_write" string="Edit"/>
                                    <field name="perm_unlink" string="Delete"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_retail_access_role_view_search" model="ir.ui.view">
        <field name="name">pos.retail.access.role.search</field>
        <field name="model">pos.retail.access.role</field>
        <field name="arch" type="xml">
            <search string="Roles &amp; Permissions">
                <field name="name"/>
                <field name="user_ids"/>
                <field name="permission_ids"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="pos_retail_access_role_action" model="ir.actions.act_window">
        <field name="name">Roles &amp; Permissions</field>
        <field name="res_model">pos.retail.access.role</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first role</p>
            <p>Give a user exactly the permissions they need — e.g. can add products,
               cannot delete them, cannot change prices on ones that already exist.</p>
        </field>
    </record>

</odoo>
